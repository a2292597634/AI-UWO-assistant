{
  "name": "世界地圖縮放與點位資料",
  "entry": "/subpkg-world-map/pages/index/index",
  "watchPaths": [
    "miniprogram/subpkg-world-map/",
    "miniprogram/app.json",
    "data/master/world-map.json",
    "data/master/world-map-calibration.json"
  ],
  "state": "normal",
  "devices": ["iphone-small", "iphone-standard", "android-large"],
  "steps": [
    { "action": "waitFor", "selector": "#map-reset" },
    { "action": "screenshot", "name": "world-overview" },
    { "action": "tap", "selector": "#map-zoom-in" },
    {
      "action": "waitUntil",
      "condition": { "kind": "text", "selector": ".map__zoom", "equals": "2×" }
    },
    { "action": "tap", "selector": "#map-zoom-out" },
    {
      "action": "waitUntil",
      "condition": { "kind": "text", "selector": ".map__zoom", "equals": "1×" }
    },
    { "action": "input", "selector": ".map-search__input", "value": "威尼斯" },
    {
      "action": "waitUntil",
      "condition": { "kind": "text", "selector": ".map-results__row", "contains": "威尼斯" }
    },
    { "action": "tap", "selector": ".map-results__row" },
    {
      "action": "waitUntil",
      "condition": { "kind": "text", "selector": ".map-sheet__title", "equals": "威尼斯" }
    },
    { "action": "assertText", "selector": ".map-sheet__row", "contains": "北緯" },
    { "action": "assertText", "selector": ".map-sheet__source", "contains": "地理對照位置" },
    { "action": "assertText", "selector": ".map-trade--port", "contains": "雞肉" },
    { "action": "assertVisible", "selector": ".map-trade--port .map-trade__sprite" },
    { "action": "screenshot", "name": "port-details" },
    { "action": "tap", "selector": ".map-trade--port" },
    {
      "action": "waitUntil",
      "condition": { "kind": "page", "path": "/subpkg-trade/pages/detail/index" }
    },
    {
      "action": "waitUntil",
      "condition": { "kind": "text", "selector": ".trade-detail__title", "equals": "雞肉" }
    },
    { "action": "screenshot", "name": "port-trade-details" }
  ]
}
