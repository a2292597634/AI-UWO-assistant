{
  "name": "大流行時刻表矩陣",
  "entry": "/subpkg-trade/pages/popularity/index",
  "watchPaths": [
    "miniprogram/subpkg-trade/pages/popularity/",
    "miniprogram/subpkg-trade/assets/major-events/",
    "miniprogram/subpkg-trade/assets/category-icons/"
  ],
  "state": "normal",
  "devices": ["iphone-small", "iphone-standard", "android-large"],
  "steps": [
    { "action": "waitFor", "selector": ".major-events-page" },
    {
      "action": "assertText",
      "selector": ".major-events-header__title",
      "contains": "大流行時刻表"
    },
    {
      "action": "assertExists",
      "selector": ".major-events-dates",
      "exists": false
    },
    {
      "action": "assertExists",
      "selector": ".major-events-filters",
      "exists": false
    },
    {
      "action": "assertExists",
      "selector": ".major-events-next-button",
      "exists": false
    },
    {
      "action": "assertText",
      "selector": ".major-events-summary__timezone",
      "contains": "東八區時間"
    },
    { "action": "waitFor", "selector": ".matrix__slot-head" },
    {
      "action": "assertExists",
      "selector": ".matrix__slot-head--current",
      "exists": true
    },
    {
      "action": "assertExists",
      "selector": ".matrix__slot--current",
      "exists": true
    },
    {
      "action": "assertText",
      "selector": ".matrix-section__note",
      "contains": "遊戲週期"
    },
    { "action": "screenshot", "name": "major-event-matrix" },
    { "action": "tap", "selector": ".matrix-segment-control__arrow--next" },
    { "action": "tap", "selector": ".matrix-segment-control__arrow--next" },
    { "action": "tap", "selector": ".matrix-segment-control__arrow--next" },
    { "action": "tap", "selector": ".matrix-segment-control__arrow--next" },
    { "action": "waitFor", "selector": ".matrix__event-tag", "timeoutMs": 5000 },
    { "action": "screenshot", "name": "major-event-matrix-events" },
    { "action": "tap", "selector": ".matrix__event-target" },
    { "action": "waitFor", "selector": ".major-event-detail", "timeoutMs": 5000 },
    { "action": "screenshot", "name": "major-event-matrix-detail" },
    { "action": "tap", "selector": ".major-event-detail__close" },
    { "action": "scrollPage", "distance": 600 },
    { "action": "screenshot", "name": "major-event-matrix-selected-row" },
    { "action": "tap", "selector": ".major-events-range__option--seven-day" },
    { "action": "tap", "selector": ".matrix-segment-control__arrow--next" },
    { "action": "tap", "selector": ".major-events-view-switch__option--journey" },
    { "action": "waitFor", "selector": ".journey__event", "timeoutMs": 5000 },
    { "action": "screenshot", "name": "major-event-journey" },
    { "action": "tap", "selector": ".journey__event" },
    { "action": "waitFor", "selector": ".major-event-detail", "timeoutMs": 5000 },
    { "action": "screenshot", "name": "major-event-detail" },
    { "action": "tap", "selector": ".major-event-detail__close" }
  ]
}
