{
  "name": "冒險配隊分享圖",
  "entry": "/pages/adventure-fleet/index",
  "watchPaths": [
    "miniprogram/pages/adventure-fleet/",
    "miniprogram/components/config-bar/",
    "miniprogram/components/fleet-share-preview/",
    "miniprogram/runtime/fleet-share-renderer.ts",
    "miniprogram/runtime/fleet-share-layout.ts",
    "miniprogram/assets/ui/fleet-share-map.jpg",
    "data/master/ui-assets/fleet-share-map-source.png",
    "miniprogram/assets/ui/fleet-share-nautical-motifs.png",
    "data/master/ui-assets/fleet-share-nautical-motifs-source.png",
    "miniprogram/assets/ui/config-paper-texture.png",
    "data/master/ui-assets/config-paper-texture-source.png",
    "miniprogram/assets/ui/share-action-icon.png",
    "data/master/ui-assets/share-action-icon-source.png",
    "tools/ui-assets/config.ts",
    "tools/ui-assets/build-ui-assets.ts"
  ],
  "state": "normal",
  "devices": ["iphone-small", "iphone-standard", "android-large"],
  "steps": [
    {
      "action": "waitFor",
      "selector": ".fleet-page",
      "timeoutMs": 15000
    },
    {
      "action": "assertExists",
      "selector": "xpath://view[contains(@class, \"config-bar\")]"
    },
    {
      "action": "assertExists",
      "selector": "xpath://view[contains(@class, \"fleet-context\")]"
    },
    {
      "action": "waitFor",
      "durationMs": 2000
    },
    {
      "action": "screenshot",
      "name": "adventure-top-before-share"
    },
    {
      "action": "tap",
      "selector": "xpath://button[contains(@class, \"config-bar__share--prominent\")]"
    },
    {
      "action": "waitFor",
      "selector": "xpath://image[contains(@class, \"fleet-share-preview__image\")]",
      "timeoutMs": 20000
    },
    {
      "action": "waitFor",
      "durationMs": 1000
    },
    {
      "action": "assertVisible",
      "selector": "xpath://image[contains(@class, \"fleet-share-preview__image\")]"
    },
    {
      "action": "assertText",
      "selector": "xpath://text[contains(@class, \"fleet-share-preview__title\")]",
      "equals": "分享圖預覽"
    },
    {
      "action": "screenshot",
      "name": "adventure-share-top"
    }
  ]
}
