{
  "name": "留言板舊路徑可開啟並返回首頁遷移彈窗",
  "entry": "/subpkg-message-board/pages/board/index",
  "watchPaths": ["miniprogram/pages/home/", "miniprogram/subpkg-message-board/pages/board/"],
  "state": "normal",
  "devices": ["iphone-small", "iphone-standard", "android-large"],
  "steps": [
    {
      "action": "assertText",
      "selector": ".board-page__title",
      "contains": "留言板"
    },
    {
      "action": "screenshot",
      "name": "message-board-entry-page"
    },
    {
      "action": "tap",
      "selector": ".message-board-page__home"
    },
    {
      "action": "waitUntil",
      "condition": {
        "path": "/pages/home/index",
        "kind": "page"
      }
    },
    {
      "action": "assertText",
      "selector": ".migration-gate__title",
      "contains": "起源航海小助手"
    },
    {
      "action": "screenshot",
      "name": "home-migration-gate-after-board"
    }
  ]
}
