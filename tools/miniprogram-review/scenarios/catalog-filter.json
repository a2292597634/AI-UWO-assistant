{
  "name": "名冊篩選固定操作區",
  "entry": "/pages/catalog/index",
  "watchPaths": [
    "miniprogram/pages/catalog/",
    "miniprogram/components/skill-sheet/",
    "miniprogram/presenters/skill-sheet.ts",
    "miniprogram/presenters/catalog-page-state.ts",
    "miniprogram/presenters/catalog-presenter.ts",
    "miniprogram/domain/catalog-query.ts"
  ],
  "state": "normal",
  "devices": ["iphone-small", "iphone-standard", "android-large"],
  "steps": [
    {
      "action": "waitFor",
      "selector": ".catalog-page__filter-trigger"
    },
    {
      "action": "screenshot",
      "name": "catalog-top"
    },
    {
      "action": "tap",
      "selector": ".catalog-page__filter-trigger"
    },
    {
      "action": "waitFor",
      "selector": ".catalog-page__filter-body"
    },
    {
      "action": "assertVisible",
      "selector": ".catalog-page__filter-action--apply"
    },
    {
      "action": "screenshot",
      "name": "filter-top"
    },
    {
      "action": "scrollElement",
      "selector": ".catalog-page__filter-body",
      "distance": 1000
    },
    {
      "action": "screenshot",
      "name": "filter-bottom"
    },
    {
      "action": "tap",
      "selector": ".catalog-page__filter-action--apply"
    },
    {
      "action": "waitFor",
      "durationMs": 1000
    },
    {
      "action": "assertExists",
      "selector": ".catalog-page__filter-sheet",
      "exists": false
    }
  ]
}
