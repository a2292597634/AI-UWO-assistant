{
  "name": "首頁六個主要入口",
  "entry": "/pages/home/index",
  "watchPaths": [
    "miniprogram/pages/home/",
    "miniprogram/assets/ui/home-harbor.jpg",
    "miniprogram/assets/ui/feature-officer-catalog.png",
    "miniprogram/assets/ui/feature-battle-fleet.png",
    "miniprogram/assets/ui/feature-adventure-fleet.png",
    "miniprogram/assets/ui/feature-trade-goods.png",
    "miniprogram/assets/ui/feature-major-events.png",
    "miniprogram/assets/ui/feature-coupon.png",
    "miniprogram/assets/ui/feature-data-maintenance.png"
  ],
  "state": "normal",
  "devices": ["iphone-small", "iphone-standard", "android-large"],
  "steps": [
    {
      "action": "waitFor",
      "selector": ".module-grid__item"
    },
    {
      "action": "assertText",
      "selector": ".module-grid",
      "contains": "大流行時刻表"
    },
    {
      "action": "tap",
      "selector": ".module-grid__item"
    },
    {
      "action": "waitUntil",
      "condition": {
        "kind": "page",
        "path": "/pages/home/index"
      }
    },
    {
      "action": "assertText",
      "selector": ".migration-gate__title",
      "contains": "起源航海小助手"
    },
    {
      "action": "assertText",
      "selector": ".migration-gate__button",
      "contains": "前往新版"
    },
    {
      "action": "screenshot",
      "name": "home-migration-gate"
    }
  ]
}
