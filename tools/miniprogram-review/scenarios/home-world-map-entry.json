{
  "name": "首頁世界地圖入口",
  "entry": "/pages/home/index",
  "watchPaths": ["miniprogram/pages/home/", "miniprogram/app.json"],
  "state": "normal",
  "devices": ["iphone-small", "iphone-standard", "android-large"],
  "steps": [
    { "action": "assertText", "selector": "#home-world-map", "contains": "世界地圖" },
    { "action": "screenshot", "name": "home-world-map-entry" },
    { "action": "tap", "selector": "#home-world-map" },
    {
      "action": "waitUntil",
      "condition": { "kind": "page", "path": "/subpkg-world-map/pages/index/index" }
    },
    { "action": "waitFor", "selector": "#map-reset", "timeoutMs": 10000 }
  ]
}
