{
  "name": "永久留言板列表入口與返回首頁",
  "entry": "/subpkg-message-board/pages/board/index",
  "watchPaths": [
    "miniprogram/subpkg-message-board/pages/board/",
    "miniprogram/contracts/message-board.ts",
    "miniprogram/controllers/message-board-list-controller.ts",
    "miniprogram/domain/message-board/",
    "miniprogram/presenters/message-board-presenter.ts",
    "miniprogram/runtime/message-board-service.ts",
    "miniprogram/runtime/cloudbase-config.ts",
    "miniprogram/subpkg-message-board/components/",
    "miniprogram/subpkg-message-board/styles/",
    "miniprogram/assets/ui/message-board-default-avatar.png"
  ],
  "state": "normal",
  "devices": ["iphone-small", "iphone-standard", "android-large"],
  "steps": [
    {
      "action": "waitUntil",
      "condition": {
        "selector": ".message-board-page",
        "kind": "exists",
        "exists": true
      }
    },
    {
      "action": "waitUntil",
      "condition": {
        "kind": "exists",
        "selector": ".board-page__loading",
        "exists": false
      },
      "timeoutMs": 20000
    },
    {
      "action": "waitUntil",
      "condition": {
        "kind": "exists",
        "selector": ".board-page__error",
        "exists": false
      }
    },
    {
      "action": "assertText",
      "selector": ".board-page__title",
      "contains": "留言板"
    },
    {
      "action": "assertText",
      "selector": ".message-board-page__rules",
      "contains": "審核後公開"
    },
    {
      "action": "screenshot",
      "name": "message-board-top"
    },
    {
      "action": "scrollPage",
      "distance": 320
    },
    {
      "action": "screenshot",
      "name": "message-board-actions"
    },
    {
      "action": "tap",
      "selector": ".message-board-page__home"
    },
    {
      "action": "waitUntil",
      "condition": {
        "path": "/pages/home/index",
        "kind": "page"
      }
    }
  ]
}
