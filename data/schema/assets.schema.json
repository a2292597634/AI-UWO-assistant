{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "ownerType", "ownerId", "source"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "ownerType": { "type": "string", "minLength": 1 },
    "ownerId": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "originalFilename", "mimeType", "byteSize", "sha256", "width", "height"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "originalFilename": { "type": "string", "minLength": 1 },
        "mimeType": { "type": "string", "minLength": 1 },
        "byteSize": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mimeType",
        "byteSize",
        "sha256",
        "width",
        "height",
        "processingRuleVersion",
        "shardId"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "mimeType": { "type": "string", "minLength": 1 },
        "byteSize": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "processingRuleVersion": { "type": "string", "minLength": 1 },
        "shardId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
