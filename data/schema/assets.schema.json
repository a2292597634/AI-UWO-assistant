{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "ownerType", "ownerId", "source"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["portrait", "icon", "ui-image"] },
    "ownerType": { "enum": ["officer", "skill", "ui"] },
    "ownerId": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "originalFilename", "mimeType", "byteSize", "sha256", "width", "height"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "originalFilename": { "type": "string", "minLength": 1 },
        "mimeType": { "type": "string", "minLength": 1 },
        "byteSize": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "downloadedAt": { "type": "string", "format": "date" },
        "transparentBounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "top", "width", "height"],
          "properties": {
            "left": { "type": "integer", "minimum": 0 },
            "top": { "type": "integer", "minimum": 0 },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mimeType",
        "byteSize",
        "sha256",
        "width",
        "height",
        "processingRuleVersion",
        "shardId"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "mimeType": { "type": "string", "minLength": 1 },
        "byteSize": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "processingRuleVersion": { "type": "string", "minLength": 1 },
        "shardId": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "ownerType": { "const": "ui" } },
        "required": ["ownerType"]
      },
      "then": {
        "properties": {
          "kind": { "const": "ui-image" },
          "source": {
            "type": "object",
            "properties": {
              "downloadedAt": { "type": "string", "format": "date" },
              "transparentBounds": { "type": "object" }
            },
            "required": ["downloadedAt", "transparentBounds"]
          }
        }
      }
    }
  ]
}
