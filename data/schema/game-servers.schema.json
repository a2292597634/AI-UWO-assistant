{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "servers"],
  "properties": {
    "version": { "type": "string", "pattern": "^[a-zA-Z0-9.-]{1,32}$" },
    "servers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9-]{1,40}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    }
  }
}
