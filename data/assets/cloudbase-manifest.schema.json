{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Published CloudBase asset manifest",
  "type": "object",
  "required": [
    "releaseId",
    "manifestDigest",
    "contentVersion",
    "cdnOrigin",
    "cloudPathPrefix",
    "cacheControl",
    "assets"
  ],
  "additionalProperties": false,
  "properties": {
    "releaseId": { "type": "string", "minLength": 1 },
    "manifestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contentVersion": { "type": "string", "minLength": 1 },
    "cdnOrigin": { "type": "string", "format": "uri", "pattern": "^https://[^/?#]+$" },
    "cloudPathPrefix": { "type": "string", "minLength": 1 },
    "cacheControl": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sourcePath",
          "filename",
          "cloudPath",
          "fileID",
          "publicUrl",
          "sha256",
          "bytes",
          "contentType",
          "releaseId"
        ],
        "additionalProperties": false,
        "properties": {
          "sourcePath": { "type": "string", "minLength": 1 },
          "filename": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\.png$" },
          "cloudPath": { "type": "string", "minLength": 1 },
          "fileID": { "type": "string", "pattern": "^cloud://[^?\\s]+$" },
          "publicUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "contentType": { "const": "image/png" },
          "releaseId": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
