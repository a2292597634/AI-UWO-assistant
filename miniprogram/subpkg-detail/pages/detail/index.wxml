<scroll-view class="detail-page" scroll-y wx:if="{{officer}}">
  <view class="hero">
    <image src="{{officer.portraitPath}}" mode="aspectFill" class="hero-portrait" binderror="onPortraitError" />
    <view class="hero-fb" wx:if="{{portraitFail}}">
      <text class="hero-fb-text">{{officer.name[0]}}</text>
    </view>
    <view class="hero-overlay">
      <view class="rarity-badge rarity-{{officer.rarityName}}"><text class="rarity-letter">{{officer.rarityName}}</text></view>
      <text class="hero-name">{{officer.name}}</text>
      <view class="hero-meta">
        <text class="hero-tag">{{officer.jobName}}</text>
        <text class="hero-tag">{{officer.genderName}}</text>
        <text class="hero-tag">{{officer.nationalityName}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-title">語言</text>
    <view class="tag-row">
      <text wx:for="{{officer.languages}}" wx:key="languageId" class="tag">{{item.name}} Lv.{{item.level}}</text>
    </view>
  </view>

  <view class="section" wx:if="{{activeSkills.length > 0}}">
    <text class="section-title">主動技能</text>
    <view class="skill-list">
      <view wx:for="{{activeSkills}}" wx:key="skillId" class="skill-card">
        <image src="{{item.iconPath}}" mode="aspectFit" class="skill-icon"
               bindtap="onSkillTap" data-skill-id="{{item.skillId}}" />
        <view class="skill-body">
          <text class="skill-name">{{item.name}}</text>
          <text class="skill-detail">Lv.{{item.level}} / 解鎖 Lv.{{item.unlockLevel}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{passiveSkills.length > 0}}">
    <text class="section-title">被動技能</text>
    <view class="skill-list">
      <view wx:for="{{passiveSkills}}" wx:key="skillId" class="skill-card">
        <image src="{{item.iconPath}}" mode="aspectFit" class="skill-icon"
               bindtap="onSkillTap" data-skill-id="{{item.skillId}}" />
        <view class="skill-body">
          <text class="skill-name">{{item.name}}</text>
          <text class="skill-detail">Lv.{{item.level}} / 解鎖 Lv.{{item.unlockLevel}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-title">招募資訊</text>
    <view class="recruit-row">
      <text class="recruit-label">城市</text>
      <text class="recruit-value">{{officer.recruitment.cityText}}</text>
    </view>
    <view class="recruit-row" wx:if="{{officer.recruitment.requirementName}}">
      <text class="recruit-label">條件</text>
      <text class="recruit-value">{{officer.recruitment.requirementName}}</text>
    </view>
    <view class="recruit-row" wx:if="{{officer.recruitment.note}}">
      <text class="recruit-label">備註</text>
      <text class="recruit-value">{{officer.recruitment.note}}</text>
    </view>
  </view>
</scroll-view>

<!-- 技能描述浮層 -->
<view class="tooltip-mask" wx:if="{{tooltipSkill}}" bindtap="onTooltipDismiss">
  <view class="tooltip-popup" catchtap="">
    <image src="{{tooltipSkill.iconPath}}" mode="aspectFit" class="tooltip-icon" />
    <text class="tooltip-name">{{tooltipSkill.name}}</text>
    <text class="tooltip-level">Lv.{{tooltipSkill.level}} / 解鎖 Lv.{{tooltipSkill.unlockLevel}}</text>
    <view class="tooltip-divider"></view>
    <text class="tooltip-desc">{{tooltipSkill.description}}</text>
    <view class="tooltip-divider" wx:if="{{tooltipSkill.levelInfo}}"></view>
    <text class="tooltip-level-info" wx:if="{{tooltipSkill.levelInfo}}">{{tooltipSkill.levelInfo}}</text>
    <view class="tooltip-close" bindtap="onTooltipDismiss">
      <text class="tooltip-close-text">關閉</text>
    </view>
  </view>
</view>
