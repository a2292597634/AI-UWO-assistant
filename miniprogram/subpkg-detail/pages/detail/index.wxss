.detail-page {
  height: 100vh;
  background: #ded7c7;
}
.hero {
  position: relative;
  height: 400rpx;
  overflow: hidden;
  background: #2f302b;
}
.hero-portrait {
  width: 100%;
  height: 100%;
}
.hero-fb {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2f302b;
}
.hero-fb-text {
  font-size: 120rpx;
  color: #e8d5a3;
  font-weight: bold;
  opacity: 0.4;
}
.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 32rpx 24rpx;
  background: linear-gradient(transparent, rgba(47, 48, 43, 0.85));
}
.hero-rarity {
  font-size: 22rpx;
  color: #e8d5a3;
}
/* Rarity grade badges */
.rarity-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.rarity-letter {
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1;
}
.rarity-s {
  background: #c4a45a;
}
.rarity-a {
  background: #8a8a8a;
}
.rarity-b {
  background: #b87333;
}
.rarity-c {
  background: #5a5a4e;
}
.hero-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin: 8rpx 0;
}
.hero-meta {
  display: flex;
}
.hero-tag {
  font-size: 24rpx;
  color: #c4b99a;
  padding: 4rpx 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  margin-right: 16rpx;
}
.section {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #c4b99a;
}
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #292a26;
  display: block;
  margin-bottom: 16rpx;
}
.tag-row {
  display: flex;
  flex-wrap: wrap;
}
.tag {
  font-size: 24rpx;
  color: #3d3d35;
  padding: 8rpx 20rpx;
  background: #d4cbb4;
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}
.skill-list {
  display: flex;
  flex-direction: column;
}
.skill-card {
  display: flex;
  align-items: center;
  padding: 12rpx;
  background: #e8dfce;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}
.skill-icon {
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
}
.skill-body {
  flex: 1;
}
.skill-name {
  font-size: 26rpx;
  color: #292a26;
  display: block;
}
.skill-detail {
  font-size: 22rpx;
  color: #8a8a7e;
}
.recruit-row {
  display: flex;
  margin-bottom: 12rpx;
}
.recruit-label {
  width: 80rpx;
  font-size: 24rpx;
  color: #8a8a7e;
  flex-shrink: 0;
}
.recruit-value {
  font-size: 24rpx;
  color: #292a26;
}

/* ── Skill description tooltip ── */

.tooltip-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.tooltip-popup {
  position: fixed;
  top: 25%;
  left: 48rpx;
  right: 48rpx;
  background: #f5f0e6;
  border-radius: 16rpx;
  padding: 40rpx 32rpx 24rpx;
  z-index: 101;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.3);
}

.tooltip-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
}

.tooltip-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #292a26;
  margin-bottom: 8rpx;
  text-align: center;
}

.tooltip-level {
  font-size: 22rpx;
  color: #8a8a7e;
  margin-bottom: 16rpx;
}

.tooltip-divider {
  width: 60rpx;
  height: 2rpx;
  background: #c4b99a;
  margin-bottom: 16rpx;
}

.tooltip-desc {
  font-size: 26rpx;
  color: #3d3d35;
  line-height: 1.6;
  text-align: center;
}

.tooltip-level-info {
  font-size: 22rpx;
  color: #8a8a7e;
  line-height: 1.5;
  text-align: center;
  max-height: 240rpx;
  overflow-y: scroll;
}

.tooltip-close {
  margin-top: 24rpx;
  padding: 12rpx 48rpx;
  background: #2f302b;
  border-radius: 8rpx;
}

.tooltip-lookup {
  margin-top: 20rpx;
  padding: 12rpx 48rpx;
  background: transparent;
  border: 2rpx solid #c4b99a;
  border-radius: 8rpx;
}

.tooltip-lookup text {
  font-size: 24rpx;
  color: #5a5a4e;
}

.tooltip-close-text {
  font-size: 24rpx;
  color: #e8d5a3;
}

/* Tap feedback on skill cards */
.skill-card:active {
  background: #d4cbb4;
}
