.asset-loading-state,
.asset-load-error {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  color: #5a5a4e;
  text-align: center;
}

.asset-load-error {
  flex-direction: column;
}

.detail-page {
  height: 100vh;
  background: #e7deca;
}

.dossier-card {
  display: flex;
  align-items: flex-start;
  margin: 24rpx;
  padding: 24rpx;
  background: #f4ecdc;
  border: 1rpx solid rgba(111, 88, 46, 0.24);
  border-radius: 14rpx;
  box-shadow: 0 8rpx 24rpx rgba(38, 51, 47, 0.12);
}

.dossier-portrait {
  position: relative;
  width: 192rpx;
  height: 192rpx;
  margin-right: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #26332f;
  border-radius: 8rpx;
}

.portrait-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 192rpx;
  height: 192rpx;
}

.portrait-frame {
  z-index: 1;
}

.portrait-photo,
.portrait-fallback {
  z-index: 2;
}

.portrait-photo {
  width: 192rpx;
  height: 192rpx;
}

.portrait-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e8d5a3;
  background: #26332f;
  font-size: 72rpx;
  font-weight: 700;
}

.portrait-rarity {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 120rpx;
  height: 120rpx;
}

.portrait-type {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  z-index: 4;
  width: 48rpx;
  height: 48rpx;
}

.dossier-identity {
  min-width: 0;
  flex: 1;
}

.dossier-name {
  display: block;
  color: #26332f;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.25;
}

.dossier-job {
  display: block;
  margin-top: 6rpx;
  color: #896f3e;
  font-size: 25rpx;
  line-height: 1.35;
}

.identity-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.identity-fact {
  display: flex;
  width: 50%;
  min-width: 0;
  padding: 3rpx 8rpx 3rpx 0;
  font-size: 21rpx;
  line-height: 1.4;
}

.identity-label {
  margin-right: 8rpx;
  flex-shrink: 0;
  color: #8a8172;
}

.identity-value {
  min-width: 0;
  color: #3d3d35;
}

.identity-languages {
  display: block;
  margin-top: 10rpx;
  color: #625b4f;
  font-size: 21rpx;
  line-height: 1.45;
}

.content-section {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  background: rgba(247, 240, 225, 0.82);
  border-top: 3rpx solid #b99552;
  border-radius: 10rpx;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  display: block;
  color: #292a26;
  font-size: 29rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.section-count {
  color: #8a8172;
  font-size: 21rpx;
}

.skill-list {
  display: flex;
  flex-direction: column;
}

.skill-card {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  margin-bottom: 12rpx;
  padding: 16rpx 18rpx;
  background: #fffaf0;
  border: 1rpx solid rgba(111, 88, 46, 0.2);
  border-radius: 10rpx;
}

.skill-card:last-child {
  margin-bottom: 0;
}

.skill-card:active {
  background: #eadfc8;
}

.skill-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.detail-skill-icon-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.detail-skill-icon-wrapper .skill-icon {
  margin-right: 0;
}

.skill-level-badge {
  position: absolute;
  top: -8rpx;
  right: -10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 24rpx;
  padding: 0 4rpx;
  color: #f0e4c4;
  background: #8b3a3a;
  border: 1rpx solid #f0e4c4;
  border-radius: 10rpx;
  font-size: 16rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.skill-body {
  min-width: 0;
  flex: 1;
}

.skill-name {
  display: block;
  color: #292a26;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.35;
}

.skill-levels {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 8rpx;
  font-size: 21rpx;
}

.skill-current {
  margin-right: 14rpx;
  color: #765b26;
  font-weight: 600;
}

.skill-unlock {
  color: #8a8172;
}

.skill-action {
  width: 84rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
  color: #8a7445;
  font-size: 20rpx;
  text-align: right;
}

.language-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.language-item {
  display: flex;
  align-items: center;
  margin: 0 12rpx 10rpx 0;
  padding: 10rpx 16rpx;
  color: #3d3d35;
  background: #e4d8bd;
  border-radius: 6rpx;
  font-size: 23rpx;
}

.language-level {
  margin-left: 10rpx;
  color: #765b26;
  font-weight: 600;
}

.empty-copy {
  display: block;
  margin-top: 14rpx;
  color: #8a8172;
  font-size: 23rpx;
}

.recruitment-section {
  color: #6c655a;
  background: rgba(237, 228, 209, 0.72);
  border-top-color: #a89b82;
}

.recruitment-list {
  margin-top: 14rpx;
}

.recruitment-row {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 0;
  font-size: 23rpx;
  line-height: 1.5;
}

.recruitment-label {
  width: 80rpx;
  flex-shrink: 0;
  color: #8a8172;
}

.recruitment-value {
  min-width: 0;
  flex: 1;
  color: #5f594f;
}

.page-spacer {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

.detail-empty {
  display: flex;
  min-height: 100vh;
  align-items: center;
  justify-content: center;
  color: #736a5a;
  background: #e7deca;
  font-size: 26rpx;
}
