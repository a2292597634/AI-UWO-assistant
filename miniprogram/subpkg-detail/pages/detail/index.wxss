.asset-loading-state,
.asset-load-error {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  color: #5a5a4e;
  text-align: center;
}

.asset-load-error {
  flex-direction: column;
}

.detail-page {
  height: 100vh;
  background: var(--uwo-color-canvas);
}

.dossier-card {
  display: flex;
  align-items: flex-start;
  margin: var(--uwo-space-6);
  padding: var(--uwo-space-6);
  background: var(--uwo-color-surface);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
}

.dossier-portrait {
  position: relative;
  width: 192rpx;
  height: 192rpx;
  margin-right: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--uwo-color-ink);
  border-radius: var(--uwo-radius-control);
}

.portrait-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 192rpx;
  height: 192rpx;
}

.portrait-frame {
  z-index: 1;
}

.portrait-photo,
.portrait-fallback {
  z-index: 2;
}

.portrait-photo {
  width: 192rpx;
  height: 192rpx;
}

.portrait-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--uwo-color-accent-brass);
  background: var(--uwo-color-ink);
  font-size: var(--uwo-font-size-page-title);
  font-weight: 700;
}

.portrait-rarity {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 120rpx;
  height: 120rpx;
}

.portrait-type {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  z-index: 4;
  width: 48rpx;
  height: 48rpx;
}

.dossier-identity {
  min-width: 0;
  flex: 1;
}

.dossier-name {
  display: block;
  color: var(--uwo-color-ink);
  font-family: var(--uwo-font-family-display);
  font-size: var(--uwo-font-size-page-title);
  font-weight: 700;
  line-height: 1.25;
}

.dossier-job {
  display: block;
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-body);
  line-height: 1.35;
}

.identity-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--uwo-space-3);
}

.identity-fact {
  display: flex;
  width: 50%;
  min-width: 0;
  padding: var(--uwo-space-1) var(--uwo-space-2) var(--uwo-space-1) 0;
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.4;
}

.identity-label {
  margin-right: var(--uwo-space-2);
  flex-shrink: 0;
  color: var(--uwo-color-text-secondary);
}

.identity-value {
  min-width: 0;
  color: var(--uwo-color-text-primary);
}

.identity-languages {
  display: block;
  margin-top: var(--uwo-space-2);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.content-section {
  margin: 0 var(--uwo-space-6) var(--uwo-space-4);
  padding: var(--uwo-space-6);
  background: var(--uwo-color-surface);
  border-top: 2rpx solid var(--uwo-color-accent-brass);
  border-radius: var(--uwo-radius-card);
}

.content-section--skills {
  margin-bottom: var(--uwo-space-6);
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 var(--uwo-space-1) var(--uwo-space-3);
}

.section-title {
  display: block;
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-section-title);
  font-weight: 700;
  letter-spacing: 1rpx;
}

.section-count {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
}

.skill-list {
  display: flex;
  flex-direction: column;
}

.skill-card {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  margin-bottom: var(--uwo-space-2);
  padding: var(--uwo-space-4);
  background: var(--uwo-color-surface);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
}

.skill-card:last-child {
  margin-bottom: 0;
}

.skill-card:active {
  background: var(--uwo-color-surface-muted);
}

.skill-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: var(--uwo-space-4);
  flex-shrink: 0;
}

.detail-skill-icon-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin-right: var(--uwo-space-4);
  flex-shrink: 0;
}

.detail-skill-icon-wrapper .skill-icon {
  margin-right: 0;
}

.skill-level-badge {
  position: absolute;
  top: -8rpx;
  right: -10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 24rpx;
  padding: 0 4rpx;
  color: #f0e4c4;
  background: #8b3a3a;
  border: 1rpx solid #f0e4c4;
  border-radius: 10rpx;
  font-size: 16rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.skill-body {
  min-width: 0;
  flex: 1;
  overflow-wrap: anywhere;
}

.skill-name {
  display: block;
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 600;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.skill-levels {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: var(--uwo-space-2);
  font-size: var(--uwo-font-size-minimum-action);
}

.skill-current {
  margin-right: var(--uwo-space-3);
  color: var(--uwo-color-accent-text);
  font-weight: 600;
}

.skill-unlock {
  color: var(--uwo-color-text-secondary);
}

.skill-action {
  width: 96rpx;
  margin-left: var(--uwo-space-3);
  flex-shrink: 0;
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.4;
  text-align: right;
  overflow-wrap: anywhere;
}

.language-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--uwo-space-4);
}

.language-item {
  display: flex;
  align-items: center;
  margin: 0 var(--uwo-space-3) var(--uwo-space-2) 0;
  padding: var(--uwo-space-2) var(--uwo-space-4);
  color: var(--uwo-color-text-primary);
  background: var(--uwo-color-surface-muted);
  border-radius: var(--uwo-radius-pill);
  font-size: var(--uwo-font-size-supporting);
}

.language-level {
  margin-left: var(--uwo-space-2);
  color: var(--uwo-color-accent-text);
  font-weight: 600;
}

.empty-copy {
  display: block;
  margin-top: var(--uwo-space-3);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.recruitment-section {
  color: var(--uwo-color-text-secondary);
  background: var(--uwo-color-surface-muted);
  border-top-color: var(--uwo-color-border-strong);
}

.recruitment-list {
  margin-top: var(--uwo-space-3);
}

.recruitment-row {
  display: flex;
  align-items: flex-start;
  padding: var(--uwo-space-2) 0;
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.recruitment-label {
  width: 80rpx;
  flex-shrink: 0;
  color: var(--uwo-color-text-secondary);
}

.recruitment-value {
  min-width: 0;
  flex: 1;
  color: var(--uwo-color-text-primary);
  overflow-wrap: anywhere;
}

.page-spacer {
  height: calc(var(--uwo-space-6) + env(safe-area-inset-bottom));
}

.detail-empty {
  display: flex;
  min-height: 100vh;
  align-items: center;
  justify-content: center;
  color: var(--uwo-color-text-secondary);
  background: var(--uwo-color-canvas);
  font-size: var(--uwo-font-size-body);
}
