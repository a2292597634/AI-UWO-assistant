<view wx:if="{{reviewList}}" class="maintenance-editor">
  <view class="maintenance-editor__heading">待審核工單</view>
  <view wx:if="{{!reviewOrders.length}}" class="maintenance-editor__hint">目前沒有待審核工單。</view>
  <button wx:for="{{reviewOrders}}" wx:key="workOrderId" class="ui-button ui-button--secondary" data-id="{{item.workOrderId}}" bindtap="onReviewOrder">{{item.proposedData.name}}・待審核</button>
</view>
<block wx:else>
  <include src="../work-order-editor/index.wxml" />
  <view wx:if="{{!loading &amp;&amp; !loadError}}" class="maintenance-review">
    <view class="maintenance-editor__title">基準資料 → 最新修訂</view>
    <view wx:if="{{!reviewDiff.length}}" class="maintenance-editor__hint">航海士欄位無變更。</view>
    <view wx:for="{{reviewDiff}}" wx:key="field" class="maintenance-review__diff"><view>{{item.label}}</view><view>原值：{{item.beforeText}}</view><view>修訂：{{item.afterText}}</view></view>
    <view class="maintenance-editor__title">投稿內容 → 管理員修訂</view>
    <view wx:if="{{!proposalDiff.length}}" class="maintenance-editor__hint">目前與投稿內容相同。</view>
    <view wx:for="{{proposalDiff}}" wx:key="field" class="maintenance-review__diff"><view>{{item.label}}</view><view>投稿：{{item.beforeText}}</view><view>修訂：{{item.afterText}}</view></view>
    <view wx:if="{{conflict}}" class="ui-status ui-status--review">需復核：{{conflict}}</view>
    <view class="maintenance-editor__hint">核准時將再次檢查工單與正式資料版本。操作期間或完成審核後不能修改。</view>
    <label class="maintenance-editor__label">本次修訂原因（儲存與核准時必填）<textarea class="maintenance-editor__textarea" value="{{reviewReason}}" bindinput="onReviewReasonInput" disabled="{{readonly || saving}}" maxlength="2000" /></label>
    <label class="maintenance-editor__label">駁回原因（駁回時必填）<textarea class="maintenance-editor__textarea" value="{{rejectReason}}" bindinput="onRejectReasonInput" disabled="{{readonly || saving}}" maxlength="2000" /></label>
    <view class="maintenance-editor__actions">
      <view wx:if="{{saving}}" class="maintenance-editor__hint">正在處理審核操作，請稍候…</view>
      <button class="ui-button ui-button--secondary" bindtap="onSaveReview" disabled="{{readonly || saving}}" loading="{{saving}}">儲存管理員修訂</button>
      <button class="ui-button ui-button--primary" bindtap="onApprove" disabled="{{readonly || saving}}">檢查最新差異並核准</button>
      <button class="ui-button ui-button--secondary" bindtap="onReject" disabled="{{readonly || saving}}">駁回工單</button>
      <button class="ui-button ui-button--secondary" bindtap="onReviewList">返回審核列表</button>
    </view>
  </view>
</block>
