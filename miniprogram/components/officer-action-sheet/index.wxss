.officer-action-sheet__trigger {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-width: 88rpx;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  padding: 0 var(--uwo-space-2);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.3;
  white-space: normal;
  overflow-wrap: anywhere;
}

.officer-action-sheet__trigger--slot {
  min-width: 0;
  padding-right: var(--uwo-space-1);
  padding-left: var(--uwo-space-1);
}

.officer-action-sheet__mask {
  position: fixed;
  inset: 0;
  z-index: 220;
  background: var(--uwo-color-ink);
  opacity: 0.55;
}

.officer-action-sheet__panel {
  box-sizing: border-box;
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 221;
  display: flex;
  flex-direction: column;
  max-height: 82vh;
  padding-top: var(--uwo-space-8);
  padding-right: var(--uwo-space-6);
  padding-bottom: calc(var(--uwo-space-6) + env(safe-area-inset-bottom));
  padding-left: var(--uwo-space-6);
  overflow: hidden;
  border-radius: var(--uwo-radius-sheet) var(--uwo-radius-sheet) 0 0;
  background: var(--uwo-color-surface);
  box-shadow: var(--uwo-shadow-sheet);
  color: var(--uwo-color-text-primary);
  font-family: var(--uwo-font-family-body);
}

.officer-action-sheet__header,
.officer-action-sheet__actions {
  display: flex;
}

.officer-action-sheet__header {
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--uwo-space-4);
}

.officer-action-sheet__heading {
  min-width: 0;
  flex: 1;
}

.officer-action-sheet__name,
.officer-action-sheet__status,
.officer-action-sheet__disabled-reason,
.officer-action-sheet__hint {
  display: block;
  overflow-wrap: anywhere;
}

.officer-action-sheet__name {
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-section-title);
  font-weight: 700;
  line-height: 1.35;
}

.officer-action-sheet__status,
.officer-action-sheet__hint {
  margin-top: var(--uwo-space-2);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.officer-action-sheet__close {
  flex: 0 0 auto;
  min-width: 88rpx;
  min-height: 88rpx;
  padding: 0 var(--uwo-space-3);
}

.officer-action-sheet__actions {
  flex-direction: column;
  gap: var(--uwo-space-3);
  margin-top: var(--uwo-space-6);
}

.officer-action-sheet__action {
  display: flex;
  min-height: 88rpx;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  width: 100%;
  padding: var(--uwo-space-3) var(--uwo-space-4);
  text-align: left;
  white-space: normal;
  overflow-wrap: anywhere;
}

.officer-action-sheet__action-label {
  display: block;
  font-size: var(--uwo-font-size-body);
  font-weight: 600;
  line-height: 1.35;
}

.officer-action-sheet__disabled-reason {
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  font-weight: 400;
  line-height: 1.35;
}

.officer-action-sheet__hint {
  margin-top: var(--uwo-space-4);
  text-align: center;
}
