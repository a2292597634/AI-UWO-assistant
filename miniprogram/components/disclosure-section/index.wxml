<view class="disclosure-section disclosure-section--{{expanded ? 'expanded' : 'collapsed'}} {{compact ? 'disclosure-section--compact' : ''}}">
  <view class="disclosure-section__header">
    <view class="disclosure-section__copy">
      <text class="disclosure-section__title">{{title}}</text>
      <text wx:if="{{hint}}" class="disclosure-section__hint">{{hint}}</text>
    </view>
    <view class="disclosure-section__meta">
      <text wx:if="{{countLabel}}" class="disclosure-section__count">{{countLabel}}</text>
      <button
        class="disclosure-section__toggle"
        bindtap="onToggle"
        aria-expanded="{{expanded}}"
        aria-label="{{expanded ? '收起' : '展開'}}{{title}}"
      >
        <image
          wx:if="{{expanded}}"
          class="disclosure-section__icon disclosure-section__icon--expanded"
          src="/assets/ui/uwo-disclosure-chevron-up.png"
          mode="aspectFit"
          aria-hidden="true"
        />
        <image
          wx:else
          class="disclosure-section__icon"
          src="/assets/ui/uwo-disclosure-chevron-down.png"
          mode="aspectFit"
          aria-hidden="true"
        />
      </button>
    </view>
  </view>
  <view wx:if="{{expanded}}" class="disclosure-section__body">
    <slot />
  </view>
</view>
