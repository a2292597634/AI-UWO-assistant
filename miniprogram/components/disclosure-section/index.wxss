.disclosure-section {
  margin: 0 0 var(--uwo-space-4);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-surface);
  color: var(--uwo-color-text-primary);
  font-family: var(--uwo-font-family-body);
}

.disclosure-section--compact {
  margin-bottom: var(--uwo-space-2);
}

.disclosure-section__header {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  gap: var(--uwo-space-3);
  padding: 0 var(--uwo-space-4);
}

.disclosure-section__toggle {
  box-sizing: border-box;
  display: flex;
  width: 64rpx;
  min-width: 64rpx;
  min-height: 64rpx;
  margin: 0;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--uwo-color-text-primary);
  font-family: var(--uwo-font-family-body);
  font-size: var(--uwo-font-size-body);
  flex: 0 0 auto;
  overflow: visible;
}

.disclosure-section__toggle::after {
  border: 0;
}

.disclosure-section__toggle:active {
  opacity: 0.88;
  transform: translateY(2rpx);
}

.disclosure-section__copy,
.disclosure-section__meta {
  display: flex;
  min-width: 0;
  align-items: center;
}

.disclosure-section__copy {
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--uwo-space-1);
  text-align: left;
}

.disclosure-section__meta {
  flex: 0 0 auto;
  gap: var(--uwo-space-2);
  margin-left: 0;
}

.disclosure-section__title,
.disclosure-section__hint,
.disclosure-section__count {
  display: block;
  overflow-wrap: anywhere;
}

.disclosure-section__title {
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 600;
}

.disclosure-section__hint,
.disclosure-section__count {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.disclosure-section__icon {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 auto;
  transform-origin: center;
  transform: scale(3);
}

.disclosure-section__icon--expanded {
  transform: scaleX(2.85) scaleY(2.82);
}

.disclosure-section__count {
  flex: 0 0 auto;
  text-align: right;
}

.disclosure-section__body {
  padding: 0 var(--uwo-space-4) var(--uwo-space-4);
  border-top: 2rpx solid var(--uwo-color-border-subtle);
}

.disclosure-section--compact .disclosure-section__header {
  padding-right: var(--uwo-space-2);
  padding-left: var(--uwo-space-2);
}

.disclosure-section--compact .disclosure-section__body {
  padding-right: var(--uwo-space-2);
  padding-bottom: var(--uwo-space-2);
  padding-left: var(--uwo-space-2);
}
