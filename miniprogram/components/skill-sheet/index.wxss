.skill-sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  background: rgba(25, 25, 22, 0.58);
}

.skill-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 84vh;
  padding: 16rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  color: #292a26;
  background: #f5efe0;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(25, 25, 22, 0.24);
  animation: skill-sheet-enter 180ms ease-out both;
}

.skill-sheet__handle {
  width: 72rpx;
  height: 6rpx;
  margin: 0 auto 24rpx;
  background: #b9aa8b;
  border-radius: 999rpx;
}

.skill-sheet__header {
  display: flex;
  align-items: center;
}

.skill-sheet__icon {
  width: 88rpx;
  height: 88rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.skill-sheet__identity {
  min-width: 0;
  flex: 1;
}

.skill-sheet__name {
  display: block;
  color: #292a26;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.skill-sheet__meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  color: #6e6555;
  font-size: 22rpx;
}

.skill-sheet__kind::after {
  margin: 0 10rpx;
  color: #b9aa8b;
  content: '・';
}

.skill-sheet__close {
  margin-left: 16rpx;
  padding: 12rpx 0 12rpx 20rpx;
  color: #756b59;
  font-size: 24rpx;
}

.skill-sheet__description {
  display: block;
  margin-top: 28rpx;
  padding: 20rpx 0;
  color: #3d3d35;
  border-top: 1rpx solid #d4c8ad;
  border-bottom: 1rpx solid #d4c8ad;
  font-size: 26rpx;
  line-height: 1.65;
}

.skill-sheet__levels {
  margin-top: 12rpx;
}

.level-row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(185, 170, 139, 0.55);
}

.level-row__label {
  width: 88rpx;
  flex-shrink: 0;
  color: #725c2d;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.55;
}

.level-row__description {
  flex: 1;
  color: #3d3d35;
  font-size: 24rpx;
  line-height: 1.55;
}

.level-row--missing .level-row__description {
  color: #8a8172;
}

.skill-sheet__lookup {
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  color: #f2e4bd;
  background: #34352f;
  border-radius: 10rpx;
  font-size: 26rpx;
  text-align: center;
}

@keyframes skill-sheet-enter {
  from {
    opacity: 0;
    transform: translateY(36rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}
