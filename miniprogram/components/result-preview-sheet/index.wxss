.result-preview-sheet__mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background: var(--uwo-color-ink);
  opacity: 0.45;
}

.result-preview-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 21;
  max-height: 82vh;
  overflow-y: auto;
  padding-top: var(--uwo-space-8);
  padding-right: var(--uwo-space-6);
  padding-bottom: calc(var(--uwo-space-6) + env(safe-area-inset-bottom));
  padding-left: var(--uwo-space-6);
  border-radius: var(--uwo-radius-sheet) var(--uwo-radius-sheet) 0 0;
  background: var(--uwo-color-surface);
  box-shadow: var(--uwo-shadow-sheet);
  color: var(--uwo-color-text-primary);
}

.result-preview-sheet__header,
.result-preview-sheet__summary,
.result-preview-sheet__member-count,
.result-preview-sheet__actions,
.result-preview-sheet__undo-bar {
  display: flex;
  align-items: center;
}

.result-preview-sheet__header,
.result-preview-sheet__summary,
.result-preview-sheet__member-count,
.result-preview-sheet__undo-bar {
  justify-content: space-between;
}

.result-preview-sheet__heading,
.result-preview-sheet__member-group,
.result-preview-sheet__locked,
.result-preview-sheet__constraints {
  min-width: 0;
}

.result-preview-sheet__title,
.result-preview-sheet__scope,
.result-preview-sheet__group-title,
.result-preview-sheet__member,
.result-preview-sheet__constraint,
.result-preview-sheet__disabled-reason {
  display: block;
  overflow-wrap: anywhere;
}

.result-preview-sheet__title,
.result-preview-sheet__summary-value {
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 700;
}

.result-preview-sheet__scope,
.result-preview-sheet__group-title,
.result-preview-sheet__constraint {
  margin-top: var(--uwo-space-2);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
}

.result-preview-sheet__close {
  min-width: 88rpx;
  min-height: 88rpx;
  padding: 0 var(--uwo-space-3);
  border: 0 solid var(--uwo-color-accent-text);
  background: transparent;
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.4;
}

.result-preview-sheet__close::after {
  border: 0 solid var(--uwo-color-accent-text);
}

.result-preview-sheet__summary,
.result-preview-sheet__constraints {
  margin-top: var(--uwo-space-4);
  padding: var(--uwo-space-4);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface-muted);
}

.result-preview-sheet__target-list,
.result-preview-sheet__members,
.result-preview-sheet__locked {
  margin-top: var(--uwo-space-4);
}

.result-preview-sheet__target-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: var(--uwo-space-1) var(--uwo-space-3);
  padding: var(--uwo-space-3) 0;
  border-bottom: 2rpx solid var(--uwo-color-border-subtle);
}

.result-preview-sheet__target-name,
.result-preview-sheet__target-level,
.result-preview-sheet__target-state {
  overflow-wrap: anywhere;
  font-size: var(--uwo-font-size-minimum-action);
}

.result-preview-sheet__target-level {
  color: var(--uwo-color-text-secondary);
}

.result-preview-sheet__target-state {
  grid-row: 1 / span 2;
  grid-column: 2;
  text-align: right;
}

.result-preview-sheet__member-count {
  gap: var(--uwo-space-3);
  margin-top: var(--uwo-space-4);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
}

.result-preview-sheet__members {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--uwo-space-3);
}

.result-preview-sheet__member {
  margin-top: var(--uwo-space-2);
  font-size: var(--uwo-font-size-minimum-action);
}

.result-preview-sheet__member--added {
  color: var(--uwo-color-success);
}

.result-preview-sheet__member--removed,
.result-preview-sheet__disabled-reason {
  color: var(--uwo-color-danger);
}

.result-preview-sheet__disabled-reason {
  margin-top: var(--uwo-space-4);
  font-size: var(--uwo-font-size-minimum-action);
}

.result-preview-sheet__actions {
  gap: var(--uwo-space-4);
  margin-top: var(--uwo-space-6);
}

.result-preview-sheet__action {
  flex: 1;
  min-height: 88rpx;
  font-size: var(--uwo-font-size-body);
}

.result-preview-sheet__undo-bar {
  position: fixed;
  right: var(--uwo-space-6);
  bottom: calc(var(--uwo-space-6) + env(safe-area-inset-bottom));
  left: var(--uwo-space-6);
  z-index: 19;
  gap: var(--uwo-space-4);
  padding: var(--uwo-space-3) var(--uwo-space-4);
  border: 2rpx solid var(--uwo-color-border-strong);
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-surface);
  box-shadow: var(--uwo-shadow-elevated);
}

.result-preview-sheet__undo-text {
  min-width: 0;
  overflow-wrap: anywhere;
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-supporting);
}

.result-preview-sheet__undo-action {
  flex-shrink: 0;
  min-height: 88rpx;
  font-size: var(--uwo-font-size-minimum-action);
}
