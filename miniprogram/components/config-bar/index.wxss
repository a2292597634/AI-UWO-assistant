.config-bar {
  display: flex;
  flex-direction: column;
  gap: var(--uwo-space-2);
  padding: var(--uwo-space-2) var(--uwo-space-4);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-surface);
  color: var(--uwo-color-text-primary);
  font-family: var(--uwo-font-family-body);
}

.config-bar__summary {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: var(--uwo-space-2);
  min-height: 88rpx;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
}

.config-bar__summary-copy,
.config-bar__summary-meta {
  display: flex;
  min-width: 0;
  align-items: center;
}

.config-bar__summary-copy {
  flex: 1 1 auto;
  gap: var(--uwo-space-2);
}

.config-bar__summary-meta {
  flex: 0 0 auto;
  gap: var(--uwo-space-1);
  margin-left: 0;
  white-space: nowrap;
}

.config-bar__title,
.config-bar__name,
.config-bar__status,
.config-bar__count,
.config-bar__list-name,
.config-bar__active-label,
.config-bar__unclassified-title,
.config-bar__message {
  font-family: var(--uwo-font-family-body);
}

.config-bar__title {
  flex: 0 0 auto;
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 600;
}

.config-bar__name {
  min-width: 0;
  flex: 1 1 auto;
  overflow: hidden;
  font-size: var(--uwo-font-size-body);
  font-weight: 600;
  text-overflow: ellipsis;
}

.config-bar__status,
.config-bar__count {
  flex: 0 0 auto;
  font-size: var(--uwo-font-size-minimum-action);
}

.config-bar__meta-separator {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
}

.config-bar__status {
  color: var(--uwo-color-text-secondary);
}

.config-bar__status--saved {
  color: var(--uwo-color-success);
}

.config-bar__status--unsaved,
.config-bar__status--new {
  color: var(--uwo-color-warning);
}

.config-bar__count {
  color: var(--uwo-color-text-secondary);
}

.config-bar__toggle {
  box-sizing: border-box;
  display: flex;
  width: 64rpx !important;
  min-width: 64rpx !important;
  max-width: 64rpx !important;
  min-height: 88rpx;
  margin: 0 !important;
  flex: 0 0 64rpx !important;
  align-items: center;
  justify-content: center;
  padding: 0 !important;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--uwo-color-text-secondary);
  overflow: visible;
}

.config-bar__share {
  box-sizing: border-box;
  display: flex;
  width: 104rpx !important;
  min-width: 104rpx !important;
  max-width: 104rpx !important;
  min-height: 88rpx;
  flex: 0 0 104rpx !important;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  padding: 0 var(--uwo-space-2);
  border: 2rpx solid var(--uwo-color-accent-brass);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface-muted);
  color: var(--uwo-color-accent-text);
  font-family: var(--uwo-font-family-body);
  font-size: var(--uwo-font-size-minimum-action);
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.config-bar__share::after {
  border: 0;
}

.config-bar__share:active {
  transform: translateY(2rpx);
  opacity: 0.88;
}

.config-bar__share[disabled] {
  transform: none;
  opacity: 0.58;
}

.config-bar__toggle::after {
  border: 0;
}

.config-bar__toggle-icon {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 auto;
  transform-origin: center;
  transform: scale(3);
}

.config-bar__toggle-icon--expanded {
  transform: scaleX(2.85) scaleY(2.82);
}

.config-bar__content {
  display: flex;
  flex-direction: column;
  gap: var(--uwo-space-3);
  padding: var(--uwo-space-2) 0 var(--uwo-space-2);
  border-top: 2rpx solid var(--uwo-color-border-subtle);
}

.config-bar__list,
.config-bar__action-row,
.config-bar__unclassified,
.config-bar__classify-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--uwo-space-2);
}

.config-bar__management-actions {
  display: grid;
  width: 100%;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--uwo-space-1);
}

.config-bar__management-actions .config-bar__button {
  width: 100%;
  min-height: 88rpx;
  padding-right: var(--uwo-space-1);
  padding-left: var(--uwo-space-1);
  white-space: nowrap;
}

.config-bar__list,
.config-bar__unclassified {
  flex-direction: column;
}

.config-bar__list-row,
.config-bar__unclassified-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--uwo-space-2);
  min-width: 0;
}

.config-bar__list-row .config-bar__button {
  flex: 0 0 auto;
}

.config-bar__load {
  width: 112rpx !important;
  min-width: 112rpx !important;
  max-width: 112rpx !important;
  flex: 0 0 112rpx !important;
  margin: 0 !important;
  padding-right: var(--uwo-space-1);
  padding-left: var(--uwo-space-1);
}

.config-bar__exit {
  width: 160rpx !important;
  min-width: 160rpx !important;
  max-width: 160rpx !important;
  flex: 0 0 160rpx !important;
  margin: 0 !important;
  padding-right: var(--uwo-space-1);
  padding-left: var(--uwo-space-1);
}

.config-bar__list-copy {
  display: flex;
  flex: 1 1 auto;
  align-items: center;
  gap: var(--uwo-space-2);
  min-width: 0;
  overflow: hidden;
}

.config-bar__list-name {
  min-width: 0;
  overflow: hidden;
  font-size: var(--uwo-font-size-supporting);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.config-bar__active-label {
  flex: 0 0 auto;
  color: var(--uwo-color-success);
  font-size: var(--uwo-font-size-minimum-action);
}

.config-bar__message {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--uwo-space-2);
  min-height: 64rpx;
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  text-align: center;
}

.config-bar__message--error {
  color: var(--uwo-color-danger);
}

.config-bar__button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 88rpx;
  margin: 0;
  flex: 1 1 auto;
  padding: var(--uwo-space-2) var(--uwo-space-4);
  border: 2rpx solid var(--uwo-color-border-strong);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface);
  color: var(--uwo-color-text-primary);
  font-family: var(--uwo-font-family-body);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.35;
  text-align: center;
  white-space: normal;
  overflow-wrap: anywhere;
}

.config-bar__button::after {
  border: 0;
}

.config-bar__button--compact {
  min-height: 64rpx;
  padding: var(--uwo-space-1) var(--uwo-space-3);
}

.config-bar__button--danger {
  border-color: var(--uwo-color-danger);
  background: var(--uwo-color-danger);
  color: var(--uwo-color-surface);
}

.config-bar__unclassified {
  padding-top: var(--uwo-space-2);
  border-top: 2rpx solid var(--uwo-color-border-subtle);
}

.config-bar__unclassified-title {
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 600;
}

.config-bar__classify-actions {
  flex: 0 0 auto;
}

.config-bar__classify-actions .config-bar__button {
  flex: 0 1 auto;
}

.config-bar__summary:active {
  opacity: 0.88;
}

.config-bar__toggle:active {
  opacity: 0.88;
  transform: translateY(2rpx);
}

.config-bar__summary:focus {
  outline: 4rpx solid var(--uwo-color-accent-brass);
  outline-offset: 4rpx;
}

.config-bar__button:active {
  transform: translateY(2rpx);
  opacity: 0.88;
}

.config-bar__button[disabled] {
  transform: none;
  opacity: 1;
}

.config-bar__action-row {
  display: flex;
  align-items: stretch;
}

/* ── 冒險與戰鬥共用的統一配置卡 ── */

.config-bar {
  box-sizing: border-box;
  position: relative;
  flex: 0 0 auto;
  margin: var(--uwo-space-6) var(--uwo-space-6) var(--uwo-space-2);
  padding: var(--uwo-space-4);
  border-color: var(--uwo-color-border-strong);
  background: var(--uwo-color-surface-muted);
}

.config-bar::before {
  position: absolute;
  top: -2rpx;
  left: var(--uwo-space-6);
  width: 72rpx;
  height: 4rpx;
  border-radius: var(--uwo-radius-pill);
  background: var(--uwo-color-accent-brass);
  content: '';
}

.config-bar__share {
  flex-direction: column;
  gap: var(--uwo-space-1);
}

.config-bar__share-glyph {
  position: relative;
  width: 52rpx;
  height: 48rpx;
  flex: 0 0 52rpx;
  margin-bottom: var(--uwo-space-1);
  color: var(--uwo-color-accent-text);
}

.config-bar__share-node {
  position: absolute;
  z-index: 1;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid var(--uwo-color-accent-text);
  border-radius: var(--uwo-radius-pill);
  background: transparent;
}

.config-bar__share-node--top {
  top: 0;
  right: 0;
}

.config-bar__share-node--middle {
  top: 17rpx;
  left: 0;
}

.config-bar__share-node--bottom {
  right: 0;
  bottom: 0;
}

.config-bar__share-link {
  position: absolute;
  left: 9rpx;
  width: 35rpx;
  height: 3rpx;
  border-radius: var(--uwo-radius-pill);
  background: var(--uwo-color-accent-text);
  transform-origin: left center;
}

.config-bar__share-link--up {
  top: 14rpx;
  transform: rotate(-28deg);
}

.config-bar__share-link--down {
  bottom: 14rpx;
  transform: rotate(28deg);
}

.config-bar__share-label,
.config-bar__share-hint {
  display: block;
  text-align: center;
}

.config-bar__share-label {
  color: inherit;
  font-size: var(--uwo-font-size-body);
  font-weight: 600;
  line-height: 1.2;
}

.config-bar__share-hint {
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.2;
  white-space: nowrap;
}

.config-bar--prominent-share {
  min-height: 248rpx;
  padding: var(--uwo-space-3);
  border-color: var(--uwo-color-border-strong);
  background-color: var(--uwo-color-surface-muted);
  background-image: url('/assets/ui/config-paper-texture.png');
  box-shadow: var(--uwo-shadow-elevated);
}

.config-bar--prominent-share::after {
  position: absolute;
  z-index: 0;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  border: 1rpx solid var(--uwo-color-surface);
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-surface-muted);
  content: '';
  opacity: 0.88;
}

.config-bar--prominent-share::before {
  z-index: 2;
}

.config-bar--prominent-share > view {
  position: relative;
  z-index: 1;
}

.config-bar--prominent-share .config-bar__summary--prominent {
  display: flex;
  width: 100%;
  align-items: stretch;
  gap: var(--uwo-space-3);
  min-height: 216rpx;
  overflow: visible;
}

.config-bar--prominent-share .config-bar__config-toggle {
  box-sizing: border-box;
  display: flex;
  min-width: 0;
  min-height: 216rpx;
  flex: 1 1 0;
  flex-direction: column;
  justify-content: center;
  gap: var(--uwo-space-3);
  margin: 0;
  padding: var(--uwo-space-3);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface);
  color: var(--uwo-color-text-primary);
  text-align: left;
}

.config-bar--prominent-share .config-bar__config-toggle::after {
  border: 0;
}

.config-bar--prominent-share .config-bar__config-row {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: center;
  gap: var(--uwo-space-2);
}

.config-bar--prominent-share .config-bar__config-label {
  flex: 0 0 auto;
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-body);
  font-weight: 600;
  line-height: 1.2;
  white-space: nowrap;
}

.config-bar--prominent-share .config-bar__status {
  flex: 0 0 auto;
  margin-left: 0;
  padding: var(--uwo-space-1) var(--uwo-space-2);
  border: 1rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-pill);
  background: var(--uwo-color-surface-muted);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.2;
  white-space: nowrap;
}

.config-bar--prominent-share .config-bar__status--saved {
  border-color: var(--uwo-color-success);
  color: var(--uwo-color-success);
}

.config-bar--prominent-share .config-bar__status--unsaved,
.config-bar--prominent-share .config-bar__status--new {
  border-color: var(--uwo-color-border-subtle);
  color: var(--uwo-color-text-secondary);
}

.config-bar--prominent-share .config-bar__name {
  min-width: 0;
  overflow: hidden;
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-page-title);
  font-weight: 700;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.config-bar--prominent-share .config-bar__identity-copy {
  display: flex;
  min-width: 0;
  flex: 1 1 auto;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--uwo-space-2);
}

.config-bar--prominent-share .config-bar__count {
  flex: 0 0 auto;
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-body);
  line-height: 1.2;
  white-space: nowrap;
}

.config-bar--prominent-share .config-bar__config-row .config-bar__toggle-icon {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  transform: rotate(-90deg) scale(3);
}

.config-bar--prominent-share .config-bar__config-row .config-bar__toggle-icon--expanded {
  transform: rotate(90deg) scale(3);
}

.config-bar--prominent-share .config-bar__toggle-chevron {
  width: 18rpx;
  height: 18rpx;
  flex: 0 0 18rpx;
  border-right: 3rpx solid var(--uwo-color-text-primary);
  border-bottom: 3rpx solid var(--uwo-color-text-primary);
  transform: rotate(-45deg);
}

.config-bar--prominent-share .config-bar__toggle-chevron--expanded {
  transform: rotate(135deg);
}

.config-bar--prominent-share .config-bar__share--prominent {
  display: flex;
  width: 176rpx !important;
  min-width: 176rpx !important;
  max-width: 176rpx !important;
  min-height: 216rpx;
  flex: 0 0 176rpx !important;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--uwo-space-1);
  padding: var(--uwo-space-2) var(--uwo-space-3);
  border: 2rpx solid var(--uwo-color-ink);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-ink);
  color: var(--uwo-color-surface);
  font-size: var(--uwo-font-size-body);
  font-weight: 600;
}

.config-bar--prominent-share .config-bar__share-label {
  font-size: var(--uwo-font-size-section-title);
}

.config-bar--prominent-share .config-bar__share-glyph {
  width: 56rpx;
  height: 52rpx;
  flex-basis: 52rpx;
}

.config-bar--prominent-share .config-bar__share--prominent .config-bar__share-glyph {
  color: var(--uwo-color-surface);
}

.config-bar--prominent-share .config-bar__share--prominent .config-bar__share-node {
  border-color: var(--uwo-color-surface);
  background: var(--uwo-color-surface);
}

.config-bar--prominent-share .config-bar__share--prominent .config-bar__share-link {
  background: var(--uwo-color-surface);
}

.config-bar--prominent-share .config-bar__share--prominent .config-bar__share-hint {
  color: var(--uwo-color-accent-brass);
}

.config-bar--prominent-share .config-bar__share--prominent[disabled] {
  border-color: var(--uwo-color-border-subtle);
  background: var(--uwo-color-surface-muted);
  color: var(--uwo-color-text-secondary);
  opacity: 1;
}

.config-bar--prominent-share .config-bar__share--prominent[disabled] .config-bar__share-glyph {
  color: var(--uwo-color-text-secondary);
}

.config-bar--prominent-share .config-bar__share--prominent[disabled] .config-bar__share-node {
  border-color: var(--uwo-color-text-secondary);
}

.config-bar--prominent-share .config-bar__share--prominent[disabled] .config-bar__share-link {
  background: var(--uwo-color-text-secondary);
}

.config-bar--prominent-share .config-bar__share--prominent[disabled] .config-bar__share-hint {
  color: var(--uwo-color-text-secondary);
}

.config-bar--prominent-share .config-bar__config-toggle:active,
.config-bar--prominent-share .config-bar__share--prominent:active {
  transform: translateY(2rpx);
  opacity: 0.88;
}

.config-bar--prominent-share .config-bar__config-toggle:focus,
.config-bar--prominent-share .config-bar__config-toggle.config-bar__config-toggle--focused,
.config-bar--prominent-share .config-bar__share--prominent:focus,
.config-bar--prominent-share .config-bar__share--prominent.config-bar__share--focused {
  outline: 4rpx solid var(--uwo-color-accent-brass);
  outline-offset: 4rpx;
}

.config-bar--prominent-share .config-bar__content {
  margin-top: var(--uwo-space-3);
  padding-top: var(--uwo-space-3);
  border-top-color: var(--uwo-color-border-subtle);
}

.config-bar--prominent-share .config-bar__list-row {
  justify-content: flex-start;
  padding: var(--uwo-space-2) 0;
  border-bottom: 1rpx solid var(--uwo-color-border-subtle);
}

.config-bar--prominent-share .config-bar__action-row {
  padding-top: var(--uwo-space-2);
  border-top: 1rpx solid var(--uwo-color-border-subtle);
}
