.config-bar {
  display: flex;
  flex-direction: column;
  gap: var(--uwo-space-2);
  padding: var(--uwo-space-2) var(--uwo-space-4);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-surface);
  color: var(--uwo-color-text-primary);
  font-family: var(--uwo-font-family-body);
}

.config-bar__summary {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: var(--uwo-space-2);
  min-height: 88rpx;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
}

.config-bar__summary-copy,
.config-bar__summary-meta {
  display: flex;
  min-width: 0;
  align-items: center;
}

.config-bar__summary-copy {
  flex: 1 1 auto;
  gap: var(--uwo-space-2);
}

.config-bar__summary-meta {
  flex: 0 0 auto;
  gap: var(--uwo-space-1);
  margin-left: 0;
  white-space: nowrap;
}

.config-bar__title,
.config-bar__name,
.config-bar__status,
.config-bar__count,
.config-bar__list-name,
.config-bar__active-label,
.config-bar__unclassified-title,
.config-bar__message {
  font-family: var(--uwo-font-family-body);
}

.config-bar__title {
  flex: 0 0 auto;
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 600;
}

.config-bar__name {
  min-width: 0;
  flex: 1 1 auto;
  overflow: hidden;
  font-size: var(--uwo-font-size-body);
  font-weight: 600;
  text-overflow: ellipsis;
}

.config-bar__status,
.config-bar__count {
  flex: 0 0 auto;
  font-size: var(--uwo-font-size-minimum-action);
}

.config-bar__meta-separator {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
}

.config-bar__status {
  color: var(--uwo-color-text-secondary);
}

.config-bar__status--saved {
  color: var(--uwo-color-success);
}

.config-bar__status--unsaved,
.config-bar__status--new {
  color: var(--uwo-color-warning);
}

.config-bar__count {
  color: var(--uwo-color-text-secondary);
}

.config-bar__toggle {
  box-sizing: border-box;
  display: flex;
  width: 64rpx !important;
  min-width: 64rpx !important;
  max-width: 64rpx !important;
  min-height: 88rpx;
  margin: 0 !important;
  flex: 0 0 64rpx !important;
  align-items: center;
  justify-content: center;
  padding: 0 !important;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--uwo-color-text-secondary);
  overflow: visible;
}

.config-bar__share {
  box-sizing: border-box;
  display: flex;
  min-width: 104rpx;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 var(--uwo-space-2);
  border: 2rpx solid var(--uwo-color-accent-brass);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface-muted);
  color: var(--uwo-color-accent-text);
  font-family: var(--uwo-font-family-body);
  font-size: var(--uwo-font-size-minimum-action);
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.config-bar__share::after {
  border: 0;
}

.config-bar__share:active {
  transform: translateY(2rpx);
  opacity: 0.88;
}

.config-bar__share[disabled] {
  transform: none;
  opacity: 0.58;
}

.config-bar__toggle::after {
  border: 0;
}

.config-bar__toggle-icon {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 auto;
  transform-origin: center;
  transform: scale(3);
}

.config-bar__toggle-icon--expanded {
  transform: scaleX(2.85) scaleY(2.82);
}

.config-bar__content {
  display: flex;
  flex-direction: column;
  gap: var(--uwo-space-3);
  padding: var(--uwo-space-2) 0 var(--uwo-space-2);
  border-top: 2rpx solid var(--uwo-color-border-subtle);
}

.config-bar__list,
.config-bar__action-row,
.config-bar__unclassified,
.config-bar__classify-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--uwo-space-2);
}

.config-bar__management-actions {
  display: grid;
  width: 100%;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--uwo-space-1);
}

.config-bar__management-actions .config-bar__button {
  width: 100%;
  min-height: 88rpx;
  padding-right: var(--uwo-space-1);
  padding-left: var(--uwo-space-1);
  white-space: nowrap;
}

.config-bar__list,
.config-bar__unclassified {
  flex-direction: column;
}

.config-bar__list-row,
.config-bar__unclassified-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--uwo-space-2);
  min-width: 0;
}

.config-bar__list-row .config-bar__button {
  flex: 0 0 auto;
}

.config-bar__exit {
  min-width: 144rpx;
}

.config-bar__list-copy {
  display: flex;
  flex: 1 1 auto;
  align-items: center;
  gap: var(--uwo-space-2);
  min-width: 0;
}

.config-bar__list-name {
  min-width: 0;
  overflow-wrap: anywhere;
  font-size: var(--uwo-font-size-supporting);
}

.config-bar__active-label {
  flex: 0 0 auto;
  color: var(--uwo-color-success);
  font-size: var(--uwo-font-size-minimum-action);
}

.config-bar__message {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--uwo-space-2);
  min-height: 64rpx;
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  text-align: center;
}

.config-bar__message--error {
  color: var(--uwo-color-danger);
}

.config-bar__button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 88rpx;
  margin: 0;
  flex: 1 1 auto;
  padding: var(--uwo-space-2) var(--uwo-space-4);
  border: 2rpx solid var(--uwo-color-border-strong);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface);
  color: var(--uwo-color-text-primary);
  font-family: var(--uwo-font-family-body);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.35;
  text-align: center;
  white-space: normal;
  overflow-wrap: anywhere;
}

.config-bar__button::after {
  border: 0;
}

.config-bar__button--compact {
  min-height: 64rpx;
  padding: var(--uwo-space-1) var(--uwo-space-3);
}

.config-bar__button--danger {
  border-color: var(--uwo-color-danger);
  background: var(--uwo-color-danger);
  color: var(--uwo-color-surface);
}

.config-bar__unclassified {
  padding-top: var(--uwo-space-2);
  border-top: 2rpx solid var(--uwo-color-border-subtle);
}

.config-bar__unclassified-title {
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 600;
}

.config-bar__classify-actions {
  flex: 0 0 auto;
}

.config-bar__classify-actions .config-bar__button {
  flex: 0 1 auto;
}

.config-bar__summary:active {
  opacity: 0.88;
}

.config-bar__toggle:active {
  opacity: 0.88;
  transform: translateY(2rpx);
}

.config-bar__summary:focus {
  outline: 4rpx solid var(--uwo-color-accent-brass);
  outline-offset: 4rpx;
}

.config-bar__button:active {
  transform: translateY(2rpx);
  opacity: 0.88;
}

.config-bar__button[disabled] {
  transform: none;
  opacity: 1;
}

.config-bar__action-row {
  display: flex;
  align-items: stretch;
}
