.config-unsaved-guard__mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  background: var(--uwo-color-ink);
  opacity: 0.36;
}

.config-unsaved-guard__dialog {
  position: fixed;
  top: 50%;
  left: 50%;
  z-index: 201;
  width: 520rpx;
  max-width: calc(100vw - var(--uwo-space-8));
  transform: translate(-50%, -50%);
  background: var(--uwo-color-surface);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
  box-shadow: var(--uwo-shadow-elevated);
}

.config-unsaved-guard__header {
  padding: var(--uwo-space-4) var(--uwo-space-4) var(--uwo-space-3);
  border-bottom: 2rpx solid var(--uwo-color-border-subtle);
}

.config-unsaved-guard__title {
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-section-title);
  font-weight: 700;
}

.config-unsaved-guard__body {
  padding: var(--uwo-space-4);
}

.config-unsaved-guard__text {
  display: block;
  margin-bottom: var(--uwo-space-4);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-body);
  line-height: 1.6;
}

.config-unsaved-guard__actions {
  display: flex;
  flex-direction: column;
  gap: var(--uwo-space-2);
}

.config-unsaved-guard__button {
  width: 100%;
  min-height: 88rpx;
}

/* ── 页面容器 ── */

.fleet-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  color: var(--uwo-color-text-primary);
  background: var(--uwo-color-canvas);
}

.fleet-context {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--uwo-space-3);
  padding: var(--uwo-space-3) var(--uwo-space-4);
  color: var(--uwo-color-text-primary);
  background: var(--uwo-color-surface);
  border-bottom: 1rpx solid var(--uwo-color-border-subtle);
}

.fleet-context__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: var(--uwo-space-1);
}

.fleet-context__eyebrow,
.fleet-context__title,
.fleet-context__count {
  display: block;
  overflow-wrap: anywhere;
}

.fleet-context__eyebrow {
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-supporting);
}

.fleet-context__title {
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 600;
}

.fleet-context__count {
  flex: 0 0 auto;
  max-width: 42%;
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  text-align: right;
}

.fleet-scroll {
  min-height: 0;
  flex: 1;
}

/* ── 面板通用 ── */

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--uwo-space-3);
  margin-bottom: var(--uwo-space-3);
}

.panel-heading__title {
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 700;
}

.panel-heading__hint {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  overflow-wrap: anywhere;
}

.target-panel,
.candidate-panel,
.ban-panel,
.summary-panel {
  margin: 0 var(--uwo-space-4) var(--uwo-space-4);
  padding: var(--uwo-space-4);
  background: var(--uwo-color-surface-muted);
  border: 1rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
}

.ban-panel,
.summary-panel {
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
}

/* ── 目标技能面板 ── */

.target-row {
  display: flex;
  min-height: 64rpx;
  align-items: flex-start;
  gap: var(--uwo-space-2);
  padding: var(--uwo-space-2) 0;
  overflow-wrap: anywhere;
  border-bottom: 1rpx solid var(--uwo-color-border-subtle);
}

.target-row__icon,
.summary-row__icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: var(--uwo-space-2);
  margin-top: var(--uwo-space-1);
  flex: 0 0 auto;
}

.target-row__copy {
  min-width: 0;
  flex: 1;
}

.target-row__name {
  display: block;
  overflow-wrap: anywhere;
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-body);
  white-space: normal;
}

.target-row__desc {
  display: block;
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.target-row__state {
  display: block;
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-supporting);
  overflow-wrap: anywhere;
}

.target-row__right {
  display: flex;
  align-items: center;
  gap: var(--uwo-space-1);
  flex: 0 0 auto;
  margin-left: var(--uwo-space-1);
}

.level-input {
  box-sizing: border-box;
  width: 64rpx;
  min-height: 56rpx;
  padding: var(--uwo-space-1);
  color: var(--uwo-color-surface);
  background: var(--uwo-color-success);
  border: 0;
  border-radius: var(--uwo-radius-control);
  font-size: var(--uwo-font-size-body);
  text-align: center;
}

.target-row__remove {
  display: flex;
  min-height: 56rpx;
  flex: 0 0 auto;
  align-items: center;
  margin: 0;
  padding: 0 var(--uwo-space-1);
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-minimum-action);
  overflow-wrap: anywhere;
  white-space: normal;
}

.target-actions {
  display: flex;
  gap: var(--uwo-space-2);
  margin-top: var(--uwo-space-3);
}

.target-actions .ui-button {
  min-width: 0;
  flex: 1;
  min-height: 88rpx;
  height: auto;
  margin: 0;
  padding: var(--uwo-space-3) var(--uwo-space-4);
  line-height: 1.3;
  font-size: var(--uwo-font-size-body);
  overflow-wrap: anywhere;
}

.target-panel__notice {
  display: block;
  margin-top: var(--uwo-space-3);
  color: var(--uwo-color-warning);
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.tracking-row {
  display: flex;
  min-height: 64rpx;
  align-items: flex-start;
  gap: var(--uwo-space-2);
  padding: var(--uwo-space-2) 0;
  overflow-wrap: anywhere;
  border-bottom: 1rpx solid var(--uwo-color-border-subtle);
}

.tracking-row__icon {
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 auto;
  margin-top: var(--uwo-space-1);
}

.tracking-row__copy {
  min-width: 0;
  flex: 1;
}

.tracking-row__name,
.tracking-row__desc {
  display: block;
  overflow-wrap: anywhere;
}

.tracking-row__name {
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-body);
}

.tracking-row__desc {
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.tracking-row__right {
  display: flex;
  align-items: center;
  gap: var(--uwo-space-1);
  flex: 0 0 auto;
  margin-left: var(--uwo-space-1);
}

/* ── 类型分区 ── */

.zone-section {
  margin: 0 20rpx 18rpx;
}

.zone-section__header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--uwo-space-3) var(--uwo-space-2) var(--uwo-space-2);
  border-bottom: 2rpx solid var(--uwo-color-border-subtle);
}

.zone-section__title {
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 700;
  color: var(--uwo-color-text-primary);
}

.zone-section__meta {
  font-size: var(--uwo-font-size-supporting);
  color: var(--uwo-color-text-secondary);
}

/* ── 航海士头像网格 ── */

.officer-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: var(--uwo-space-2);
  padding: var(--uwo-space-2) 0;
}

.officer-card {
  position: relative;
  box-sizing: border-box;
  min-height: 184rpx;
  padding: var(--uwo-space-2) var(--uwo-space-1);
  overflow: hidden;
  text-align: center;
  background: var(--uwo-color-surface-muted);
  border: 1rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
}

.officer-card--locked {
  background: var(--uwo-color-surface-muted);
  border-color: var(--uwo-color-accent-brass);
  box-shadow: inset 0 0 0 2rpx var(--uwo-color-accent-brass);
}

.officer-card__visuals {
  position: relative;
  display: inline-block;
  width: 80rpx;
  height: 80rpx;
  background: var(--uwo-color-ink);
  border-radius: var(--uwo-radius-control);
}

.officer-card__frame {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--uwo-radius-control);
}

.officer-card__portrait {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--uwo-radius-control);
}

.officer-card__rarity-icon {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 52rpx;
  height: 52rpx;
}

.officer-card__type-icon {
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 4;
  width: 21rpx;
  height: 21rpx;
}

.officer-card__name {
  display: block;
  overflow: hidden;
  margin-top: var(--uwo-space-1);
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--uwo-color-text-primary);
}

.officer-card__ship {
  display: block;
  font-size: var(--uwo-font-size-minimum-action);
  color: var(--uwo-color-text-secondary);
  margin-top: var(--uwo-space-1);
}

.officer-card .officer-action-sheet__trigger {
  margin-top: var(--uwo-space-2);
}

/* ── 排除名单 ── */

.ban-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: var(--uwo-space-2);
  margin-top: var(--uwo-space-2);
}

.ban-card {
  position: relative;
  box-sizing: border-box;
  padding: var(--uwo-space-2) var(--uwo-space-1);
  text-align: center;
  background: var(--uwo-color-surface-muted);
  border: 1rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
}

.ban-card__visuals {
  position: relative;
  display: inline-block;
  width: 64rpx;
  height: 64rpx;
  background: var(--uwo-color-ink);
  border-radius: var(--uwo-radius-control);
}

.ban-card__frame {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--uwo-radius-control);
}

.ban-card__portrait {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--uwo-radius-control);
}

.ban-card__rarity-icon {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 42rpx;
  height: 42rpx;
}

.ban-card__type-icon {
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 4;
  width: 16rpx;
  height: 16rpx;
}

.ban-card__name {
  display: block;
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.3;
  overflow-wrap: anywhere;
  white-space: normal;
}

.ban-card__remove {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-danger);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.3;
  overflow-wrap: anywhere;
  white-space: normal;
}

/* ── 技能累计 ── */

.summary-row {
  display: grid;
  grid-template-columns: 42rpx minmax(0, 1fr) auto;
  gap: var(--uwo-space-2);
  align-items: center;
  padding: var(--uwo-space-2) 0;
  border-bottom: 1rpx solid var(--uwo-color-border-subtle);
}

.summary-row__icon {
  margin-right: 0;
}

.summary-row__copy {
  min-width: 0;
}

.summary-row__name {
  display: block;
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-body);
  overflow-wrap: anywhere;
  white-space: normal;
}

.summary-row__level {
  display: block;
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.summary-row__contributors {
  grid-column: 2 / 4;
  height: 62rpx;
  width: 100%;
}

.summary-row__contributors-content {
  display: flex;
  align-items: center;
  min-width: max-content;
  height: 62rpx;
}

.contributor-avatar {
  width: 48rpx;
  height: 48rpx;
  margin-right: var(--uwo-space-1);
}

.contributors-empty {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

/* ── 船标签页 ── */

.ship-tabs {
  width: 100%;
  background: var(--uwo-color-surface-muted);
  border-bottom: 1rpx solid var(--uwo-color-border-subtle);
}

.ship-tabs__content {
  display: flex;
  width: 1120rpx;
  min-width: 1120rpx;
}

.ship-tab {
  box-sizing: border-box;
  width: 160rpx;
  padding: var(--uwo-space-4) var(--uwo-space-2) var(--uwo-space-3);
  color: var(--uwo-color-text-secondary);
  text-align: center;
}

.ship-tab--active {
  color: var(--uwo-color-text-primary);
  background: var(--uwo-color-surface);
  border-bottom: 5rpx solid var(--uwo-color-accent-brass);
}

.ship-tab__label,
.ship-tab__meta {
  display: block;
}

.ship-tab__label {
  font-size: var(--uwo-font-size-body);
  font-weight: 700;
}

.ship-tab__meta {
  margin-top: var(--uwo-space-1);
  font-size: var(--uwo-font-size-minimum-action);
}

/* ── 船编辑区 ── */

.ship-editor {
  padding-bottom: var(--uwo-space-12);
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--uwo-space-6) var(--uwo-space-6) var(--uwo-space-4);
}

.section-heading__title {
  display: block;
  font-size: var(--uwo-font-size-section-title);
  font-weight: 700;
}

.section-heading__meta {
  display: block;
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.section-heading__status {
  display: block;
  padding: var(--uwo-space-2) var(--uwo-space-3);
  color: var(--uwo-color-surface);
  background: var(--uwo-color-success);
  border-radius: var(--uwo-radius-control);
  font-size: var(--uwo-font-size-supporting);
}

/* ── 船位网格 ── */

.slot-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: var(--uwo-space-2);
  padding: 0 var(--uwo-space-4) var(--uwo-space-2);
}

.officer-slot {
  position: relative;
  box-sizing: border-box;
  min-height: 180rpx;
  padding: var(--uwo-space-2) 0;
  overflow: hidden;
  text-align: center;
  background: var(--uwo-color-surface-muted);
  border: 1rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
}

.officer-slot--filled {
  background: var(--uwo-color-surface);
}

.officer-slot__number {
  position: absolute;
  top: 3rpx;
  left: 4rpx;
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
}

.officer-slot__visuals {
  position: relative;
  display: inline-block;
  width: 64rpx;
  height: 64rpx;
  background: var(--uwo-color-ink);
  border-radius: var(--uwo-radius-control);
}

.officer-slot__frame {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--uwo-radius-control);
}

.officer-slot__portrait {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--uwo-radius-control);
}

.officer-slot__rarity-icon {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 42rpx;
  height: 42rpx;
}

.officer-slot__type-icon {
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 4;
  width: 17rpx;
  height: 17rpx;
}

.officer-slot__name,
.officer-slot__empty {
  display: block;
  overflow: hidden;
  margin-top: var(--uwo-space-1);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.officer-slot__empty {
  padding-top: 33rpx;
  color: var(--uwo-color-text-secondary);
}

/* ── 候选航海士面板 ── */

.candidate-row {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  gap: var(--uwo-space-2);
  padding: var(--uwo-space-3) 0;
  overflow-wrap: anywhere;
  border-bottom: 1rpx solid var(--uwo-color-border-subtle);
}

.candidate-row__visuals {
  position: relative;
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  margin-right: var(--uwo-space-3);
  background: var(--uwo-color-ink);
  border-radius: var(--uwo-radius-control);
}

.candidate-row__frame {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  width: 54rpx;
  height: 54rpx;
  border-radius: var(--uwo-radius-control);
}

.candidate-row__portrait {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 54rpx;
  height: 54rpx;
  border-radius: var(--uwo-radius-control);
}

.candidate-row__rarity-icon {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 35rpx;
  height: 35rpx;
}

.candidate-row__type-icon {
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 4;
  width: 14rpx;
  height: 14rpx;
}

.candidate-row__copy {
  min-width: 0;
  flex: 1;
}

.candidate-row__name {
  display: block;
  overflow-wrap: anywhere;
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-body);
  white-space: normal;
}

.candidate-row__meta,
.candidate-row__status {
  display: block;
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  overflow-wrap: anywhere;
  white-space: normal;
}

.candidate-row__status {
  max-width: 34%;
  margin-left: var(--uwo-space-2);
  text-align: right;
}
