/* ── 配置管理栏（复用战斗舰队样式） ── */

.config-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx;
  background: #2a2b25;
  border-bottom: 1rpx solid #3d3e38;
  flex: 0 0 auto;
}

.config-bar__info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  flex: 1;
  overflow: hidden;
}

.config-bar__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #e0d8c0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.config-bar__status {
  font-size: 20rpx;
  color: #7a7a6e;
}

.config-bar__status--saved {
  color: #5b8c3e;
}
.config-bar__status--unsaved {
  color: #d48c2c;
}

.config-bar__actions {
  flex: 0 0 auto;
  margin-left: 16rpx;
}

.config-bar__login {
  font-size: 24rpx;
  color: #d48c2c;
  padding: 8rpx 16rpx;
  border: 1rpx solid #d48c2c;
  border-radius: 8rpx;
}

.config-bar__menu-btn {
  font-size: 32rpx;
  padding: 8rpx 12rpx;
  color: #e0d8c0;
}

/* ── 配置管理菜单 ── */

.config-menu {
  position: absolute;
  top: 160rpx;
  right: 16rpx;
  z-index: 100;
  background: #2f302b;
  border: 1rpx solid #4a4b45;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
  padding: 8rpx 0;
  min-width: 200rpx;
}

.config-menu__item {
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #d0c8b0;
  border-bottom: 1rpx solid #3a3b35;
}

.config-menu__item:last-child {
  border-bottom: none;
}
.config-menu__item--danger {
  color: #e07060;
}

/* ── 弹窗（复用战斗舰队样式） ── */

.config-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.config-modal {
  background: #2f302b;
  border-radius: 16rpx;
  width: 600rpx;
  max-height: 80vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.config-modal--small {
  width: 520rpx;
}

.config-modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #3d3e38;
  flex: 0 0 auto;
}

.config-modal__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #e0d8c0;
}

.config-modal__close {
  font-size: 28rpx;
  color: #8a8a7e;
  padding: 4rpx;
}

.config-modal__body {
  padding: 24rpx;
  flex: 1;
  overflow-y: auto;
}

.config-modal__text {
  font-size: 26rpx;
  color: #c0b890;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.config-modal__input {
  width: 100%;
  padding: 16rpx;
  background: #3a3b35;
  border: 1rpx solid #4a4b45;
  border-radius: 8rpx;
  color: #e0d8c0;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.config-modal__actions {
  display: flex;
  gap: 16rpx;
}

.config-modal__actions--stack {
  flex-direction: column;
}

.config-modal__btn {
  flex: 1;
  padding: 16rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  text-align: center;
  border: none;
}

.config-modal__btn--confirm {
  background: #4a6b2e;
  color: #e0d8c0;
}
.config-modal__btn--cancel {
  background: #3a3b35;
  color: #a0a090;
}
.config-modal__btn--danger {
  background: #6b3a2e;
  color: #e0c8c0;
}

/* ── 配置列表 ── */

.config-modal__list {
  flex: 1;
  overflow-y: auto;
}

.config-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #3a3b35;
}

.config-item:last-child {
  border-bottom: none;
}
.config-item--active {
  background: #3a3b35;
}

.config-item__info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  overflow: hidden;
}

.config-item__name {
  font-size: 28rpx;
  color: #e0d8c0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.config-item__meta {
  font-size: 20rpx;
  color: #7a7a6e;
}

.config-item__current {
  font-size: 22rpx;
  color: #5b8c3e;
  flex: 0 0 auto;
  margin-left: 16rpx;
}

.config-modal__empty {
  padding: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #7a7a6e;
}

/* ── 页面容器 ── */

.fleet-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  color: #292a26;
  background: #ded7c7;
}

.fleet-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 28rpx 24rpx 22rpx;
  color: #e8d5a3;
  background: #2f302b;
}

.fleet-header__eyebrow,
.fleet-header__title,
.fleet-header__count {
  display: block;
}

.fleet-header__eyebrow {
  color: #c4a45a;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.fleet-header__title {
  margin-top: 6rpx;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.fleet-header__count {
  padding-bottom: 5rpx;
  color: #ddd6c4;
  font-size: 22rpx;
}

.fleet-scroll {
  min-height: 0;
  flex: 1;
}

/* ── 面板通用 ── */

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.panel-heading__title {
  font-size: 26rpx;
  font-weight: 700;
}

.panel-heading__hint {
  color: #756b59;
  font-size: 21rpx;
}

.target-panel,
.skill-selector,
.ban-panel,
.summary-panel {
  margin: 0 20rpx 18rpx;
  padding: 18rpx;
  background: #e8dfce;
  border: 1rpx solid #c4b99a;
  border-radius: 8rpx;
}

/* ── 目标技能面板 ── */

.target-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #d4cbb4;
}

.target-row__icon,
.skill-option__icon,
.summary-row__icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: 10rpx;
  margin-top: 2rpx;
  flex: 0 0 auto;
}

.target-row__copy {
  min-width: 0;
  flex: 1;
}

.target-row__name {
  display: block;
  overflow: hidden;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.target-row__desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 4rpx;
  color: #756b59;
  font-size: 20rpx;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.target-row__right {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  margin-left: 8rpx;
}

.level-input {
  box-sizing: border-box;
  width: 84rpx;
  margin: 0 8rpx;
  padding: 6rpx 10rpx;
  color: #f0e4c4;
  background: #596257;
  border: 0;
  border-radius: 5rpx;
  font-size: 21rpx;
  text-align: center;
}

.target-row__remove {
  padding: 7rpx 0 7rpx 8rpx;
  font-size: 20rpx;
  color: #8b3a3a;
  white-space: nowrap;
}

.target-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
}

button.subtle-button,
button.primary-button {
  height: 68rpx;
  margin: 0;
  padding: 0 20rpx;
  line-height: 68rpx;
  font-size: 23rpx;
}

button.subtle-button {
  color: #596257;
  background: #d4cbb4;
}

button.primary-button {
  color: #f0e4c4;
  background: #2f302b;
}

/* ── 类型分区 ── */

.zone-section {
  margin: 0 20rpx 18rpx;
}

.zone-section__header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 14rpx 8rpx 10rpx;
  border-bottom: 2rpx solid #c4b99a;
}

.zone-section__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #3d3d35;
}

.zone-section__meta {
  font-size: 20rpx;
  color: #756b59;
}

/* ── 航海士头像网格 ── */

.officer-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8rpx;
  padding: 10rpx 0;
}

.officer-card {
  position: relative;
  box-sizing: border-box;
  min-height: 184rpx;
  padding: 8rpx 4rpx 68rpx;
  overflow: hidden;
  text-align: center;
  background: #e8dfce;
  border: 1rpx solid #c4b99a;
  border-radius: 8rpx;
}

.officer-card--locked {
  background: #f0e8c8;
  border-color: #b99552;
  box-shadow: inset 0 0 0 2rpx #b99552;
}

.officer-card__visuals {
  position: relative;
  display: inline-block;
  width: 80rpx;
  height: 80rpx;
  background: #2f302b;
  border-radius: 8rpx;
}

.officer-card__frame {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
}

.officer-card__portrait {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
}

.officer-card__rarity-icon {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 52rpx;
  height: 52rpx;
}

.officer-card__type-icon {
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 4;
  width: 21rpx;
  height: 21rpx;
}

.officer-card__name {
  display: block;
  overflow: hidden;
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #3d3d35;
}

.officer-card__ship {
  display: block;
  font-size: 14rpx;
  color: #756b59;
  margin-top: 1rpx;
}

.officer-card__actions {
  position: absolute;
  right: 3rpx;
  bottom: 3rpx;
  left: 3rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rpx;
  min-height: 56rpx;
}

.card-action {
  box-sizing: border-box;
  display: flex;
  min-width: 0;
  min-height: 56rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2rpx 0;
  overflow: hidden;
  color: #596257;
  background: #e8dfce;
  border-radius: 5rpx;
  font-size: 12rpx;
  line-height: 1.1;
  white-space: nowrap;
}

.card-action:active {
  background: #c4b99a;
}

.card-action--danger {
  color: #8b3a3a;
  background: #ead2c8;
}

.card-action--danger:active {
  background: #d7b5a9;
}

.card-action__glyph,
.card-action__label {
  display: block;
}

.card-action__glyph {
  font-size: 22rpx;
  line-height: 1;
}

.card-action__label {
  margin-top: 2rpx;
  font-size: 12rpx;
  line-height: 1.1;
}

/* ── 排除名单 ── */

.ban-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8rpx;
  margin-top: 8rpx;
}

.ban-card {
  position: relative;
  box-sizing: border-box;
  padding: 8rpx 4rpx;
  text-align: center;
  background: #d4cbb4;
  border: 1rpx solid #c4b99a;
  border-radius: 8rpx;
}

.ban-card__visuals {
  position: relative;
  display: inline-block;
  width: 64rpx;
  height: 64rpx;
  background: #2f302b;
  border-radius: 7rpx;
}

.ban-card__frame {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  width: 64rpx;
  height: 64rpx;
  border-radius: 7rpx;
}

.ban-card__portrait {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 64rpx;
  height: 64rpx;
  border-radius: 7rpx;
}

.ban-card__rarity-icon {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 42rpx;
  height: 42rpx;
}

.ban-card__type-icon {
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 4;
  width: 16rpx;
  height: 16rpx;
}

.ban-card__name {
  display: block;
  overflow: hidden;
  margin-top: 4rpx;
  font-size: 16rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #3d3d35;
}

.ban-card__remove {
  display: block;
  font-size: 16rpx;
  color: #8b3a3a;
  margin-top: 2rpx;
}

/* ── 技能选择器 ── */

.skill-search {
  box-sizing: border-box;
  width: 100%;
  margin: 12rpx 0;
  padding: 10rpx 14rpx;
  color: #292a26;
  background: #f5efe0;
  border: 1rpx solid #c4b99a;
  border-radius: 6rpx;
  font-size: 23rpx;
}

.skill-options {
  max-height: 330rpx;
}

.skill-option {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #d4cbb4;
}

.skill-option--active {
  color: #8b3a3a;
}

.skill-option__copy {
  min-width: 0;
  flex: 1;
}

.skill-option__name {
  overflow: hidden;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.skill-option__meta {
  display: block;
  margin-top: 3rpx;
  color: #756b59;
  font-size: 19rpx;
}

.skill-option__description {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 4rpx;
  color: #9b8b6d;
  font-size: 18rpx;
  line-height: 1.3;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.skill-option__select {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  margin-left: 10rpx;
  padding: 8rpx 10rpx;
  color: #f0e4c4;
  background: #596257;
  border-radius: 6rpx;
  font-size: 19rpx;
  line-height: 1.1;
}

.skill-option__select:active {
  background: #2f302b;
}

/* ── 技能累计 ── */

.summary-row {
  display: grid;
  grid-template-columns: 42rpx minmax(0, 1fr) auto;
  gap: 6rpx 8rpx;
  align-items: center;
  padding: 7rpx 0;
  border-bottom: 1rpx solid #d4cbb4;
}

.summary-row__icon {
  margin-right: 0;
}

.summary-row__copy {
  min-width: 0;
}

.summary-row__name {
  display: block;
  overflow: hidden;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-row__level {
  display: block;
  margin-top: 3rpx;
  color: #756b59;
  font-size: 19rpx;
}

.summary-row__state {
  color: #8b3a3a;
  font-size: 19rpx;
}

.summary-row__state--ok {
  color: #596257;
}

.summary-row__contributors {
  grid-column: 2 / 4;
  height: 62rpx;
  width: 100%;
}

.summary-row__contributors-content {
  display: flex;
  align-items: center;
  min-width: max-content;
  height: 62rpx;
}

.contributor-avatar {
  width: 48rpx;
  height: 48rpx;
  margin-right: 6rpx;
}

.contributors-empty,
.inline-empty {
  color: #9b8b6d;
  font-size: 20rpx;
}

.inline-empty {
  padding: 18rpx 0 6rpx;
  text-align: center;
}
