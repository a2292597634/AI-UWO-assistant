/* ── 弹窗（复用战斗舰队样式） ── */

.config-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.config-modal {
  background: #2f302b;
  border-radius: 16rpx;
  width: 600rpx;
  max-height: 80vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.config-modal--small {
  width: 520rpx;
}

.config-modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #3d3e38;
  flex: 0 0 auto;
}

.config-modal__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #e0d8c0;
}

.config-modal__close {
  font-size: 28rpx;
  color: #8a8a7e;
  padding: 4rpx;
}

.config-modal__body {
  padding: 24rpx;
  flex: 1;
  overflow-y: auto;
}

.config-modal__text {
  font-size: 26rpx;
  color: #c0b890;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.config-modal__input {
  width: 100%;
  padding: 16rpx;
  background: #3a3b35;
  border: 1rpx solid #4a4b45;
  border-radius: 8rpx;
  color: #e0d8c0;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.config-modal__actions {
  display: flex;
  gap: 16rpx;
}

.config-modal__actions--stack {
  flex-direction: column;
}

.config-modal__btn {
  flex: 1;
  padding: 16rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  text-align: center;
  border: none;
}

.config-modal__btn--confirm {
  background: #4a6b2e;
  color: #e0d8c0;
}
.config-modal__btn--cancel {
  background: #3a3b35;
  color: #a0a090;
}
.config-modal__btn--danger {
  background: #6b3a2e;
  color: #e0c8c0;
}

/* ── 配置列表 ── */

.config-modal__list {
  flex: 1;
  overflow-y: auto;
}

.config-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #3a3b35;
}

.config-item:last-child {
  border-bottom: none;
}
.config-item--active {
  background: #3a3b35;
}

.config-item__info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  overflow: hidden;
}

.config-item__name {
  font-size: 28rpx;
  color: #e0d8c0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.config-item__meta {
  font-size: 20rpx;
  color: #7a7a6e;
}

.config-item__current {
  font-size: 22rpx;
  color: #5b8c3e;
  flex: 0 0 auto;
  margin-left: 16rpx;
}

.config-modal__empty {
  padding: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #7a7a6e;
}

/* ── 页面容器 ── */

.fleet-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  color: var(--uwo-color-text-primary);
  background: var(--uwo-color-canvas);
}

.fleet-context {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--uwo-space-3);
  padding: var(--uwo-space-3) var(--uwo-space-4);
  color: var(--uwo-color-text-primary);
  background: var(--uwo-color-surface);
  border-bottom: 1rpx solid var(--uwo-color-border-subtle);
}

.fleet-context__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: var(--uwo-space-1);
}

.fleet-context__eyebrow,
.fleet-context__title,
.fleet-context__count {
  display: block;
  overflow-wrap: anywhere;
}

.fleet-context__eyebrow {
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-supporting);
}

.fleet-context__title {
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 600;
}

.fleet-context__count {
  flex: 0 0 auto;
  max-width: 42%;
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  text-align: right;
}

.fleet-scroll {
  min-height: 0;
  flex: 1;
}

/* ── 面板通用 ── */

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--uwo-space-3);
  margin-bottom: var(--uwo-space-3);
}

.panel-heading__title {
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 700;
}

.panel-heading__hint {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  overflow-wrap: anywhere;
}

.target-panel,
.candidate-panel,
.ban-panel,
.summary-panel {
  margin: 0 var(--uwo-space-4) var(--uwo-space-4);
  padding: var(--uwo-space-4);
  background: var(--uwo-color-surface-muted);
  border: 1rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
}

.ban-panel,
.summary-panel {
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
}

/* ── 目标技能面板 ── */

.target-row {
  display: flex;
  min-height: 88rpx;
  align-items: flex-start;
  gap: var(--uwo-space-2);
  padding: var(--uwo-space-3) 0;
  overflow-wrap: anywhere;
  border-bottom: 1rpx solid var(--uwo-color-border-subtle);
}

.target-row__icon,
.summary-row__icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: 10rpx;
  margin-top: 2rpx;
  flex: 0 0 auto;
}

.target-row__copy {
  min-width: 0;
  flex: 1;
}

.target-row__name {
  display: block;
  overflow-wrap: anywhere;
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-body);
  white-space: normal;
}

.target-row__desc {
  display: block;
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.target-row__state {
  display: block;
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-supporting);
  overflow-wrap: anywhere;
}

.target-row__right {
  display: flex;
  align-items: center;
  gap: var(--uwo-space-2);
  flex: 0 0 auto;
  margin-left: var(--uwo-space-2);
}

.level-input {
  box-sizing: border-box;
  width: 84rpx;
  min-height: 88rpx;
  padding: var(--uwo-space-2);
  color: var(--uwo-color-surface);
  background: var(--uwo-color-success);
  border: 0;
  border-radius: var(--uwo-radius-control);
  font-size: var(--uwo-font-size-body);
  text-align: center;
}

.target-row__remove {
  display: flex;
  min-height: 88rpx;
  flex: 0 0 auto;
  align-items: center;
  margin: 0;
  padding: 0 var(--uwo-space-2);
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-minimum-action);
  overflow-wrap: anywhere;
  white-space: normal;
}

.target-actions {
  display: flex;
  gap: var(--uwo-space-2);
  margin-top: var(--uwo-space-3);
}

.target-actions .ui-button {
  min-width: 0;
  flex: 1;
  min-height: 88rpx;
  height: auto;
  margin: 0;
  padding: var(--uwo-space-3) var(--uwo-space-4);
  line-height: 1.3;
  font-size: var(--uwo-font-size-body);
  overflow-wrap: anywhere;
}

.target-panel__notice {
  display: block;
  margin-top: var(--uwo-space-3);
  color: var(--uwo-color-warning);
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.tracking-row {
  display: flex;
  min-height: 88rpx;
  align-items: flex-start;
  gap: var(--uwo-space-2);
  padding: var(--uwo-space-3) 0;
  overflow-wrap: anywhere;
  border-bottom: 1rpx solid var(--uwo-color-border-subtle);
}

.tracking-row__icon {
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 auto;
  margin-top: var(--uwo-space-1);
}

.tracking-row__copy {
  min-width: 0;
  flex: 1;
}

.tracking-row__name,
.tracking-row__desc,
.tracking-row__state {
  display: block;
  overflow-wrap: anywhere;
}

.tracking-row__name {
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-body);
}

.tracking-row__desc,
.tracking-row__state {
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.tracking-row__state {
  color: var(--uwo-color-accent-text);
}

.tracking-row__right {
  display: flex;
  align-items: center;
  gap: var(--uwo-space-2);
  flex: 0 0 auto;
  margin-left: var(--uwo-space-2);
}

/* ── 类型分区 ── */

.zone-section {
  margin: 0 20rpx 18rpx;
}

.zone-section__header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 14rpx 8rpx 10rpx;
  border-bottom: 2rpx solid #c4b99a;
}

.zone-section__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #3d3d35;
}

.zone-section__meta {
  font-size: 20rpx;
  color: #756b59;
}

/* ── 航海士头像网格 ── */

.officer-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8rpx;
  padding: 10rpx 0;
}

.officer-card {
  position: relative;
  box-sizing: border-box;
  min-height: 184rpx;
  padding: 8rpx 4rpx;
  overflow: hidden;
  text-align: center;
  background: #e8dfce;
  border: 1rpx solid #c4b99a;
  border-radius: 8rpx;
}

.officer-card--locked {
  background: #f0e8c8;
  border-color: #b99552;
  box-shadow: inset 0 0 0 2rpx #b99552;
}

.officer-card__visuals {
  position: relative;
  display: inline-block;
  width: 80rpx;
  height: 80rpx;
  background: #2f302b;
  border-radius: 8rpx;
}

.officer-card__frame {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
}

.officer-card__portrait {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
}

.officer-card__rarity-icon {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 52rpx;
  height: 52rpx;
}

.officer-card__type-icon {
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 4;
  width: 21rpx;
  height: 21rpx;
}

.officer-card__name {
  display: block;
  overflow: hidden;
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #3d3d35;
}

.officer-card__ship {
  display: block;
  font-size: 14rpx;
  color: #756b59;
  margin-top: 1rpx;
}

/* ── 排除名单 ── */

.ban-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8rpx;
  margin-top: 8rpx;
}

.ban-card {
  position: relative;
  box-sizing: border-box;
  padding: 8rpx 4rpx;
  text-align: center;
  background: #d4cbb4;
  border: 1rpx solid #c4b99a;
  border-radius: 8rpx;
}

.ban-card__visuals {
  position: relative;
  display: inline-block;
  width: 64rpx;
  height: 64rpx;
  background: #2f302b;
  border-radius: 7rpx;
}

.ban-card__frame {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  width: 64rpx;
  height: 64rpx;
  border-radius: 7rpx;
}

.ban-card__portrait {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 64rpx;
  height: 64rpx;
  border-radius: 7rpx;
}

.ban-card__rarity-icon {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 42rpx;
  height: 42rpx;
}

.ban-card__type-icon {
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 4;
  width: 16rpx;
  height: 16rpx;
}

.ban-card__name {
  display: block;
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.3;
  overflow-wrap: anywhere;
  white-space: normal;
}

.ban-card__remove {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-danger);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.3;
  overflow-wrap: anywhere;
  white-space: normal;
}

/* ── 技能累计 ── */

.summary-row {
  display: grid;
  grid-template-columns: 42rpx minmax(0, 1fr) auto;
  gap: 6rpx 8rpx;
  align-items: center;
  padding: 7rpx 0;
  border-bottom: 1rpx solid #d4cbb4;
}

.summary-row__icon {
  margin-right: 0;
}

.summary-row__copy {
  min-width: 0;
}

.summary-row__name {
  display: block;
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-body);
  overflow-wrap: anywhere;
  white-space: normal;
}

.summary-row__level {
  display: block;
  margin-top: 3rpx;
  color: #756b59;
  font-size: 19rpx;
}

.summary-row__contributors {
  grid-column: 2 / 4;
  height: 62rpx;
  width: 100%;
}

.summary-row__contributors-content {
  display: flex;
  align-items: center;
  min-width: max-content;
  height: 62rpx;
}

.contributor-avatar {
  width: 48rpx;
  height: 48rpx;
  margin-right: 6rpx;
}

.contributors-empty {
  color: #9b8b6d;
  font-size: 20rpx;
}

/* ── 船标签页 ── */

.ship-tabs {
  width: 100%;
  background: #e8dfce;
  border-bottom: 1rpx solid #c4b99a;
}

.ship-tabs__content {
  display: flex;
  width: 1120rpx;
  min-width: 1120rpx;
}

.ship-tab {
  box-sizing: border-box;
  width: 160rpx;
  padding: 16rpx 8rpx 14rpx;
  color: #756b59;
  text-align: center;
}

.ship-tab--active {
  color: #292a26;
  background: #d4cbb4;
  border-bottom: 5rpx solid #b99552;
}

.ship-tab__label,
.ship-tab__meta {
  display: block;
}

.ship-tab__label {
  font-size: 25rpx;
  font-weight: 700;
}

.ship-tab__meta {
  margin-top: 4rpx;
  font-size: 18rpx;
}

/* ── 船编辑区 ── */

.ship-editor {
  padding-bottom: 48rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 16rpx;
}

.section-heading__title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.section-heading__meta {
  display: block;
  margin-top: 5rpx;
  color: #756b59;
  font-size: 21rpx;
}

.section-heading__status {
  display: block;
  padding: 8rpx 12rpx;
  color: #f0e4c4;
  background: #596257;
  border-radius: 6rpx;
  font-size: 21rpx;
}

/* ── 船位网格 ── */

.slot-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 6rpx;
  padding: 0 14rpx 10rpx;
}

.officer-slot {
  position: relative;
  box-sizing: border-box;
  min-height: 180rpx;
  padding: 10rpx 2rpx 72rpx;
  overflow: hidden;
  text-align: center;
  background: #e8dfce;
  border: 1rpx solid #c4b99a;
  border-radius: 8rpx;
}

.officer-slot--filled {
  background: #d4cbb4;
}

.officer-slot__number {
  position: absolute;
  top: 3rpx;
  left: 4rpx;
  color: #9b8b6d;
  font-size: 12rpx;
}

.officer-slot__visuals {
  position: relative;
  display: inline-block;
  width: 64rpx;
  height: 64rpx;
  background: #2f302b;
  border-radius: 8rpx;
}

.officer-slot__frame {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
}

.officer-slot__portrait {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
}

.officer-slot__rarity-icon {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 42rpx;
  height: 42rpx;
}

.officer-slot__type-icon {
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 4;
  width: 17rpx;
  height: 17rpx;
}

.officer-slot__name,
.officer-slot__empty {
  display: block;
  overflow: hidden;
  margin-top: 2rpx;
  font-size: 14rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.officer-slot__empty {
  padding-top: 33rpx;
  color: #a2967d;
}

/* ── 船位操作按钮 ── */

.officer-slot__actions {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  left: 4rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 3rpx;
  min-height: 64rpx;
}

.slot-action {
  box-sizing: border-box;
  display: flex;
  min-width: 0;
  min-height: 64rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rpx 0;
  overflow: hidden;
  color: #596257;
  background: #e8dfce;
  border-radius: 5rpx;
  font-size: 12rpx;
  line-height: 1.1;
  white-space: nowrap;
}

.slot-action:active {
  background: #c4b99a;
}

.slot-action--danger {
  color: #8b3a3a;
  background: #ead2c8;
}

.slot-action--danger:active {
  background: #d7b5a9;
}

.slot-action__glyph,
.slot-action__label {
  display: block;
}

.slot-action__glyph {
  font-size: 24rpx;
  line-height: 1;
}

.slot-action__label {
  margin-top: 2rpx;
  font-size: 12rpx;
  line-height: 1.1;
}

/* ── 候选航海士面板 ── */

.candidate-row {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  gap: var(--uwo-space-2);
  padding: var(--uwo-space-3) 0;
  overflow-wrap: anywhere;
  border-bottom: 1rpx solid var(--uwo-color-border-subtle);
}

.candidate-row__visuals {
  position: relative;
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  margin-right: 12rpx;
  background: #2f302b;
  border-radius: 7rpx;
}

.candidate-row__frame {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  width: 54rpx;
  height: 54rpx;
  border-radius: 7rpx;
}

.candidate-row__portrait {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 54rpx;
  height: 54rpx;
  border-radius: 7rpx;
}

.candidate-row__rarity-icon {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 35rpx;
  height: 35rpx;
}

.candidate-row__type-icon {
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 4;
  width: 14rpx;
  height: 14rpx;
}

.candidate-row__copy {
  min-width: 0;
  flex: 1;
}

.candidate-row__name {
  display: block;
  overflow-wrap: anywhere;
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-body);
  white-space: normal;
}

.candidate-row__meta,
.candidate-row__status {
  display: block;
  margin-top: var(--uwo-space-1);
