.report-page {
  height: 100vh;
  color: var(--uwo-color-text-primary);
  background: var(--uwo-color-canvas);
}

.report-page__content {
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.report-header,
.officer-section,
.report-form,
.report-complete {
  width: auto;
  max-width: 820rpx;
  margin-right: var(--uwo-space-4);
  margin-left: var(--uwo-space-4);
}

.report-header {
  padding: var(--uwo-space-8) 0 var(--uwo-space-6);
}

.report-header__title,
.report-header__hint,
.report-header__entry-title,
.report-header__entry-hint,
.officer-candidate__name,
.officer-candidate__meta,
.officer-identity__name,
.officer-identity__meta,
.officer-picker__status,
.report-complete__title,
.report-complete__copy,
.report-complete__number-label,
.report-complete__number-value {
  display: block;
  overflow-wrap: anywhere;
}

.report-header__title {
  font-size: var(--uwo-font-size-page-title);
  font-weight: 700;
}

.report-header__hint {
  margin-top: var(--uwo-space-2);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.5;
}

.report-header__entry {
  display: flex !important;
  align-items: center;
  justify-content: space-between;
  gap: var(--uwo-space-4);
  width: 100% !important;
  max-width: none;
  min-height: 88rpx;
  margin: var(--uwo-space-6) 0 0;
  padding: var(--uwo-space-3) var(--uwo-space-4);
  color: var(--uwo-color-text-primary);
  background: var(--uwo-color-surface);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
  text-align: left;
}

.report-header__entry-copy {
  min-width: 0;
  flex: 1;
}

.report-header__entry-title {
  font-size: var(--uwo-font-size-body);
  font-weight: 600;
}

.report-header__entry-hint {
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
}

.report-header__entry-arrow {
  flex: none;
  color: var(--uwo-color-accent-text);
  font-size: 40rpx;
  line-height: 1;
}

.officer-picker,
.officer-identity,
.report-form,
.report-complete {
  background: var(--uwo-color-surface);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
}

.officer-picker {
  padding: var(--uwo-space-6);
}

.officer-picker__heading,
.field-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--uwo-space-4);
  margin-bottom: var(--uwo-space-3);
}

.officer-picker__title,
.field-heading__title {
  min-width: 0;
  font-size: var(--uwo-font-size-body);
  font-weight: 600;
  overflow-wrap: anywhere;
}

.officer-picker__meta,
.field-heading__meta,
.officer-picker__status {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
}

.officer-picker__meta,
.field-heading__meta {
  flex: none;
}

.officer-picker__search {
  width: 100%;
  min-height: 88rpx;
  padding: 0 var(--uwo-space-4);
  color: var(--uwo-color-text-primary);
  background: var(--uwo-color-surface-muted);
  border: 2rpx solid var(--uwo-color-border-strong);
  border-radius: var(--uwo-radius-control);
  font-size: var(--uwo-font-size-body);
}

.officer-candidates {
  margin-top: var(--uwo-space-3);
  overflow: hidden;
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
}

.officer-candidate {
  display: flex;
  align-items: center;
  gap: var(--uwo-space-4);
  min-height: 112rpx;
  padding: var(--uwo-space-3) var(--uwo-space-4);
  color: var(--uwo-color-text-primary);
  background: var(--uwo-color-surface);
  border: 0;
  text-align: left;
}

.officer-candidate + .officer-candidate {
  border-top: 2rpx solid var(--uwo-color-border-subtle);
}

.officer-candidate__portrait-wrap,
.officer-identity__portrait-wrap {
  position: relative;
  flex: none;
}

.officer-candidate__portrait-wrap,
.officer-candidate__portrait-layer,
.officer-candidate__portrait-fallback {
  width: 80rpx;
  height: 80rpx;
}

.officer-candidate__portrait-layer,
.officer-identity__portrait-layer {
  position: absolute;
  display: block;
  border-radius: var(--uwo-radius-control);
}

.officer-candidate__portrait-layer--frame,
.officer-identity__portrait-layer--frame {
  inset: 0;
  z-index: 1;
}

.officer-candidate__portrait-layer--portrait {
  top: 4rpx;
  left: 4rpx;
  z-index: 2;
  width: 72rpx;
  height: 72rpx;
}

.officer-candidate__portrait-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  background: var(--uwo-color-surface-muted);
  border-radius: var(--uwo-radius-control);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.2;
  overflow-wrap: anywhere;
  text-align: center;
}

.officer-candidate__rarity-icon,
.officer-identity__rarity-icon {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  z-index: 3;
  width: 40rpx;
  height: 40rpx;
}

.officer-candidate__body {
  min-width: 0;
  flex: 1;
}

.officer-candidate__name {
  font-size: var(--uwo-font-size-body);
  font-weight: 600;
  line-height: 1.35;
}

.officer-candidate__meta {
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.35;
}

.officer-picker__status {
  display: block;
  margin-top: var(--uwo-space-3);
}

.officer-identity {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: var(--uwo-space-4);
  padding: var(--uwo-space-4);
}

.officer-identity__portrait-wrap,
.officer-identity__portrait-layer,
.officer-identity__portrait-fallback {
  width: 144rpx;
  height: 144rpx;
}

.officer-identity__portrait-layer--portrait {
  top: 6rpx;
  left: 6rpx;
  z-index: 2;
  width: 132rpx;
  height: 132rpx;
}

.officer-identity__portrait-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--uwo-space-2);
  color: var(--uwo-color-text-secondary);
  background: var(--uwo-color-surface-muted);
  border-radius: var(--uwo-radius-control);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.2;
  overflow-wrap: anywhere;
  text-align: center;
}

.officer-identity__body {
  min-width: 0;
  flex: 1;
  padding-right: 0;
}

.officer-identity__name {
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 700;
  line-height: 1.35;
}

.officer-identity__meta {
  margin-top: var(--uwo-space-2);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.45;
}

.officer-identity__change {
  position: absolute;
  top: var(--uwo-space-3);
  right: var(--uwo-space-3);
  width: 128rpx !important;
  min-width: 128rpx;
  max-width: 128rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  color: var(--uwo-color-accent-text);
  background: var(--uwo-color-surface-muted);
  border: 2rpx solid var(--uwo-color-border-strong);
  border-radius: var(--uwo-radius-control);
  display: inline-flex !important;
  box-sizing: border-box;
  font-size: var(--uwo-font-size-minimum-action);
  font-weight: 600;
  white-space: nowrap;
}

.officer-identity__change::after {
  border: 0;
}

.field-error {
  display: block;
  margin-top: var(--uwo-space-2);
  color: var(--uwo-color-danger);
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.report-form {
  margin-top: var(--uwo-space-6);
  overflow: hidden;
}

.report-form__field {
  padding: var(--uwo-space-6);
}

.report-form__field + .report-form__field {
  border-top: 2rpx solid var(--uwo-color-border-subtle);
}

.type-list,
.screenshot-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: var(--uwo-space-2);
}

.type-chip {
  display: inline-flex !important;
  flex: 0 0 auto;
  width: auto !important;
  min-width: 0;
  max-width: 100%;
  min-height: 64rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 var(--uwo-space-4);
  color: var(--uwo-color-text-primary);
  background: var(--uwo-color-surface-muted);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-pill);
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.35;
}

.type-chip--selected {
  color: var(--uwo-color-surface);
  background: var(--uwo-color-ink);
  border-color: var(--uwo-color-ink);
  font-weight: 600;
}

.form-control,
.form-textarea {
  width: 100%;
  color: var(--uwo-color-text-primary);
  background: var(--uwo-color-surface-muted);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
  font-size: var(--uwo-font-size-body);
}

.form-control {
  min-height: 88rpx;
  padding: 0 var(--uwo-space-4);
}

.form-textarea {
  min-height: 200rpx;
  padding: var(--uwo-space-3) var(--uwo-space-4);
  line-height: 1.5;
}

.evidence-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--uwo-space-4);
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  color: var(--uwo-color-text-primary);
  background: transparent;
  border: 0;
  text-align: left;
}

.evidence-toggle__copy {
  min-width: 0;
  flex: 1;
}

.evidence-toggle__title {
  display: block;
  font-size: var(--uwo-font-size-body);
  font-weight: 600;
  overflow-wrap: anywhere;
}

.evidence-toggle__summary {
  display: block;
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
  overflow-wrap: anywhere;
}

.evidence-toggle__action-wrap {
  display: flex;
  align-items: center;
  gap: var(--uwo-space-2);
  flex: none;
}

.evidence-toggle__action {
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-minimum-action);
  font-weight: 600;
}

.evidence-toggle__disclosure {
  width: 32rpx;
  height: 32rpx;
}

.evidence-fields {
  padding-top: var(--uwo-space-4);
}

.evidence-fields__group + .evidence-fields__group {
  margin-top: var(--uwo-space-6);
}

.screenshot-item,
.screenshot-add {
  width: 176rpx;
}

.screenshot-image {
  display: block;
  width: 176rpx;
  height: 176rpx;
  border-radius: var(--uwo-radius-control);
}

.screenshot-remove,
.screenshot-add {
  min-height: 88rpx;
  margin: 0;
  color: var(--uwo-color-text-primary);
  background: var(--uwo-color-surface-muted);
  border: 2rpx solid var(--uwo-color-border-strong);
  border-radius: var(--uwo-radius-control);
  font-size: var(--uwo-font-size-minimum-action);
}

.screenshot-remove {
  width: 100%;
  margin-top: var(--uwo-space-2);
}

.screenshot-add {
  min-height: 176rpx;
  border-style: dashed;
}

.report-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  width: 100%;
  margin: 0;
  padding: var(--uwo-space-4) var(--uwo-space-4)
    calc(var(--uwo-space-4) + env(safe-area-inset-bottom));
  background: var(--uwo-color-canvas);
  border-top: 2rpx solid var(--uwo-color-border-subtle);
}

.submit-error {
  display: flex;
  margin-bottom: var(--uwo-space-3);
  overflow-wrap: anywhere;
}

.report-actions__status {
  display: block;
  margin-bottom: var(--uwo-space-3);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  text-align: center;
}

.report-actions__submit,
.report-complete__button {
  width: 100%;
  margin: 0;
}

.report-actions__submit {
  display: flex !important;
  width: 100% !important;
  min-width: 0;
  box-sizing: border-box;
}

.report-complete {
  margin-top: var(--uwo-space-12);
  margin-bottom: calc(var(--uwo-space-12) + env(safe-area-inset-bottom));
  padding: var(--uwo-space-8);
  text-align: center;
}

.report-complete__mark {
  margin: 0 auto;
}

.report-complete__title {
  margin-top: var(--uwo-space-6);
  font-size: var(--uwo-font-size-page-title);
  font-weight: 700;
}

.report-complete__copy {
  margin-top: var(--uwo-space-3);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-body);
  line-height: 1.6;
}

.report-complete__number {
  margin-top: var(--uwo-space-6);
  padding: var(--uwo-space-4);
  background: var(--uwo-color-surface-muted);
  border-radius: var(--uwo-radius-control);
}

.report-complete__number-label {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
}

.report-complete__number-value {
  margin-top: var(--uwo-space-2);
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 700;
}

.report-complete__actions {
  display: flex;
  flex-direction: column;
  gap: var(--uwo-space-3);
  margin-top: var(--uwo-space-8);
}

@media (min-width: 900rpx) {
  .report-header,
  .officer-section,
  .report-form,
  .report-complete {
    margin-right: auto;
    margin-left: auto;
  }
}
