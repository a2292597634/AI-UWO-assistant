.report-page {
  height: 100vh;
  color: var(--uwo-color-text-primary);
  background: var(--uwo-color-canvas);
}

.report-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: var(--uwo-space-6) var(--uwo-space-5) var(--uwo-space-5);
}

.report-header__eyebrow,
.report-header__title,
.report-header__hint {
  display: block;
}

.report-header__eyebrow,
.form-hint {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.report-header__title {
  margin-top: var(--uwo-space-2);
}

.report-header__hint {
  max-width: 520rpx;
  margin-top: var(--uwo-space-2);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.report-header__link {
  min-height: 88rpx;
  padding-left: var(--uwo-space-4);
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-action);
  line-height: 88rpx;
  white-space: nowrap;
}

.report-card {
  margin: 0 var(--uwo-space-4);
  padding: var(--uwo-space-5);
  background: var(--uwo-color-surface);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
}

.form-field + .form-field {
  margin-top: var(--uwo-space-5);
}

.form-label {
  display: block;
  margin-bottom: var(--uwo-space-2);
  font-size: var(--uwo-font-size-body);
  font-weight: 600;
}

.required {
  color: var(--uwo-color-accent-text);
}

.form-control,
.form-textarea {
  box-sizing: border-box;
  width: 100%;
  color: var(--uwo-color-text-primary);
  background: var(--uwo-color-surface-muted);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
  font-size: var(--uwo-font-size-body);
}

.form-control {
  min-height: 88rpx;
  padding: 0 var(--uwo-space-4);
  line-height: 88rpx;
}

.form-control--empty {
  color: var(--uwo-color-text-secondary);
}

.form-textarea {
  min-height: 200rpx;
  padding: var(--uwo-space-3) var(--uwo-space-4);
  line-height: 1.5;
}

.form-hint {
  display: block;
  margin-top: var(--uwo-space-2);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.type-list,
.screenshot-list {
  display: flex;
  flex-wrap: wrap;
}

.type-chip {
  min-height: 72rpx;
  margin: 0 var(--uwo-space-2) var(--uwo-space-2) 0;
  padding: 0 var(--uwo-space-4);
  color: var(--uwo-color-text-secondary);
  background: var(--uwo-color-surface-muted);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-pill);
  line-height: 72rpx;
}

.type-chip--selected {
  color: var(--uwo-color-accent-text);
  border-color: var(--uwo-color-accent-brass);
}

.screenshot-list {
  margin-top: var(--uwo-space-3);
}

.screenshot-item,
.screenshot-add {
  width: 180rpx;
  margin: 0 var(--uwo-space-3) var(--uwo-space-3) 0;
}

.screenshot-image {
  display: block;
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--uwo-radius-control);
}

.screenshot-remove {
  min-height: 64rpx;
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 64rpx;
  text-align: center;
}

.screenshot-add {
  min-height: 176rpx;
  color: var(--uwo-color-text-secondary);
  background: var(--uwo-color-surface-muted);
  border: 2rpx dashed var(--uwo-color-border-strong);
  border-radius: var(--uwo-radius-control);
  line-height: 176rpx;
  text-align: center;
}

.report-actions {
  padding: var(--uwo-space-5) var(--uwo-space-4)
    calc(var(--uwo-space-6) + env(safe-area-inset-bottom));
}

.submit-button {
  min-height: 88rpx;
  color: var(--uwo-color-surface);
  background: var(--uwo-color-accent-brass);
  border-radius: var(--uwo-radius-control);
  font-size: var(--uwo-font-size-action);
  font-weight: 600;
}

@media (min-width: 900rpx) {
  .report-header,
  .report-card,
  .report-actions {
    max-width: 820rpx;
    margin-right: auto;
    margin-left: auto;
  }
}
