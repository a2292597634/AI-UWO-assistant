/* 頁面容器 */

.editor-page {
  box-sizing: border-box;
  width: 100%;
  height: 100vh;
  padding: 0 var(--uwo-space-4);
  background: var(--uwo-color-canvas);
  color: var(--uwo-color-text-primary);
}

.editor-header {
  padding: var(--uwo-space-8) var(--uwo-space-4) var(--uwo-space-6);
}

.editor-header__title {
  display: block;
  color: var(--uwo-color-ink);
  font-family: var(--uwo-font-family-display);
  font-size: var(--uwo-font-size-page-title);
  font-weight: 700;
}

.editor-header__hint {
  display: block;
  margin-top: var(--uwo-space-2);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  overflow-wrap: anywhere;
}

/* 分段內容 */

.editor-section__content {
  min-width: 0;
  padding-top: var(--uwo-space-2);
}

.editor-section__toolbar {
  display: flex;
  min-width: 0;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  gap: var(--uwo-space-3);
  margin-bottom: var(--uwo-space-4);
}

.editor-section__toolbar-label {
  min-width: 0;
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 600;
  overflow-wrap: anywhere;
}

.editor-section__action,
.form-btn,
.form-link,
.form-row__remove,
.skill-card__remove,
.tag__remove {
  box-sizing: border-box;
  display: inline-flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: var(--uwo-space-2) var(--uwo-space-4);
  border: 0;
  border-radius: var(--uwo-radius-control);
  background: transparent;
  color: var(--uwo-color-accent-text);
  font-family: var(--uwo-font-family-body);
  font-size: var(--uwo-font-size-minimum-action);
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
  white-space: normal;
  overflow-wrap: anywhere;
}

.editor-section__action::after,
.form-btn::after,
.form-link::after,
.form-row__remove::after,
.skill-card__remove::after,
.tag__remove::after,
.submit-btn::after {
  border: 0;
}

.editor-section__action:active,
.form-btn:active,
.form-link:active,
.form-row__remove:active,
.skill-card__remove:active,
.tag__remove:active {
  opacity: 0.8;
}

/* 表單欄位 */

.form-field {
  min-width: 0;
  margin-bottom: var(--uwo-space-6);
}

.form-field--row {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: var(--uwo-space-4);
}

.form-field__label {
  display: block;
  margin-bottom: var(--uwo-space-2);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-body);
  font-weight: 600;
  overflow-wrap: anywhere;
}

.form-field--row .form-field__label {
  min-width: 0;
  margin-bottom: 0;
}

.required {
  color: var(--uwo-color-danger);
}

/* 輸入控制 */

.form-input,
.form-textarea,
.form-picker {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface-muted);
  color: var(--uwo-color-text-primary);
  font-family: var(--uwo-font-family-body);
  font-size: var(--uwo-font-size-body);
  overflow-wrap: anywhere;
}

.form-input {
  height: 72rpx;
  padding: 0 var(--uwo-space-4);
}

.form-input--search {
  margin-bottom: var(--uwo-space-2);
}

.form-input--num {
  width: 120rpx;
  max-width: 100%;
  text-align: center;
}

.form-textarea {
  min-height: 120rpx;
  padding: var(--uwo-space-4);
  line-height: 1.5;
}

.form-picker {
  display: flex;
  height: 72rpx;
  align-items: center;
  padding: 0 var(--uwo-space-4);
}

.form-picker--empty {
  color: var(--uwo-color-text-secondary);
}

.form-picker--sm {
  flex: 1;
  height: 72rpx;
  font-size: var(--uwo-font-size-supporting);
}

.form-hint {
  margin-top: calc(var(--uwo-space-3) * -1);
  margin-bottom: var(--uwo-space-4);
  color: var(--uwo-color-success);
  font-size: var(--uwo-font-size-minimum-action);
  overflow-wrap: anywhere;
}

.form-error {
  display: block;
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-danger);
  font-size: var(--uwo-font-size-minimum-action);
  overflow-wrap: anywhere;
}

.form-error--summary {
  margin-top: var(--uwo-space-3);
  text-align: center;
}

.form-link {
  margin-right: var(--uwo-space-4);
}

.form-link--danger,
.form-row__remove,
.skill-card__remove,
.tag__remove {
  color: var(--uwo-color-danger);
}

.form-empty {
  padding: var(--uwo-space-8) 0;
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-body);
  text-align: center;
  overflow-wrap: anywhere;
}

.form-btn {
  flex: 0 0 auto;
  margin-left: var(--uwo-space-3);
  background: var(--uwo-color-ink);
  color: var(--uwo-color-surface);
}

/* 行布局 */

.form-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: var(--uwo-space-3);
  margin-bottom: var(--uwo-space-3);
}

.form-row > .form-input {
  flex: 1;
  min-width: 0;
}

.form-row__level {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: var(--uwo-space-1);
}

.form-row__level-label {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.form-row__remove {
  flex: 0 0 auto;
}

/* 頭像區域 */

.portrait-area {
  display: flex;
  box-sizing: border-box;
  width: 240rpx;
  max-width: 100%;
  height: 240rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx dashed var(--uwo-color-border-strong);
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-surface-muted);
}

.portrait-preview {
  width: 100%;
  height: 100%;
}

.portrait-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--uwo-space-8);
}

.portrait-placeholder__text {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  text-align: center;
  overflow-wrap: anywhere;
}

.portrait-actions {
  display: flex;
  gap: var(--uwo-space-4);
  margin-top: var(--uwo-space-3);
}

/* 標籤列表 */

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--uwo-space-2);
  margin-bottom: var(--uwo-space-3);
}

.tag {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: var(--uwo-space-2);
  padding: 0 var(--uwo-space-3);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-pill);
  background: var(--uwo-color-surface-muted);
  color: var(--uwo-color-text-primary);
}

.tag__label {
  min-width: 0;
  font-size: var(--uwo-font-size-supporting);
  overflow-wrap: anywhere;
}

.tag__remove {
  min-width: 88rpx;
  padding: 0 var(--uwo-space-2);
}

/* 技能卡片 */

.skill-card {
  min-width: 0;
  margin-bottom: var(--uwo-space-4);
  padding: var(--uwo-space-4);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface-muted);
}

.skill-card__header {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: var(--uwo-space-3);
  margin-bottom: var(--uwo-space-3);
}

.skill-card__title {
  min-width: 0;
  flex: 1;
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-body);
  font-weight: 600;
  overflow-wrap: anywhere;
}

.skill-card__remove {
  flex: 0 0 auto;
}

.skill-card__field {
  min-width: 0;
  margin-bottom: var(--uwo-space-3);
}

.skill-card__field--half {
  min-width: 0;
  flex: 1;
}

.skill-card__row {
  display: flex;
  min-width: 0;
  gap: var(--uwo-space-3);
}

.skill-card__label {
  display: block;
  margin-bottom: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
  overflow-wrap: anywhere;
}

/* 提交區 */

.submit-area {
  padding: var(--uwo-space-8) 0 calc(var(--uwo-space-8) + env(safe-area-inset-bottom));
}

.submit-area__title,
.submit-area__hint {
  display: block;
  overflow-wrap: anywhere;
}

.submit-area__title {
  color: var(--uwo-color-ink);
  font-family: var(--uwo-font-family-display);
  font-size: var(--uwo-font-size-section-title);
  font-weight: 700;
}

.submit-area__hint {
  margin: var(--uwo-space-2) 0 var(--uwo-space-4);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.submit-btn {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  padding: var(--uwo-space-3) var(--uwo-space-6);
  border: 0;
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-ink);
  color: var(--uwo-color-surface);
  font-family: var(--uwo-font-family-body);
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
  white-space: normal;
  overflow-wrap: anywhere;
}

.submit-btn[disabled] {
  background: var(--uwo-color-surface-muted);
  color: var(--uwo-color-text-secondary);
}

.page-bottom-spacer {
  height: var(--uwo-space-4);
}
