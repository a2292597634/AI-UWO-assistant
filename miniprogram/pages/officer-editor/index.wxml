<scroll-view class="report-page" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="report-header">
    <view>
      <text class="report-header__eyebrow">航海士資料維護</text>
      <text class="report-header__title ui-display-title">回報資料錯誤</text>
      <text class="report-header__hint">請指出既有資料的問題，我們會核對並更新資料庫。</text>
    </view>
    <view class="report-header__link" bindtap="onMyReportsTap">我的回報</view>
  </view>

  <view class="report-card">
    <view class="form-field">
      <text class="form-label">選擇航海士 <text class="required">*</text></text>
      <picker mode="selector" range="{{officerOptions}}" range-key="name" value="{{officerIndex}}" bindchange="onOfficerChange">
        <view class="form-control {{selectedOfficerName ? '' : 'form-control--empty'}}">{{selectedOfficerName || '請選擇航海士'}}</view>
      </picker>
    </view>

    <view class="form-field">
      <text class="form-label">錯誤類型 <text class="required">*</text></text>
      <view class="type-list">
        <view wx:for="{{errorTypeOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="onErrorTypeTap" class="type-chip {{item.selected ? 'type-chip--selected' : ''}}">{{item.name}}</view>
      </view>
    </view>

    <view class="form-field">
      <text class="form-label">錯誤說明 <text class="required">*</text></text>
      <textarea class="form-textarea" value="{{draft.description}}" maxlength="500" placeholder="目前哪項資料有誤？請盡量寫明位置與內容" bindinput="onDescriptionInput"></textarea>
    </view>

    <view class="form-field">
      <text class="form-label">建議的正確內容 <text class="required">*</text></text>
      <textarea class="form-textarea" value="{{draft.suggestedCorrection}}" maxlength="500" placeholder="請寫出你認為正確的資料" bindinput="onCorrectionInput"></textarea>
    </view>

    <view class="form-field">
      <text class="form-label">來源網址（選填）</text>
      <input class="form-control" value="{{draft.sourceUrl}}" type="text" placeholder="https://" bindinput="onSourceUrlInput" />
      <text class="form-hint">提供來源可加快確認，但不影響提交。</text>
    </view>

    <view class="form-field">
      <text class="form-label">證據截圖（選填）</text>
      <text class="form-hint">最多 3 張；提供來源可加快確認。</text>
      <view class="screenshot-list">
        <view wx:for="{{screenshotTempPaths}}" wx:key="*this" class="screenshot-item">
          <image class="screenshot-image" src="{{item}}" mode="aspectFill" />
          <view class="screenshot-remove" data-index="{{index}}" bindtap="onRemoveScreenshot">移除</view>
        </view>
        <view wx:if="{{screenshotTempPaths.length < 3}}" class="screenshot-add" bindtap="onChooseScreenshots">＋ 添加截圖</view>
      </view>
    </view>
  </view>

  <view class="report-actions">
    <button class="submit-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">提交回報</button>
  </view>
</scroll-view>
