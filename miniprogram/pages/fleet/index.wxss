.config-unsaved-guard__mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--uwo-color-ink);
  opacity: 0.36;
}

.config-unsaved-guard__dialog {
  width: 520rpx;
  max-width: calc(100vw - var(--uwo-space-8));
  background: var(--uwo-color-surface);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
  box-shadow: var(--uwo-shadow-elevated);
}

.config-unsaved-guard__header {
  padding: var(--uwo-space-4) var(--uwo-space-4) var(--uwo-space-3);
  border-bottom: 2rpx solid var(--uwo-color-border-subtle);
}

.config-unsaved-guard__title {
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-section-title);
  font-weight: 700;
}

.config-unsaved-guard__body {
  padding: var(--uwo-space-4);
}

.config-unsaved-guard__text {
  display: block;
  margin-bottom: var(--uwo-space-4);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-body);
  line-height: 1.6;
}

.config-unsaved-guard__actions {
  display: flex;
  flex-direction: column;
  gap: var(--uwo-space-2);
}

.config-unsaved-guard__button {
  width: 100%;
  min-height: 88rpx;
}

.asset-loading-state,
.asset-load-error {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  padding: var(--uwo-space-4) var(--uwo-space-8);
  color: var(--uwo-color-text-secondary);
  text-align: center;
}

.asset-load-error {
  flex-direction: column;
}

.fleet-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  color: var(--uwo-color-text-primary);
  background: var(--uwo-color-canvas);
}

.fleet-context {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--uwo-space-3);
  padding: var(--uwo-space-3) var(--uwo-space-4);
  border-bottom: 2rpx solid var(--uwo-color-border-subtle);
  background: var(--uwo-color-surface);
  color: var(--uwo-color-text-primary);
}

.fleet-context__copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: var(--uwo-space-1);
}

.fleet-context__eyebrow,
.fleet-context__title,
.fleet-context__count {
  display: block;
  overflow-wrap: anywhere;
}

.fleet-context__eyebrow,
.fleet-context__count {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.fleet-context__title {
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 600;
}

.fleet-scroll {
  min-height: 0;
  flex: 1;
}

.ship-tabs {
  width: 100%;
  background: var(--uwo-color-surface-muted);
  border-bottom: 1rpx solid var(--uwo-color-border-subtle);
}

.ship-tabs__content {
  display: flex;
  width: 1120rpx;
  min-width: 1120rpx;
}

.ship-tab {
  box-sizing: border-box;
  width: 160rpx;
  padding: var(--uwo-space-4) var(--uwo-space-2) var(--uwo-space-3);
  color: var(--uwo-color-text-secondary);
  text-align: center;
}

.ship-tab--active {
  color: var(--uwo-color-text-primary);
  background: var(--uwo-color-surface);
  border-bottom: 5rpx solid var(--uwo-color-accent-brass);
}

.ship-tab__label,
.ship-tab__meta {
  display: block;
}

.ship-tab__label {
  font-size: var(--uwo-font-size-body);
  font-weight: 700;
}

.ship-tab__meta {
  margin-top: var(--uwo-space-1);
  font-size: var(--uwo-font-size-minimum-action);
}

.ship-editor {
  padding-bottom: var(--uwo-space-12);
}

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.panel-heading__title,
.panel-heading__hint {
  display: block;
}

.panel-heading__hint {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
}

.slot-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: var(--uwo-space-2);
  padding: 0 var(--uwo-space-4) var(--uwo-space-2);
}

.officer-slot {
  position: relative;
  box-sizing: border-box;
  min-height: 180rpx;
  padding: var(--uwo-space-2) 0;
  overflow: hidden;
  text-align: center;
  background: var(--uwo-color-surface-muted);
  border: 1rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
}

.officer-slot--filled {
  background: var(--uwo-color-surface);
}

.officer-slot__number {
  position: absolute;
  top: 3rpx;
  left: 4rpx;
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
}

.officer-slot__visuals {
  position: relative;
  display: inline-block;
  width: 64rpx;
  height: 64rpx;
  background: var(--uwo-color-ink);
  border-radius: var(--uwo-radius-control);
}

.officer-slot__frame {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--uwo-radius-control);
}

.officer-slot__portrait {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--uwo-radius-control);
}

.officer-slot__rarity-icon {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 42rpx;
  height: 42rpx;
}

.officer-slot__type-icon {
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 4;
  width: 17rpx;
  height: 17rpx;
}

.officer-slot__name,
.officer-slot__empty {
  display: block;
  overflow: hidden;
  margin-top: var(--uwo-space-1);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.officer-slot__empty {
  padding-top: 33rpx;
  color: var(--uwo-color-text-secondary);
}

.officer-slot .officer-action-sheet__trigger {
  margin-top: var(--uwo-space-2);
}

.ban-chip__remove {
  color: var(--uwo-color-danger);
}

.target-panel,
.candidate-panel,
.ban-panel,
.summary-panel,
.overview-panel {
  margin: 0 var(--uwo-space-4) var(--uwo-space-4);
  padding: var(--uwo-space-4);
  background: var(--uwo-color-surface-muted);
  border: 1rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
}

.panel-heading {
  margin-bottom: var(--uwo-space-3);
}

.panel-heading__title {
  font-size: var(--uwo-font-size-body);
  font-weight: 700;
}

.target-row {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  padding: var(--uwo-space-3) 0;
  border-bottom: 1rpx solid var(--uwo-color-border-subtle);
}

.target-row__skill {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.target-row__icon,
.summary-row__icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: var(--uwo-space-2);
}

.target-row__name {
  overflow: hidden;
  font-size: var(--uwo-font-size-body);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.level-input {
  box-sizing: border-box;
  width: 88rpx;
  min-height: 88rpx;
  margin: 0 var(--uwo-space-2);
  padding: var(--uwo-space-2);
  color: var(--uwo-color-surface);
  background: var(--uwo-color-success);
  border: 0;
  border-radius: var(--uwo-radius-control);
  font-size: var(--uwo-font-size-body);
  text-align: center;
}

.target-row__remove {
  display: flex;
  min-height: 88rpx;
  flex: 0 0 auto;
  align-items: center;
  margin: 0;
  padding: 0 var(--uwo-space-2);
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-minimum-action);
  overflow-wrap: anywhere;
  white-space: normal;
}

.target-actions {
  display: flex;
  gap: var(--uwo-space-2);
  margin-top: var(--uwo-space-3);
}

.target-actions .ui-button {
  min-width: 0;
  flex: 1;
  min-height: 88rpx;
  height: auto;
  margin: 0;
  padding: var(--uwo-space-3) var(--uwo-space-4);
  line-height: 1.3;
  font-size: var(--uwo-font-size-body);
  overflow-wrap: anywhere;
}

.target-panel__notice {
  display: block;
  margin-top: var(--uwo-space-3);
  color: var(--uwo-color-warning);
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.ban-list,
.summary-row__contributors {
  width: 100%;
}

.ban-list__content,
.summary-row__contributors-content {
  display: flex;
  align-items: center;
}

.candidate-row,
.overview-row {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--uwo-color-border-subtle);
}

.candidate-row__copy,
.summary-row__copy {
  min-width: 0;
  flex: 1;
}

.candidate-row__name,
.candidate-row__meta,
.candidate-row__status,
.summary-row__name,
.summary-row__level {
  display: block;
}

.candidate-row__name,
.summary-row__name {
  overflow: hidden;
  font-size: var(--uwo-font-size-body);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.candidate-row__meta,
.candidate-row__status,
.summary-row__level {
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.candidate-row {
  min-height: 88rpx;
  gap: var(--uwo-space-3);
  padding: var(--uwo-space-2) 0;
  border-bottom-color: var(--uwo-color-border-subtle);
}

.candidate-row__visuals,
.ban-chip__visuals {
  position: relative;
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  margin-right: var(--uwo-space-3);
  background: var(--uwo-color-ink);
  border-radius: var(--uwo-radius-control);
}

.candidate-row__frame,
.ban-chip__frame {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  width: 54rpx;
  height: 54rpx;
  border-radius: var(--uwo-radius-control);
}

.candidate-row__portrait,
.ban-chip__portrait {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 54rpx;
  height: 54rpx;
  border-radius: var(--uwo-radius-control);
}

.candidate-row__rarity-icon,
.ban-chip__rarity-icon {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 35rpx;
  height: 35rpx;
}

.candidate-row__type-icon,
.ban-chip__type-icon {
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 4;
  width: 14rpx;
  height: 14rpx;
}

.contributor-avatar {
  width: 54rpx;
  height: 54rpx;
  margin-right: var(--uwo-space-3);
  border-radius: var(--uwo-radius-control);
}

.candidate-row__status {
  max-width: 180rpx;
  margin-left: var(--uwo-space-2);
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-minimum-action);
  overflow-wrap: anywhere;
  text-align: right;
}

.candidate-row__contribution {
  display: block;
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-success);
  font-size: var(--uwo-font-size-supporting);
  font-weight: 600;
  overflow-wrap: anywhere;
}

.ban-list__content {
  gap: var(--uwo-space-2);
  min-width: max-content;
}

.ban-chip {
  display: flex;
  align-items: center;
  padding: var(--uwo-space-2);
  background: var(--uwo-color-surface-muted);
  border-radius: var(--uwo-radius-control);
}

.ban-chip__portrait {
  margin-right: var(--uwo-space-1);
}

.ban-chip__name,
.ban-chip__remove {
  font-size: var(--uwo-font-size-minimum-action);
}

.ban-chip__remove {
  margin-left: var(--uwo-space-2);
}

.summary-row {
  display: grid;
  grid-template-columns: 42rpx minmax(0, 1fr) auto;
  gap: var(--uwo-space-2);
  align-items: center;
  padding: var(--uwo-space-2) 0;
  border-bottom: 1rpx solid var(--uwo-color-border-subtle);
}

.summary-row__icon {
  margin-right: 0;
}

.summary-row__contributors {
  grid-column: 2 / 4;
  height: 62rpx;
}

.summary-row__contributors-content {
  min-width: max-content;
  height: 62rpx;
}

.contributor-avatar {
  width: 48rpx;
  height: 48rpx;
  margin-right: var(--uwo-space-1);
}

.contributors-empty {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.overview-row {
  padding: var(--uwo-space-3) 0;
}

.overview-row__name {
  width: 120rpx;
  font-size: var(--uwo-font-size-body);
  font-weight: 700;
}

.overview-row__count {
  width: 110rpx;
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.overview-row__status {
  color: var(--uwo-color-success);
  font-size: var(--uwo-font-size-supporting);
}

.ban-panel,
.summary-panel,
.overview-panel {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.excluded-list {
  display: flex;
  flex-direction: column;
  gap: var(--uwo-space-2);
}

.excluded-row {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  gap: var(--uwo-space-3);
  border-bottom: 2rpx solid var(--uwo-color-border-subtle);
}

.excluded-row__name {
  min-width: 0;
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-body);
  overflow-wrap: anywhere;
}

.excluded-row__remove {
  flex: 0 0 auto;
  min-height: 88rpx;
  margin: 0;
  padding: 0 var(--uwo-space-3);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface-muted);
  color: var(--uwo-color-danger);
  font-family: var(--uwo-font-family-body);
  font-size: var(--uwo-font-size-minimum-action);
  white-space: normal;
  overflow-wrap: anywhere;
}

.excluded-row__remove::after {
  border: 0;
}
