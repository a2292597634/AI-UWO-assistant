/* ── Config Management Bar ── */

.config-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx;
  background: #2a2b25;
  border-bottom: 1rpx solid #3d3e38;
  flex: 0 0 auto;
}

.config-bar__info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  flex: 1;
  overflow: hidden;
}

.config-bar__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #e0d8c0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.config-bar__status {
  font-size: 20rpx;
  color: #7a7a6e;
}

.config-bar__status--saved {
  color: #5b8c3e;
}

.config-bar__status--unsaved {
  color: #d48c2c;
}

.config-bar__actions {
  flex: 0 0 auto;
  margin-left: 16rpx;
}

.config-bar__login {
  font-size: 24rpx;
  color: #d48c2c;
  padding: 8rpx 16rpx;
  border: 1rpx solid #d48c2c;
  border-radius: 8rpx;
}

.config-bar__menu-btn {
  font-size: 32rpx;
  padding: 8rpx 12rpx;
  color: #e0d8c0;
}

/* ── Config Management Menu ── */

.config-menu {
  position: absolute;
  top: 160rpx;
  right: 16rpx;
  z-index: 100;
  background: #2f302b;
  border: 1rpx solid #4a4b45;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
  padding: 8rpx 0;
  min-width: 200rpx;
}

.config-menu__item {
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #d0c8b0;
  border-bottom: 1rpx solid #3a3b35;
}

.config-menu__item:last-child {
  border-bottom: none;
}

.config-menu__item--danger {
  color: #e07060;
}

/* ── Config Modal (shared) ── */

.config-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.config-modal {
  background: #2f302b;
  border-radius: 16rpx;
  width: 600rpx;
  max-height: 80vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.config-modal--small {
  width: 520rpx;
}

.config-modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #3d3e38;
  flex: 0 0 auto;
}

.config-modal__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #e0d8c0;
}

.config-modal__close {
  font-size: 28rpx;
  color: #8a8a7e;
  padding: 4rpx;
}

.config-modal__body {
  padding: 24rpx;
  flex: 1;
  overflow-y: auto;
}

.config-modal__text {
  font-size: 26rpx;
  color: #c0b890;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.config-modal__input {
  width: 100%;
  padding: 16rpx;
  background: #3a3b35;
  border: 1rpx solid #4a4b45;
  border-radius: 8rpx;
  color: #e0d8c0;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.config-modal__actions {
  display: flex;
  gap: 16rpx;
}

.config-modal__actions--stack {
  flex-direction: column;
}

.config-modal__btn {
  flex: 1;
  padding: 16rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  text-align: center;
  border: none;
}

.config-modal__btn--confirm {
  background: #4a6b2e;
  color: #e0d8c0;
}

.config-modal__btn--cancel {
  background: #3a3b35;
  color: #a0a090;
}

.config-modal__btn--danger {
  background: #6b3a2e;
  color: #e0c8c0;
}

/* ── Config List ── */

.config-modal__list {
  flex: 1;
  overflow-y: auto;
}

.config-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #3a3b35;
}

.config-item:last-child {
  border-bottom: none;
}

.config-item--active {
  background: #3a3b35;
}

.config-item__info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  overflow: hidden;
}

.config-item__name {
  font-size: 28rpx;
  color: #e0d8c0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.config-item__meta {
  font-size: 20rpx;
  color: #7a7a6e;
}

.config-item__current {
  font-size: 22rpx;
  color: #5b8c3e;
  flex: 0 0 auto;
  margin-left: 16rpx;
}

.config-modal__empty {
  padding: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #7a7a6e;
}

.asset-loading-state,
.asset-load-error {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  color: #5a5a4e;
  text-align: center;
}

.asset-load-error {
  flex-direction: column;
}

.fleet-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  color: #292a26;
  background: #ded7c7;
}

.fleet-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 28rpx 24rpx 22rpx;
  color: #e8d5a3;
  background: #2f302b;
}

.fleet-header__eyebrow,
.fleet-header__title,
.fleet-header__count {
  display: block;
}

.fleet-header__eyebrow {
  color: #c4a45a;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.fleet-header__title {
  margin-top: 6rpx;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.fleet-header__count {
  padding-bottom: 5rpx;
  color: #ddd6c4;
  font-size: 22rpx;
}

.fleet-scroll {
  min-height: 0;
  flex: 1;
}

.ship-tabs {
  width: 100%;
  background: #e8dfce;
  border-bottom: 1rpx solid #c4b99a;
}

.ship-tabs__content {
  display: flex;
  width: 1120rpx;
  min-width: 1120rpx;
}

.ship-tab {
  box-sizing: border-box;
  width: 160rpx;
  padding: 16rpx 8rpx 14rpx;
  color: #756b59;
  text-align: center;
}

.ship-tab--active {
  color: #292a26;
  background: #d4cbb4;
  border-bottom: 5rpx solid #b99552;
}

.ship-tab__label,
.ship-tab__meta {
  display: block;
}

.ship-tab__label {
  font-size: 25rpx;
  font-weight: 700;
}

.ship-tab__meta {
  margin-top: 4rpx;
  font-size: 18rpx;
}

.ship-editor {
  padding-bottom: 48rpx;
}

.section-heading,
.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-heading {
  padding: 24rpx 24rpx 16rpx;
}

.section-heading__title,
.section-heading__meta,
.section-heading__status,
.panel-heading__title,
.panel-heading__hint {
  display: block;
}

.section-heading__title {
  font-size: 32rpx;
  font-weight: 700;
}

.section-heading__meta,
.section-heading__status,
.panel-heading__hint {
  color: #756b59;
  font-size: 21rpx;
}

.section-heading__meta {
  margin-top: 5rpx;
}

.section-heading__status {
  padding: 8rpx 12rpx;
  color: #f0e4c4;
  background: #596257;
  border-radius: 6rpx;
}

.slot-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 6rpx;
  padding: 0 14rpx 10rpx;
}

.officer-slot {
  position: relative;
  box-sizing: border-box;
  min-height: 180rpx;
  padding: 10rpx 2rpx 72rpx;
  overflow: hidden;
  text-align: center;
  background: #e8dfce;
  border: 1rpx solid #c4b99a;
  border-radius: 8rpx;
}

.officer-slot--filled {
  background: #d4cbb4;
}

.officer-slot__number {
  position: absolute;
  top: 3rpx;
  left: 4rpx;
  color: #9b8b6d;
  font-size: 12rpx;
}

.officer-slot__visuals {
  position: relative;
  display: inline-block;
  width: 64rpx;
  height: 64rpx;
  background: #2f302b;
  border-radius: 8rpx;
}

.officer-slot__frame {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
}

.officer-slot__portrait {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
}

.officer-slot__rarity-icon {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 42rpx;
  height: 42rpx;
}

.officer-slot__type-icon {
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 4;
  width: 17rpx;
  height: 17rpx;
}

.officer-slot__name,
.officer-slot__empty {
  display: block;
  overflow: hidden;
  margin-top: 2rpx;
  font-size: 14rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.officer-slot__empty {
  padding-top: 33rpx;
  color: #a2967d;
}

.officer-slot__actions {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  left: 4rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 3rpx;
  min-height: 64rpx;
}

.slot-action {
  box-sizing: border-box;
  display: flex;
  min-width: 0;
  min-height: 64rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rpx 0;
  overflow: hidden;
  color: #596257;
  background: #e8dfce;
  border-radius: 5rpx;
  font-size: 12rpx;
  line-height: 1.1;
  white-space: nowrap;
}

.slot-action:active {
  background: #c4b99a;
}

.slot-action--danger,
.target-row__remove,
.ban-chip__remove {
  color: #8b3a3a;
}

.slot-action--danger {
  background: #ead2c8;
}

.slot-action--danger:active {
  background: #d7b5a9;
}

.slot-action__glyph,
.slot-action__label {
  display: block;
}

.slot-action__glyph {
  font-size: 24rpx;
  line-height: 1;
}

.slot-action__label {
  margin-top: 2rpx;
  font-size: 12rpx;
  line-height: 1.1;
}

.mode-tabs {
  display: flex;
  margin: 0 20rpx 18rpx;
  background: #c4b99a;
  border-radius: 8rpx;
}

.mode-tab {
  flex: 1;
  padding: 14rpx;
  color: #5a5a4e;
  font-size: 25rpx;
  text-align: center;
}

.mode-tab--active {
  color: #f0e4c4;
  background: #2f302b;
  border-radius: 8rpx;
}

.target-panel,
.skill-selector,
.candidate-panel,
.ban-panel,
.summary-panel,
.overview-panel {
  margin: 0 20rpx 18rpx;
  padding: 18rpx;
  background: #e8dfce;
  border: 1rpx solid #c4b99a;
  border-radius: 8rpx;
}

.panel-heading {
  margin-bottom: 12rpx;
}

.panel-heading__title {
  font-size: 26rpx;
  font-weight: 700;
}

.target-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #d4cbb4;
}

.target-row__skill {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.target-row__icon,
.skill-option__icon,
.summary-row__icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: 10rpx;
}

.target-row__name {
  overflow: hidden;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.level-input {
  box-sizing: border-box;
  width: 84rpx;
  margin: 0 12rpx;
  padding: 6rpx 10rpx;
  color: #f0e4c4;
  background: #596257;
  border: 0;
  border-radius: 5rpx;
  font-size: 21rpx;
  text-align: center;
}

.target-row__remove {
  padding: 7rpx 0 7rpx 8rpx;
  font-size: 20rpx;
}

.target-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
}

button.subtle-button,
button.primary-button {
  height: 68rpx;
  margin: 0;
  padding: 0 20rpx;
  line-height: 68rpx;
  font-size: 23rpx;
}

button.subtle-button {
  color: #596257;
  background: #d4cbb4;
}

button.primary-button {
  color: #f0e4c4;
  background: #2f302b;
}

.skill-kind-tabs,
.skill-categories,
.ban-list,
.summary-row__contributors {
  width: 100%;
}

.skill-kind-tabs__content,
.skill-categories__content,
.ban-list__content,
.summary-row__contributors-content {
  display: flex;
  align-items: center;
}

.skill-kind-tabs__content,
.skill-categories__content {
  gap: 8rpx;
}

.skill-kind,
.skill-category {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  color: #5a5a4e;
  background: #d4cbb4;
  border-radius: 18rpx;
  font-size: 21rpx;
}

.skill-kind--active,
.skill-category--active {
  color: #f0e4c4;
  background: #596257;
}

.skill-categories {
  margin-top: 10rpx;
}

.skill-search {
  box-sizing: border-box;
  width: 100%;
  margin: 12rpx 0;
  padding: 10rpx 14rpx;
  color: #292a26;
  background: #f5efe0;
  border: 1rpx solid #c4b99a;
  border-radius: 6rpx;
  font-size: 23rpx;
}

.skill-options {
  max-height: 330rpx;
}

.skill-option,
.candidate-row,
.overview-row {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #d4cbb4;
}

.skill-option {
  padding: 10rpx 0;
}

.skill-option--active {
  color: #8b3a3a;
}

.skill-option__copy,
.candidate-row__copy,
.summary-row__copy {
  min-width: 0;
  flex: 1;
}

.skill-option__name,
.skill-option__meta,
.candidate-row__name,
.candidate-row__meta,
.candidate-row__status,
.summary-row__name,
.summary-row__level {
  display: block;
}

.skill-option__name,
.candidate-row__name,
.summary-row__name {
  overflow: hidden;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.skill-option__meta,
.candidate-row__meta,
.candidate-row__status,
.summary-row__level {
  margin-top: 3rpx;
  color: #756b59;
  font-size: 19rpx;
}

.skill-option__description {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 4rpx;
  color: #9b8b6d;
  font-size: 18rpx;
  line-height: 1.3;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.skill-option__select {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  margin-left: 10rpx;
  padding: 8rpx 10rpx;
  color: #f0e4c4;
  background: #596257;
  border-radius: 6rpx;
  font-size: 19rpx;
  line-height: 1.1;
}

.skill-option__select:active {
  background: #2f302b;
}

.candidate-row {
  padding: 10rpx 0;
}

.candidate-row--disabled {
  opacity: 0.55;
}

.candidate-row__visuals,
.ban-chip__visuals {
  position: relative;
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  margin-right: 12rpx;
  background: #2f302b;
  border-radius: 7rpx;
}

.candidate-row__frame,
.ban-chip__frame {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  width: 54rpx;
  height: 54rpx;
  border-radius: 7rpx;
}

.candidate-row__portrait,
.ban-chip__portrait {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 54rpx;
  height: 54rpx;
  border-radius: 7rpx;
}

.candidate-row__rarity-icon,
.ban-chip__rarity-icon {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 35rpx;
  height: 35rpx;
}

.candidate-row__type-icon,
.ban-chip__type-icon {
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 4;
  width: 14rpx;
  height: 14rpx;
}

.contributor-avatar {
  width: 54rpx;
  height: 54rpx;
  margin-right: 12rpx;
  border-radius: 7rpx;
}

.candidate-row__status {
  margin-left: 10rpx;
  text-align: right;
}

.ban-list__content {
  gap: 10rpx;
  min-width: max-content;
}

.ban-chip {
  display: flex;
  align-items: center;
  padding: 7rpx 9rpx;
  background: #d4cbb4;
  border-radius: 7rpx;
}

.ban-chip__portrait {
  margin-right: 6rpx;
}

.ban-chip__name,
.ban-chip__remove {
  font-size: 19rpx;
}

.ban-chip__remove {
  margin-left: 7rpx;
}

.summary-row {
  display: grid;
  grid-template-columns: 42rpx minmax(0, 1fr) auto;
  gap: 6rpx 8rpx;
  align-items: center;
  padding: 7rpx 0;
  border-bottom: 1rpx solid #d4cbb4;
}

.summary-row__icon {
  margin-right: 0;
}

.summary-row__state {
  color: #8b3a3a;
  font-size: 19rpx;
}

.summary-row__state--ok {
  color: #596257;
}

.summary-row__contributors {
  grid-column: 2 / 4;
  height: 62rpx;
}

.summary-row__contributors-content {
  min-width: max-content;
  height: 62rpx;
}

.contributor-avatar {
  width: 48rpx;
  height: 48rpx;
  margin-right: 6rpx;
}

.contributors-empty,
.inline-empty {
  color: #9b8b6d;
  font-size: 20rpx;
}

.inline-empty {
  padding: 18rpx 0 6rpx;
  text-align: center;
}

.overview-row {
  padding: 11rpx 0;
}

.overview-row__name {
  width: 120rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.overview-row__count {
  width: 110rpx;
  color: #756b59;
  font-size: 21rpx;
}

.overview-row__status {
  color: #596257;
  font-size: 20rpx;
}

.proposal-preview-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  background: rgba(38, 51, 47, 0.45);
}

.proposal-preview-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 82vh;
  overflow-y: auto;
  padding: 28rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #f5efe0;
}

.proposal-preview__header,
.proposal-preview__summary,
.proposal-preview__member-count,
.proposal-preview__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.proposal-preview__title,
.proposal-preview__summary-value {
  font-size: 28rpx;
  font-weight: 700;
}

.proposal-preview__scope,
.proposal-preview__group-title,
.proposal-preview__constraint {
  display: block;
  margin-top: 8rpx;
  color: #756b59;
  font-size: 21rpx;
}

.proposal-preview__close {
  min-width: 88rpx;
  padding: 18rpx 0;
  color: #76501a;
  text-align: right;
}

.proposal-preview__summary {
  margin-top: 20rpx;
  padding: 18rpx;
  background: #e8dfce;
}

.proposal-preview__target-list,
.proposal-preview__members,
.proposal-preview__locked,
.proposal-preview__constraints {
  margin-top: 16rpx;
}

.proposal-preview__target-row {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 4rpx 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #c8bda4;
}

.proposal-preview__target-name,
.proposal-preview__target-level,
.proposal-preview__target-state {
  font-size: 22rpx;
}

.proposal-preview__target-level {
  color: #625947;
}

.proposal-preview__target-state {
  color: #7a541c;
  text-align: right;
}

.proposal-preview__member-count {
  gap: 12rpx;
  margin-top: 16rpx;
  color: #625947;
  font-size: 21rpx;
}

.proposal-preview__members {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.proposal-preview__member {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.proposal-preview__member--added {
  color: #596257;
}

.proposal-preview__member--removed {
  color: #8b3a3a;
}

.proposal-preview__constraints {
  padding: 12rpx;
  background: #e8dfce;
}

.proposal-preview__actions {
  gap: 16rpx;
  margin-top: 24rpx;
}

.proposal-preview__actions button {
  flex: 1;
}

.proposal-undo-bar {
  position: fixed;
  right: 20rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: 20rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  border: 1rpx solid #c8bda4;
  background: #f5efe0;
}

.proposal-undo-bar__text {
  color: #596257;
  font-size: 21rpx;
}
