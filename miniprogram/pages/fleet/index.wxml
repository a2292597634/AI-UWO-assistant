<view class="fleet-page">
  <config-bar
    config-name="{{configName}}"
    config-status="{{configStatus}}"
    auth-status="{{authStatus}}"
    active-config-id="{{activeConfigId}}"
    config-list="{{configList}}"
    unclassified-configs="{{unclassifiedConfigs}}"
    list-state="{{configListState}}"
    list-error="{{configListError}}"
    expanded="{{expanded}}"
    bind:toggle="onConfigToggle"
    bind:login="onConfigLogin"
    bind:save="onConfigSave"
    bind:save-as="onConfigSaveAs"
    bind:rename="onConfigRename"
    bind:delete="onConfigDelete"
    bind:new="onConfigNew"
    bind:exit="onConfigExit"
    bind:load="onConfigLoad"
    bind:classify="onConfigClassify"
    bind:retry="onConfigRetry"
  />

  <view class="fleet-context">
    <view class="fleet-context__copy">
      <text class="fleet-context__eyebrow">戰鬥配隊</text>
      <text class="fleet-context__title">{{currentShip.label}}</text>
    </view>
    <text class="fleet-context__count">已配置 {{occupiedCount}} / {{fleetCapacity}} 個位置</text>
  </view>

  <config-name-modal
    visible="{{showNameModal}}"
    title="{{modalTitle}}"
    value="{{modalInputValue}}"
    bind:cancel="onConfigModalCancel"
    bind:input="onConfigNameInput"
    bind:confirm="onConfigModalConfirm"
  />

  <view wx:if="{{showUnsavedGuard}}" class="config-unsaved-guard__mask"></view>
  <view wx:if="{{showUnsavedGuard}}" class="config-unsaved-guard__dialog" catchtap="onNoop">
      <view class="config-unsaved-guard__header">
        <text class="config-unsaved-guard__title">尚未保存</text>
      </view>
      <view class="config-unsaved-guard__body">
        <text class="config-unsaved-guard__text">目前配置尚未保存，要如何處理？</text>
        <view class="config-unsaved-guard__actions">
          <button class="ui-button ui-button--primary config-unsaved-guard__button" bindtap="onUnsavedGuardSave">保存並繼續</button>
          <button class="ui-button ui-button--danger config-unsaved-guard__button" bindtap="onUnsavedGuardDiscard">放棄修改</button>
          <button class="ui-button ui-button--secondary config-unsaved-guard__button" bindtap="onUnsavedGuardCancel">取消</button>
        </view>
      </view>
  </view>

  <config-conflict-modal
    visible="{{showConflictDialog}}"
    bind:reload="onConflictReload"
    bind:force="onConflictForceOverwrite"
    bind:cancel="onConflictCancel"
  />

  <scroll-view class="fleet-scroll" scroll-y>
    <scroll-view class="ship-tabs" scroll-x="true" enable-flex>
      <view class="ship-tabs__content">
        <view
          wx:for="{{shipTabs}}"
          wx:key="id"
          class="ship-tab {{item.isCurrent ? 'ship-tab--active' : ''}}"
          bindtap="onShipTabTap"
          data-id="{{item.id}}"
        >
          <text class="ship-tab__label">{{item.label}}</text>
          <text class="ship-tab__meta">{{item.count}} / 11</text>
        </view>
      </view>
    </scroll-view>

    <view class="ship-editor">
      <mode-tabs
        value="{{mode}}"
        options="{{[{ value: 'manual', label: '手動配隊' }, { value: 'auto', label: '自動配隊' } ]}}"
        bind:change="onModeTap"
      />

      <view class="slot-grid">
        <view wx:for="{{currentShip.slots}}" wx:key="position" class="officer-slot {{item.officer ? 'officer-slot--filled' : ''}} {{item.officer && item.officer.status === 'locked' ? 'officer-slot--locked' : ''}}">
          <text class="officer-slot__number">{{item.position}}</text>
          <block wx:if="{{item.officer}}">
            <view class="officer-slot__visuals">
              <image wx:if="{{item.officer.visuals.framePath && !failedPortraitImages[item.officer.id + '_frame']}}" class="officer-slot__frame" src="{{item.officer.visuals.framePath}}" mode="aspectFill" binderror="onImageError" data-kind="portrait" data-id="{{item.officer.id}}_frame" />
              <image wx:if="{{assetReady && !failedPortraitImages[item.officer.id]}}" class="officer-slot__portrait" src="{{item.officer.portraitPath}}" mode="aspectFill" binderror="onImageError" data-kind="portrait" data-id="{{item.officer.id}}" />
              <image wx:if="{{item.officer.visuals.rarityIconPath && !failedPortraitImages[item.officer.id + '_rarity']}}" class="officer-slot__rarity-icon" src="{{item.officer.visuals.rarityIconPath}}" mode="aspectFit" binderror="onImageError" data-kind="portrait" data-id="{{item.officer.id}}_rarity" />
              <image wx:if="{{item.officer.visuals.typeIconPath && !failedPortraitImages[item.officer.id + '_type']}}" class="officer-slot__type-icon" src="{{item.officer.visuals.typeIconPath}}" mode="aspectFit" binderror="onImageError" data-kind="portrait" data-id="{{item.officer.id}}_type" />
            </view>
            <text class="officer-slot__name">{{item.officer.name}}</text>
            <officer-action-sheet
              presentation="trigger"
              officer-id="{{item.officer.id}}"
              officer-name="{{item.officer.name}}"
              status="{{item.officer.status}}"
              variant="slot"
              allow-ban="{{true}}"
              bind:lock="onOfficerLock"
              bind:remove="onOfficerRemove"
              bind:ban="onBanOfficer"
            />
          </block>
          <text wx:else class="officer-slot__empty">空位</text>
        </view>
      </view>

      <view wx:if="{{mode === 'auto'}}" class="target-panel">
        <view class="panel-heading">
          <text class="panel-heading__title">自動配隊目標</text>
          <text class="panel-heading__hint">僅計算目前船</text>
        </view>
        <block wx:for="{{targets}}" wx:key="id">
          <view wx:if="{{item.configured}}" class="target-row">
            <view class="target-row__skill">
              <image wx:if="{{assetReady && item.skillIconPath && !failedSkillImages[item.skillId]}}" class="target-row__icon" src="{{item.skillIconPath}}" mode="aspectFit" binderror="onImageError" data-kind="skill" data-id="{{item.skillId}}" />
              <text class="target-row__name">{{item.skillName}}</text>
            </view>
            <view class="target-row__controls">
              <input class="level-input" type="number" maxlength="2" value="{{item.targetLevel}}" bindblur="onTargetLevelBlur" data-id="{{item.id}}" aria-label="{{item.skillName}}目標等級" />
              <button class="target-row__remove" bindtap="onRemoveTarget" data-id="{{item.id}}" aria-label="刪除{{item.skillName}}目標">
                <text aria-hidden="true">×</text>
              </button>
            </view>
          </view>
        </block>
        <view wx:if="{{!canRecalculate}}" class="target-panel__empty">
          <text class="target-panel__empty-title">尚未設定目標</text>
          <text class="target-panel__notice">請從下方技能篩選選擇技能加入目標</text>
        </view>
        <view class="target-actions">
          <button class="ui-button ui-button--primary" disabled="{{!canRecalculate}}" bindtap="onRecalculate">重新計算</button>
        </view>
      </view>

      <skill-picker-sheet
        presentation="inline"
        visible="{{true}}"
        skill-kinds="{{skillKinds}}"
        skill-categories="{{skillCategories}}"
        skills="{{manualSkills}}"
        selected-kind-id="{{manualKind}}"
        selected-category-id="{{manualCategoryId}}"
        selected-skill-id="{{manualSkillId}}"
        show-search="{{false}}"
        has-more="{{manualSkillHasMore}}"
        selection-label="{{mode === 'auto' ? '加入目標' : '選擇'}}"
        title="{{mode === 'auto' ? '技能篩選' : '選擇戰鬥技能'}}"
        hint="{{mode === 'auto' ? '選擇後加入目標' : '點擊技能查看詳情，選擇後篩選可用航海士'}}"
        empty-label="沒有符合的戰鬥技能"
        bind:kind-change="onSkillKindTap"
        bind:category-change="onSkillCategoryTap"
        bind:skill-tap="onSkillTap"
        bind:select="onSkillSelect"
        bind:reach-end="onSkillListReachEnd"
      />

      <view wx:if="{{mode === 'manual'}}" class="candidate-panel">
        <view class="panel-heading">
          <text class="panel-heading__title">可用航海士</text>
          <text class="panel-heading__hint">選擇技能後顯示候選</text>
        </view>
        <view wx:for="{{manualCandidates}}" wx:key="id" class="candidate-row" bindtap="onOfficerSelect" data-id="{{item.id}}">
          <view class="candidate-row__visuals">
            <image wx:if="{{item.visuals.framePath && !failedPortraitImages[item.id + '_frame']}}" class="candidate-row__frame" src="{{item.visuals.framePath}}" mode="aspectFill" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}_frame" />
            <image wx:if="{{assetReady && !failedPortraitImages[item.id]}}" class="candidate-row__portrait" src="{{item.portraitPath}}" mode="aspectFill" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}" />
            <image wx:if="{{item.visuals.rarityIconPath && !failedPortraitImages[item.id + '_rarity']}}" class="candidate-row__rarity-icon" src="{{item.visuals.rarityIconPath}}" mode="aspectFit" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}_rarity" />
            <image wx:if="{{item.visuals.typeIconPath && !failedPortraitImages[item.id + '_type']}}" class="candidate-row__type-icon" src="{{item.visuals.typeIconPath}}" mode="aspectFit" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}_type" />
          </view>
          <view class="candidate-row__copy">
            <text class="candidate-row__name">{{item.name}}</text>
            <text class="candidate-row__meta">{{item.jobName}} · {{item.rarityName}}</text>
            <text wx:if="{{item.skillContributionLabel}}" class="candidate-row__contribution">{{item.skillContributionLabel}}</text>
          </view>
          <text class="candidate-row__status">{{item.selectionHint}}</text>
        </view>
        <empty-state
          wx:if="{{manualSkillId && manualCandidates.length === 0}}"
          title="沒有可用航海士"
          description="目前條件下沒有可加入目前船的航海士"
        />
      </view>

      <disclosure-section
        title="本船排除名單"
        hint="解除後下次重算才會出現"
        count-label="{{currentShipExcludedOfficers ? currentShipExcludedOfficers.length : 0}}"
        default-expanded="{{false}}"
        compact="{{true}}"
      >
        <view class="officer-exclusion-grid">
          <view wx:for="{{currentShipExcludedOfficers}}" wx:key="id" class="officer-exclusion-card">
            <view class="officer-exclusion-card__visuals">
              <view class="officer-exclusion-card__portrait-wrap">
                <image wx:if="{{item.visuals.framePath && !failedPortraitImages[item.id + '_frame']}}" class="officer-exclusion-card__frame" src="{{item.visuals.framePath}}" mode="aspectFill" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}_frame" />
                <image wx:if="{{assetReady && !failedPortraitImages[item.id]}}" class="officer-exclusion-card__portrait" src="{{item.portraitPath}}" mode="aspectFill" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}" />
                <image wx:if="{{item.visuals.rarityIconPath && !failedPortraitImages[item.id + '_rarity']}}" class="officer-exclusion-card__rarity-icon" src="{{item.visuals.rarityIconPath}}" mode="aspectFit" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}_rarity" />
                <image wx:if="{{item.visuals.typeIconPath && !failedPortraitImages[item.id + '_type']}}" class="officer-exclusion-card__type-icon" src="{{item.visuals.typeIconPath}}" mode="aspectFit" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}_type" />
              </view>
              <button class="officer-exclusion-card__remove" bindtap="onUnbanOfficer" data-id="{{item.id}}" aria-label="解除{{item.name}}的本船排除">
                <text class="officer-exclusion-card__remove-icon">×</text>
              </button>
            </view>
            <text class="officer-exclusion-card__name">{{item.name}}</text>
          </view>
        </view>
        <empty-state
          wx:if="{{currentShipExcludedOfficers && currentShipExcludedOfficers.length === 0}}"
          title="目前沒有本船排除"
          description="從目前結果移出的航海士會顯示在此處"
        />
      </disclosure-section>

      <disclosure-section
        wx:if="{{mode === 'auto'}}"
        title="全艦隊排除名單"
        hint="解除後下次重算才會出現"
        count-label="{{bannedOfficers.length}}"
        default-expanded="{{false}}"
        compact="{{true}}"
      >
        <view class="ban-panel">
          <view class="officer-exclusion-grid">
            <view wx:for="{{bannedOfficers}}" wx:key="id" class="officer-exclusion-card">
              <view class="officer-exclusion-card__visuals">
                <view class="officer-exclusion-card__portrait-wrap">
                  <image wx:if="{{item.visuals.framePath && !failedPortraitImages[item.id + '_frame']}}" class="officer-exclusion-card__frame" src="{{item.visuals.framePath}}" mode="aspectFill" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}_frame" />
                  <image wx:if="{{assetReady && !failedPortraitImages[item.id]}}" class="officer-exclusion-card__portrait" src="{{item.portraitPath}}" mode="aspectFill" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}" />
                  <image wx:if="{{item.visuals.rarityIconPath && !failedPortraitImages[item.id + '_rarity']}}" class="officer-exclusion-card__rarity-icon" src="{{item.visuals.rarityIconPath}}" mode="aspectFit" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}_rarity" />
                  <image wx:if="{{item.visuals.typeIconPath && !failedPortraitImages[item.id + '_type']}}" class="officer-exclusion-card__type-icon" src="{{item.visuals.typeIconPath}}" mode="aspectFit" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}_type" />
                </view>
                <button class="officer-exclusion-card__remove" bindtap="onUnbanOfficer" data-id="{{item.id}}" aria-label="解除{{item.name}}的全艦隊排除">
                  <text class="officer-exclusion-card__remove-icon">×</text>
                </button>
              </view>
              <text class="officer-exclusion-card__name">{{item.name}}</text>
            </view>
          </view>
          <empty-state
            wx:if="{{bannedOfficers.length === 0}}"
            title="目前沒有排除航海士"
            description="排除後的航海士會顯示在此處"
          />
        </view>
      </disclosure-section>

      <disclosure-section
        title="{{currentShip.label}} 技能累計"
        hint="使用真實累計值 · 不封頂"
        count-label="{{skillSummary.length}}"
        default-expanded="{{false}}"
        compact="{{true}}"
      >
        <view class="summary-panel">
          <view wx:for="{{skillSummary}}" wx:key="skillId" class="summary-row">
            <image wx:if="{{assetReady && item.skillIconPath && !failedSkillImages[item.skillId]}}" class="summary-row__icon" src="{{item.skillIconPath}}" mode="aspectFit" binderror="onImageError" data-kind="skill" data-id="{{item.skillId}}" />
            <view class="summary-row__copy">
              <text class="summary-row__name">{{item.skillName}}</text>
              <text class="summary-row__level">Lv.{{item.totalLevel}}{{item.targetLevel !== null ? ' / 目標 Lv.' + item.targetLevel : ''}}</text>
            </view>
            <scroll-view class="summary-row__contributors" scroll-x="true" enable-flex>
              <view class="summary-row__contributors-content">
                <image wx:if="{{assetReady && !failedPortraitImages[item.officerId]}}" wx:for="{{item.contributors}}" wx:key="officerId" class="contributor-avatar" src="{{item.portraitPath}}" mode="aspectFill" binderror="onImageError" data-kind="portrait" data-id="{{item.officerId}}" />
                <text wx:if="{{item.contributors.length > 0}}" class="summary-row__contributors-count">{{item.contributors.length}} 人</text>
                <text wx:if="{{item.contributors.length === 0}}" class="contributors-empty">尚無貢獻者</text>
              </view>
            </scroll-view>
          </view>
          <empty-state
            wx:if="{{skillSummary.length === 0}}"
            title="尚未配置戰鬥技能"
            description="選擇技能與航海士後，此處會顯示目前船的技能累計"
          />
        </view>
      </disclosure-section>

    </view>
   </scroll-view>

   <result-preview-sheet
     visible="{{proposalPreview !== null}}"
     preview="{{proposalPreview}}"
     can-undo="{{canUndoProposal}}"
     bind:cancel="onProposalCancel"
     bind:apply="onProposalApply"
     bind:undo="onUndoProposal"
     bind:dismiss-undo="onUndoDismiss"
   />

   <skill-sheet skill="{{sheetSkill}}" bind:dismiss="onSheetDismiss" bind:reverselookup="onReverseLookup" />
</view>
