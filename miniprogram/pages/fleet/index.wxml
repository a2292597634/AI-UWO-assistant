<view class="fleet-page">
  <config-bar
    config-name="{{configName}}"
    config-status="{{configStatus}}"
    auth-status="{{authStatus}}"
    active-config-id="{{activeConfigId}}"
    show-menu="{{showConfigMenu}}"
    bind:info-tap="onConfigListOpen"
    bind:login-tap="onConfigLogin"
    bind:menu-tap="onConfigMenuTap"
    bind:save="onConfigSave"
    bind:save-as="onConfigSaveAs"
    bind:rename="onConfigRename"
    bind:delete="onConfigDelete"
    bind:new="onConfigNew"
  />

  <view class="fleet-context">
    <view class="fleet-context__copy">
      <text class="fleet-context__eyebrow">戰鬥配隊</text>
      <text class="fleet-context__title">{{currentShip.label}} · {{currentShip.statusLabel}}</text>
    </view>
    <text class="fleet-context__count">已配置 {{occupiedCount}} / {{fleetCapacity}} 個位置</text>
  </view>

  <!-- Config List Modal -->
  <view wx:if="{{showConfigList}}" class="config-modal-mask" bindtap="onConfigListClose">
    <view class="config-modal" catchtap="onNoop">
      <view class="config-modal__header">
        <text class="config-modal__title">我的配置</text>
        <text class="config-modal__close" bindtap="onConfigListClose">✕</text>
      </view>
      <scroll-view class="config-modal__list" scroll-y>
        <view
          wx:for="{{configList}}"
          wx:key="configId"
          class="config-item {{activeConfigId === item.configId ? 'config-item--active' : ''}}"
          bindtap="onConfigSelect"
          data-id="{{item.configId}}"
        >
          <view class="config-item__info">
            <text class="config-item__name">{{item.name}}</text>
            <text class="config-item__meta">最後修改：{{item.updatedAt}}</text>
          </view>
          <text wx:if="{{activeConfigId === item.configId}}" class="config-item__current">使用中</text>
        </view>
        <view wx:if="{{configList.length === 0}}" class="config-modal__empty">尚無已保存配置</view>
      </scroll-view>
    </view>
  </view>

  <!-- Name Input Modal -->
  <view wx:if="{{showNameModal}}" class="config-modal-mask" bindtap="onConfigModalCancel">
    <view class="config-modal config-modal--small" catchtap="onNoop">
      <view class="config-modal__header">
        <text class="config-modal__title">{{modalTitle}}</text>
        <text class="config-modal__close" bindtap="onConfigModalCancel">✕</text>
      </view>
      <view class="config-modal__body">
        <view catchtap="onNoop">
          <input
            class="config-modal__input"
            placeholder="輸入配置名稱（1–30 字）"
            maxlength="30"
            value="{{modalInputValue}}"
            bindinput="onConfigNameInput"
            catchtap="onNoop"
          />
        </view>
        <view class="config-modal__actions">
          <button class="config-modal__btn config-modal__btn--cancel" bindtap="onConfigModalCancel">取消</button>
          <button class="config-modal__btn config-modal__btn--confirm" bindtap="onConfigModalConfirm">確認</button>
        </view>
      </view>
    </view>
  </view>

  <!-- Unsaved Changes Guard -->
  <view wx:if="{{showUnsavedGuard}}" class="config-modal-mask">
    <view class="config-modal config-modal--small" catchtap="onNoop">
      <view class="config-modal__header">
        <text class="config-modal__title">尚未保存</text>
      </view>
      <view class="config-modal__body">
        <text class="config-modal__text">目前配置尚未保存，要如何處理？</text>
        <view class="config-modal__actions config-modal__actions--stack">
          <button class="config-modal__btn config-modal__btn--confirm" bindtap="onUnsavedGuardSave">保存並繼續</button>
          <button class="config-modal__btn config-modal__btn--danger" bindtap="onUnsavedGuardDiscard">放棄修改</button>
          <button class="config-modal__btn config-modal__btn--cancel" bindtap="onUnsavedGuardCancel">取消</button>
        </view>
      </view>
    </view>
  </view>

  <!-- Conflict Dialog -->
  <view wx:if="{{showConflictDialog}}" class="config-modal-mask">
    <view class="config-modal config-modal--small" catchtap="onNoop">
      <view class="config-modal__header">
        <text class="config-modal__title">版本衝突</text>
      </view>
      <view class="config-modal__body">
        <text class="config-modal__text">此配置已被其他裝置修改，請選擇處理方式：</text>
        <view class="config-modal__actions config-modal__actions--stack">
          <button class="config-modal__btn config-modal__btn--confirm" bindtap="onConflictReload">重新載入雲端版本</button>
          <button class="config-modal__btn config-modal__btn--danger" bindtap="onConflictForceOverwrite">強制覆蓋</button>
          <button class="config-modal__btn config-modal__btn--cancel" bindtap="onConflictCancel">取消</button>
        </view>
      </view>
    </view>
  </view>

  <scroll-view class="fleet-scroll" scroll-y>
    <scroll-view class="ship-tabs" scroll-x="true" enable-flex>
      <view class="ship-tabs__content">
        <view
          wx:for="{{shipTabs}}"
          wx:key="id"
          class="ship-tab {{item.isCurrent ? 'ship-tab--active' : ''}}"
          bindtap="onShipTabTap"
          data-id="{{item.id}}"
        >
          <text class="ship-tab__label">{{item.label}}</text>
          <text class="ship-tab__meta">{{item.count}} / 11 · {{item.statusLabel}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="ship-editor">
      <mode-tabs
        value="{{mode}}"
        options="{{[{ value: 'manual', label: '手動配隊' }, { value: 'auto', label: '自動配隊' } ]}}"
        bind:change="onModeTap"
      />

      <view class="slot-grid">
        <view wx:for="{{currentShip.slots}}" wx:key="position" class="officer-slot {{item.officer ? 'officer-slot--filled' : ''}}">
          <text class="officer-slot__number">{{item.position}}</text>
          <block wx:if="{{item.officer}}">
            <view class="officer-slot__visuals">
              <image wx:if="{{item.officer.visuals.framePath && !failedPortraitImages[item.officer.id + '_frame']}}" class="officer-slot__frame" src="{{item.officer.visuals.framePath}}" mode="aspectFill" binderror="onImageError" data-kind="portrait" data-id="{{item.officer.id}}_frame" />
              <image wx:if="{{assetReady && !failedPortraitImages[item.officer.id]}}" class="officer-slot__portrait" src="{{item.officer.portraitPath}}" mode="aspectFill" binderror="onImageError" data-kind="portrait" data-id="{{item.officer.id}}" />
              <image wx:if="{{item.officer.visuals.rarityIconPath && !failedPortraitImages[item.officer.id + '_rarity']}}" class="officer-slot__rarity-icon" src="{{item.officer.visuals.rarityIconPath}}" mode="aspectFit" binderror="onImageError" data-kind="portrait" data-id="{{item.officer.id}}_rarity" />
              <image wx:if="{{item.officer.visuals.typeIconPath && !failedPortraitImages[item.officer.id + '_type']}}" class="officer-slot__type-icon" src="{{item.officer.visuals.typeIconPath}}" mode="aspectFit" binderror="onImageError" data-kind="portrait" data-id="{{item.officer.id}}_type" />
            </view>
            <text class="officer-slot__name">{{item.officer.name}}</text>
            <officer-action-sheet
              presentation="trigger"
              officer-id="{{item.officer.id}}"
              officer-name="{{item.officer.name}}"
              status="{{item.officer.status}}"
              variant="slot"
              bind:open="onOfficerActionOpen"
            />
          </block>
          <text wx:else class="officer-slot__empty">空位</text>
        </view>
      </view>

      <view wx:if="{{mode === 'auto'}}" class="target-panel">
        <view class="panel-heading">
          <text class="panel-heading__title">自動配隊目標</text>
          <text class="panel-heading__hint">只計算目前船</text>
        </view>
        <view wx:for="{{targets}}" wx:key="id" class="target-row">
          <view class="target-row__skill">
            <image wx:if="{{assetReady && item.skillIconPath && !failedSkillImages[item.skillId]}}" class="target-row__icon" src="{{item.skillIconPath}}" mode="aspectFit" binderror="onImageError" data-kind="skill" data-id="{{item.skillId}}" />
            <text class="target-row__name">{{item.configured ? item.skillName : '選擇戰鬥技能'}}</text>
          </view>
          <input class="level-input" type="number" maxlength="2" value="{{item.targetLevel}}" bindblur="onTargetLevelBlur" data-id="{{item.id}}" />
          <button class="ui-button ui-button--secondary target-row__remove" bindtap="onRemoveTarget" data-id="{{item.id}}">刪除目標</button>
        </view>
        <view class="target-actions">
          <button class="ui-button ui-button--secondary" bindtap="onAddTarget">新增目標</button>
          <button class="ui-button ui-button--primary" disabled="{{!canRecalculate}}" bindtap="onRecalculate">重新計算</button>
        </view>
        <text wx:if="{{!canRecalculate}}" class="target-panel__notice">請先設定至少一個有效的戰鬥技能目標</text>
      </view>

      <skill-picker-sheet
        presentation="inline"
        visible="{{true}}"
        skill-kinds="{{skillKinds}}"
        skill-categories="{{skillCategories}}"
        skills="{{manualSkills}}"
        selected-kind-id="{{manualKind}}"
        selected-category-id="{{manualCategoryId}}"
        selected-skill-id="{{manualSkillId}}"
        search-text="{{skillSearchText}}"
        has-more="{{manualSkillHasMore}}"
        selection-label="{{mode === 'auto' ? '加入目標' : '選擇'}}"
        title="選擇戰鬥技能"
        hint="{{mode === 'auto' ? '點擊技能查看詳情，選擇加入目標' : '點擊技能查看詳情，選擇後篩選可用航海士'}}"
        search-placeholder="在目前分類搜尋技能名稱"
        empty-label="沒有符合的戰鬥技能"
        bind:kind-change="onSkillKindTap"
        bind:category-change="onSkillCategoryTap"
        bind:search-input="onSkillSearchInput"
        bind:skill-tap="onSkillTap"
        bind:select="onSkillSelect"
        bind:reach-end="onSkillListReachEnd"
      />

      <view wx:if="{{mode === 'manual'}}" class="candidate-panel">
        <view class="panel-heading">
          <text class="panel-heading__title">可用航海士</text>
          <text class="panel-heading__hint">選擇技能後顯示候選</text>
        </view>
        <view wx:for="{{manualCandidates}}" wx:key="id" class="candidate-row" bindtap="onOfficerSelect" data-id="{{item.id}}">
          <view class="candidate-row__visuals">
            <image wx:if="{{item.visuals.framePath && !failedPortraitImages[item.id + '_frame']}}" class="candidate-row__frame" src="{{item.visuals.framePath}}" mode="aspectFill" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}_frame" />
            <image wx:if="{{assetReady && !failedPortraitImages[item.id]}}" class="candidate-row__portrait" src="{{item.portraitPath}}" mode="aspectFill" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}" />
            <image wx:if="{{item.visuals.rarityIconPath && !failedPortraitImages[item.id + '_rarity']}}" class="candidate-row__rarity-icon" src="{{item.visuals.rarityIconPath}}" mode="aspectFit" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}_rarity" />
            <image wx:if="{{item.visuals.typeIconPath && !failedPortraitImages[item.id + '_type']}}" class="candidate-row__type-icon" src="{{item.visuals.typeIconPath}}" mode="aspectFit" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}_type" />
          </view>
          <view class="candidate-row__copy">
            <text class="candidate-row__name">{{item.name}}</text>
            <text class="candidate-row__meta">{{item.jobName}} · {{item.rarityName}}</text>
            <text wx:if="{{item.skillContributionLabel}}" class="candidate-row__contribution">{{item.skillContributionLabel}}</text>
          </view>
          <text class="candidate-row__status">{{item.selectionHint}}</text>
        </view>
        <empty-state
          wx:if="{{manualSkillId && manualCandidates.length === 0}}"
          title="沒有可用航海士"
          description="目前條件下沒有可加入目前船的航海士"
        />
      </view>

      <disclosure-section
        title="本船排除名單"
        hint="解除後下次重算才會出現"
        count-label="{{currentShipExcludedOfficers ? currentShipExcludedOfficers.length : 0}}"
        default-expanded="{{false}}"
      >
        <view class="excluded-list">
          <view wx:for="{{currentShipExcludedOfficers}}" wx:key="id" class="excluded-row">
            <text class="excluded-row__name">{{item.name}}</text>
            <button class="excluded-row__remove" bindtap="onUnbanOfficer" data-id="{{item.id}}">解除本船排除</button>
          </view>
        </view>
        <empty-state
          wx:if="{{currentShipExcludedOfficers && currentShipExcludedOfficers.length === 0}}"
          title="目前沒有本船排除"
          description="從目前結果移出的航海士會顯示在此處"
        />
      </disclosure-section>

      <disclosure-section
        wx:if="{{mode === 'auto'}}"
        title="全艦隊排除名單"
        hint="解除後下次重算才會出現"
        count-label="{{bannedOfficers.length}}"
        default-expanded="{{false}}"
      >
        <view class="ban-panel">
          <scroll-view class="ban-list" scroll-x="true" enable-flex>
            <view class="ban-list__content">
              <view wx:for="{{bannedOfficers}}" wx:key="id" class="ban-chip">
                <view class="ban-chip__visuals">
                  <image wx:if="{{item.visuals.framePath && !failedPortraitImages[item.id + '_frame']}}" class="ban-chip__frame" src="{{item.visuals.framePath}}" mode="aspectFill" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}_frame" />
                  <image wx:if="{{assetReady && !failedPortraitImages[item.id]}}" class="ban-chip__portrait" src="{{item.portraitPath}}" mode="aspectFill" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}" />
                  <image wx:if="{{item.visuals.rarityIconPath && !failedPortraitImages[item.id + '_rarity']}}" class="ban-chip__rarity-icon" src="{{item.visuals.rarityIconPath}}" mode="aspectFit" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}_rarity" />
                  <image wx:if="{{item.visuals.typeIconPath && !failedPortraitImages[item.id + '_type']}}" class="ban-chip__type-icon" src="{{item.visuals.typeIconPath}}" mode="aspectFit" binderror="onImageError" data-kind="portrait" data-id="{{item.id}}_type" />
                </view>
                <text class="ban-chip__name">{{item.name}}</text>
                <text class="ban-chip__remove" bindtap="onUnbanOfficer" data-id="{{item.id}}">解除</text>
              </view>
            </view>
          </scroll-view>
          <empty-state
            wx:if="{{bannedOfficers.length === 0}}"
            title="目前沒有排除航海士"
            description="排除後的航海士會顯示在此處"
          />
        </view>
      </disclosure-section>

      <disclosure-section
        title="{{currentShip.label}} 技能累計"
        hint="使用真實累計值 · 不封頂"
        count-label="{{skillSummary.length}}"
        default-expanded="{{false}}"
      >
        <view class="summary-panel">
          <view wx:for="{{skillSummary}}" wx:key="skillId" class="summary-row">
            <image wx:if="{{assetReady && item.skillIconPath && !failedSkillImages[item.skillId]}}" class="summary-row__icon" src="{{item.skillIconPath}}" mode="aspectFit" binderror="onImageError" data-kind="skill" data-id="{{item.skillId}}" />
            <view class="summary-row__copy">
              <text class="summary-row__name">{{item.skillName}}</text>
              <text class="summary-row__level">Lv.{{item.totalLevel}}{{item.targetLevel !== null ? ' / 目標 Lv.' + item.targetLevel : ''}}</text>
            </view>
            <status-badge
              status="{{item.targetLevel === null ? 'review' : item.isReached ? 'achieved' : 'unmet'}}"
              label="{{item.targetLevel === null ? '未設目標' : item.isReached ? '已達成' : '差 ' + item.difference}}"
            />
            <scroll-view class="summary-row__contributors" scroll-x="true" enable-flex>
              <view class="summary-row__contributors-content">
                <image wx:if="{{assetReady && !failedPortraitImages[item.officerId]}}" wx:for="{{item.contributors}}" wx:key="officerId" class="contributor-avatar" src="{{item.portraitPath}}" mode="aspectFill" binderror="onImageError" data-kind="portrait" data-id="{{item.officerId}}" />
                <text wx:if="{{item.contributors.length === 0}}" class="contributors-empty">尚無貢獻者</text>
              </view>
            </scroll-view>
          </view>
          <empty-state
            wx:if="{{skillSummary.length === 0}}"
            title="尚未配置戰鬥技能"
            description="選擇技能與航海士後，此處會顯示目前船的技能累計"
          />
        </view>
      </disclosure-section>

      <disclosure-section
        title="全艦隊摘要"
        hint="只展開目前船的工作區"
        count-label="{{fleetOverview.length}}"
        default-expanded="{{false}}"
      >
        <view class="overview-panel">
          <view wx:for="{{fleetOverview}}" wx:key="id" class="overview-row">
            <text class="overview-row__name">{{item.label}}</text>
            <text class="overview-row__count">{{item.count}} / 11</text>
            <text class="overview-row__status">{{item.statusLabel}}</text>
          </view>
        </view>
      </disclosure-section>
    </view>
   </scroll-view>

   <officer-action-sheet
     presentation="sheet"
     visible="{{officerActionSheet.visible}}"
     officer-id="{{officerActionSheet.officerId}}"
     officer-name="{{officerActionSheet.officerName}}"
     status="{{officerActionSheet.status}}"
     status-label="{{officerActionSheet.statusLabel}}"
     allow-ban="{{officerActionSheet.allowBan}}"
     disabled-actions="{{officerActionSheet.disabledActions}}"
     lock-disabled-reason="{{officerActionSheet.lockDisabledReason}}"
     remove-disabled-reason="{{officerActionSheet.removeDisabledReason}}"
     ban-disabled-reason="{{officerActionSheet.banDisabledReason}}"
     bind:dismiss="onOfficerActionDismiss"
     bind:lock="onOfficerLock"
     bind:remove="onOfficerRemove"
     bind:ban="onBanOfficer"
   />

   <result-preview-sheet
     visible="{{proposalPreview !== null}}"
     preview="{{proposalPreview}}"
     can-undo="{{canUndoProposal}}"
     bind:cancel="onProposalCancel"
     bind:apply="onProposalApply"
     bind:undo="onUndoProposal"
   />

   <skill-sheet skill="{{sheetSkill}}" bind:dismiss="onSheetDismiss" bind:reverselookup="onReverseLookup" />
</view>
