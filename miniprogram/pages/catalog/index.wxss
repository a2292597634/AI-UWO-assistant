.catalog-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #ded7c7;
}

.asset-loading-state,
.asset-load-error {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  color: #5a5a4e;
  text-align: center;
}

.asset-load-error__message {
  max-width: 640rpx;
  line-height: 1.6;
}

.asset-load-error__retry {
  margin-top: 28rpx;
  color: #f2e4bd;
  background: #34352f;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background: #e8dfce;
  border-bottom: 1rpx solid #c4b99a;
}

.search-input {
  flex: 1;
  padding: 10rpx 16rpx;
  color: #292a26;
  background: #f5efe0;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.search-clear {
  margin-left: 12rpx;
  padding: 8rpx;
  color: #756b59;
  font-size: 28rpx;
}

.tabs {
  display: flex;
  background: #2f302b;
}

.tab {
  flex: 1;
  padding: 14rpx 0 12rpx;
  color: #8a8a7e;
  font-size: 26rpx;
  text-align: center;
}

.tab--active {
  color: #e8d5a3;
  border-bottom: 4rpx solid #c4a45a;
}

/* Officer tab: one compact, image-only toolbar. */
.officer-filter-toolbar {
  box-sizing: border-box;
  width: 100%;
  height: 100rpx;
  background: #e8dfce;
  border-bottom: 1rpx solid #c4b99a;
}

.officer-filter-toolbar__content {
  display: flex;
  align-items: center;
  width: 834rpx;
  min-width: 834rpx;
  height: 100rpx;
}

.image-filter-group {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
}

.image-filter-options {
  display: flex;
  align-items: center;
}

.image-filter-option {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  opacity: 0.35;
  transition:
    opacity 120ms ease-out,
    filter 120ms ease-out;
}

.image-filter-option--on {
  opacity: 1;
  filter: drop-shadow(0 3rpx 4rpx rgba(61, 45, 17, 0.32));
}

.filter-separator {
  flex: 0 0 1rpx;
  width: 1rpx;
  height: 48rpx;
  margin: 0 10rpx;
  background: rgba(111, 98, 70, 0.32);
}

.image-filter-icon--rarity {
  width: 58rpx;
  height: 58rpx;
}

.image-filter-icon--type {
  width: 46rpx;
  height: 46rpx;
}

.image-filter-icon--gender {
  width: 42rpx;
  height: 42rpx;
}

/* Text filter tabs retain the existing immediate-toggle interaction. */
.filter-panel {
  padding: 14rpx 20rpx 8rpx;
  background: #e8dfce;
  border-bottom: 1rpx solid #c4b99a;
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
}

.filter-chips .chip {
  margin-right: 10rpx;
  margin-bottom: 8rpx;
}

.chip {
  padding: 8rpx 18rpx;
  color: #3d3d35;
  background: #d4cbb4;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.chip--on {
  color: #e8d5a3;
  background: #2f302b;
}

.skill-kind-tabs {
  display: flex;
  margin-bottom: 12rpx;
}

.kind-tab {
  flex: 1;
  margin-right: 8rpx;
  padding: 10rpx;
  color: #3d3d35;
  background: #d4cbb4;
  font-size: 24rpx;
  text-align: center;
}

.kind-tab:last-child {
  margin-right: 0;
}

.kind-tab--on {
  color: #e8d5a3;
  background: #2f302b;
}

.count-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 20rpx;
  color: #3d3d35;
  background: #d4cbb4;
  font-size: 24rpx;
}

.count-clear {
  padding: 4rpx 0 4rpx 16rpx;
  color: #8b3a3a;
}

.list {
  min-height: 0;
  flex: 1;
  overflow-y: auto;
}

.officer-row {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 10rpx 20rpx;
  border-bottom: 1rpx solid #c4b99a;
}

.officer-row:active {
  background: #d4cbb4;
}

.row-portrait {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 8rpx;
}

.row-portrait-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 92rpx;
  height: 92rpx;
}

.row-portrait-frame {
  z-index: 1;
}

.row-avatar,
.row-portrait-fb {
  z-index: 2;
}

.row-portrait-fb {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2f302b;
}

.row-portrait-initial {
  color: #e8d5a3;
  font-size: 36rpx;
  font-weight: 700;
}

.row-rarity-icon {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  width: 60rpx;
  height: 60rpx;
}

.row-type-icon {
  position: absolute;
  bottom: 4rpx;
  left: 4rpx;
  z-index: 4;
  width: 24rpx;
  height: 24rpx;
}

.row-info {
  position: relative;
  box-sizing: border-box;
  min-width: 0;
  min-height: 116rpx;
  padding-right: 320rpx;
  flex: 1;
}

.row-top {
  display: flex;
  align-items: center;
}

.row-name {
  overflow: hidden;
  color: #292a26;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-meta {
  display: flex;
  margin-top: 2rpx;
}

.row-meta .row-gender {
  margin-left: 14rpx;
}

.row-job,
.row-gender {
  color: #5a5a4e;
  font-size: 21rpx;
  line-height: 1.25;
}

.row-skills {
  position: absolute;
  top: 0;
  right: 0;
  width: 320rpx;
  min-height: 116rpx;
  height: auto;
  margin: 0;
  flex-shrink: 0;
}

.row-skills__content {
  display: inline-flex;
  align-items: center;
  min-width: 320rpx;
  min-height: 116rpx;
}

.skill-icon-group {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
}

.row-skill-hit-target {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
}

.skill-icon-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
}

.row-skill-icon {
  width: 48rpx;
  height: 48rpx;
}

.skill-level-badge {
  position: absolute;
  top: -8rpx;
  right: -10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 24rpx;
  padding: 0 4rpx;
  color: #f0e4c4;
  background: #8b3a3a;
  border: 1rpx solid #f0e4c4;
  border-radius: 10rpx;
  font-size: 16rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.skill-divider {
  width: 1rpx;
  height: 24rpx;
  margin: 0 8rpx;
  background: #c4b99a;
}

.skill-more {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 40rpx;
  height: 52rpx;
  color: #756b59;
  font-size: 20rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 24rpx;
  color: #8a8a7e;
  font-size: 28rpx;
  text-align: center;
}

.empty-title {
  display: block;
}

.empty-clear {
  margin-top: 20rpx;
  padding: 12rpx 28rpx;
  color: #f2e4bd;
  background: #34352f;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.load-more {
  padding: 24rpx;
  color: #8a8a7e;
  font-size: 22rpx;
  text-align: center;
}
