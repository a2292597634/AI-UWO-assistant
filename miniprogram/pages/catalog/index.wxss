.catalog-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #ded7c7;
}
.tabs {
  display: flex;
  background: #2f302b;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  color: #8a8a7e;
  font-size: 26rpx;
}
.tab--active {
  color: #e8d5a3;
  border-bottom: 4rpx solid #c4a45a;
}
.filter-panel {
  padding: 16rpx 24rpx;
  background: #e8dfce;
  border-bottom: 1rpx solid #c4b99a;
}
.filter-group {
  margin-bottom: 12rpx;
}
.filter-label {
  font-size: 22rpx;
  color: #6b6b5e;
  margin-bottom: 8rpx;
  display: block;
}
.filter-chips {
  display: flex;
  flex-wrap: wrap;
}
.filter-chips .chip {
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}
.chip {
  padding: 8rpx 20rpx;
  background: #d4cbb4;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #3d3d35;
}
.chip--on {
  background: #2f302b;
  color: #e8d5a3;
}
.skill-kind-tabs {
  display: flex;
  margin-bottom: 16rpx;
}
.kind-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx;
  background: #d4cbb4;
  font-size: 24rpx;
  color: #3d3d35;
  margin-right: 8rpx;
}
.kind-tab:last-child {
  margin-right: 0;
}
.kind-tab--on {
  background: #2f302b;
  color: #e8d5a3;
}
.count-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #d4cbb4;
  font-size: 24rpx;
  color: #3d3d35;
}
.count-clear {
  color: #8b3a3a;
}
.list {
  flex: 1;
  overflow-y: auto;
}
.officer-row {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-bottom: 1rpx solid #c4b99a;
  min-height: 94rpx;
}
.officer-row:active {
  background: #d4cbb4;
}
.row-portrait {
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  position: relative;
}
.row-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
}
.row-portrait-fb {
  position: absolute;
  top: 0;
  left: 0;
  width: 64rpx;
  height: 64rpx;
  background: #2f302b;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.row-portrait-initial {
  font-size: 32rpx;
  color: #e8d5a3;
  font-weight: bold;
}
.row-info {
  flex: 1;
  min-width: 0;
}
.row-top {
  display: flex;
  align-items: center;
}
.row-top .row-rarity {
  margin-left: 12rpx;
}
.row-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #292a26;
}
/* Rarity grade badges */
.rarity-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.rarity-letter {
  font-size: 22rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1;
}
.rarity-s {
  background: #c4a45a;
}
.rarity-a {
  background: #8a8a8a;
}
.rarity-b {
  background: #b87333;
}
.rarity-c {
  background: #5a5a4e;
}
.row-meta {
  display: flex;
  margin-top: 4rpx;
}
.row-meta .row-gender {
  margin-left: 16rpx;
}
.row-job {
  font-size: 22rpx;
  color: #5a5a4e;
}
.row-gender {
  font-size: 22rpx;
  color: #5a5a4e;
}
.row-skills {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}
.skill-icon-group {
  display: flex;
  align-items: center;
}
.skill-icon-group .row-skill-icon {
  margin-right: 4rpx;
}
.row-skill-icon {
  width: 32rpx;
  height: 32rpx;
}
.skill-divider {
  width: 1rpx;
  height: 24rpx;
  background: #c4b99a;
  margin: 0 8rpx;
}
.empty {
  text-align: center;
  padding: 80rpx;
  color: #8a8a7e;
  font-size: 28rpx;
}
.load-more {
  text-align: center;
  padding: 24rpx;
  color: #8a8a7e;
  font-size: 22rpx;
}
