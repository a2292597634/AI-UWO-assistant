.catalog-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 0;
  overflow: hidden;
  background: var(--uwo-color-canvas);
  color: var(--uwo-color-text-primary);
  font-family: var(--uwo-font-family-body);
}

.catalog-page__mode-tabs {
  display: flex;
  flex: 0 0 auto;
  padding: var(--uwo-space-4) var(--uwo-space-6) 0;
  background: var(--uwo-color-surface);
  border-bottom: 2rpx solid var(--uwo-color-border-subtle);
}

.catalog-page__mode-tab {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-bottom: 6rpx solid transparent;
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 600;
}

.catalog-page__mode-tab--active {
  border-bottom-color: var(--uwo-color-accent-brass);
  color: var(--uwo-color-accent-text);
}

.catalog-page__mode-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 0;
}

.catalog-page__search {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  margin: var(--uwo-space-4) var(--uwo-space-6) 0;
}

.catalog-page__search-input {
  flex: 1;
  min-height: 88rpx;
  padding: 0 var(--uwo-space-6);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface);
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-body);
}

.catalog-page__search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  margin-left: var(--uwo-space-2);
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-minimum-action);
}

.catalog-page__result-bar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 var(--uwo-space-6);
}

.catalog-page__result-count {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.catalog-page__result-actions {
  display: flex;
  align-items: center;
}

.catalog-page__filter-trigger,
.catalog-page__clear-trigger {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 var(--uwo-space-3);
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-minimum-action);
  font-weight: 600;
}

.catalog-page__clear-trigger {
  color: var(--uwo-color-danger);
}

.catalog-page__list {
  flex: 1;
  min-height: 0;
  padding: 0 var(--uwo-space-6) var(--uwo-space-6);
}

.catalog-page__officer-row {
  display: flex;
  min-height: 132rpx;
  margin-bottom: var(--uwo-space-3);
  padding: var(--uwo-space-4);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-surface);
}

.catalog-page__officer-portrait {
  position: relative;
  flex: 0 0 104rpx;
  width: 104rpx;
  height: 104rpx;
  margin-right: var(--uwo-space-4);
  overflow: hidden;
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface-muted);
}

.catalog-page__officer-portrait-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.catalog-page__officer-avatar {
  z-index: 1;
}

.catalog-page__officer-portrait-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--uwo-color-surface-muted);
}

.catalog-page__officer-portrait-initial {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-section-title);
}

.catalog-page__officer-rarity-icon,
.catalog-page__officer-type-icon {
  position: absolute;
  z-index: 2;
  right: var(--uwo-space-1);
  width: 28rpx;
  height: 28rpx;
}

.catalog-page__officer-rarity-icon {
  top: var(--uwo-space-1);
}

.catalog-page__officer-type-icon {
  bottom: var(--uwo-space-1);
}

.catalog-page__officer-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.catalog-page__officer-heading {
  display: flex;
  align-items: center;
  min-height: 36rpx;
}

.catalog-page__officer-name {
  overflow: hidden;
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.catalog-page__officer-meta {
  display: flex;
  align-items: center;
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.catalog-page__officer-job,
.catalog-page__officer-gender {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.catalog-page__officer-gender {
  margin-left: var(--uwo-space-3);
}

.catalog-page__officer-skills {
  width: 100%;
  height: 88rpx;
  margin-top: var(--uwo-space-2);
  white-space: nowrap;
}

.catalog-page__officer-skills-content {
  display: flex;
  align-items: center;
  min-width: max-content;
  height: 88rpx;
}

.catalog-page__skill-group {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
}

.catalog-page__skill-hit-target {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  flex: 0 0 88rpx;
  width: 88rpx;
  min-height: 88rpx;
  height: 88rpx;
  margin-right: var(--uwo-space-2);
}

.catalog-page__skill-icon-wrapper {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.catalog-page__skill-icon {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface-muted);
}

.catalog-page__skill-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface-muted);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
}

.catalog-page__skill-level-badge {
  position: absolute;
  right: calc(-1 * var(--uwo-space-2));
  bottom: calc(-1 * var(--uwo-space-2));
  min-width: var(--uwo-space-8);
  padding: 0 var(--uwo-space-1);
  border-radius: var(--uwo-radius-pill);
  background: var(--uwo-color-ink);
  color: var(--uwo-color-surface);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: var(--uwo-space-6);
  text-align: center;
}

.catalog-page__skill-more {
  margin-right: var(--uwo-space-2);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.catalog-page__skill-divider {
  width: 2rpx;
  height: 36rpx;
  margin: 0 var(--uwo-space-2);
  background: var(--uwo-color-border-subtle);
}

.catalog-page__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  padding: var(--uwo-space-12) var(--uwo-space-6);
}

.catalog-page__empty-title {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-body);
}

.catalog-page__empty-clear,
.catalog-page__load-more {
  margin-top: var(--uwo-space-4);
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-minimum-action);
  text-align: center;
}

.catalog-page__skill-kind-tabs {
  display: flex;
  align-items: center;
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface-muted);
}

.catalog-page__skill-kind {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  border-radius: var(--uwo-radius-control);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.catalog-page__skill-kind--active {
  background: var(--uwo-color-ink);
  color: var(--uwo-color-surface);
  font-weight: 600;
}

.catalog-page__filter-options {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.catalog-page__chip {
  min-height: 56rpx;
  margin: 0 var(--uwo-space-2) var(--uwo-space-2) 0;
  padding: var(--uwo-space-2) var(--uwo-space-4);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-pill);
  background: var(--uwo-color-surface);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.3;
}

.catalog-page__chip--active {
  border-color: var(--uwo-color-accent-brass);
  background: var(--uwo-color-accent-brass);
  color: var(--uwo-color-ink);
  font-weight: 600;
}

.catalog-page__skill-row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  margin-bottom: var(--uwo-space-3);
  padding: var(--uwo-space-4);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-surface);
}

.catalog-page__skill-row-icon {
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  margin-right: var(--uwo-space-4);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface-muted);
}

.catalog-page__skill-row-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.catalog-page__skill-row-name {
  overflow: hidden;
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.catalog-page__skill-row-category {
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.catalog-page__skill-row-badges {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: var(--uwo-space-3);
}

.catalog-page__skill-row-kind {
  min-width: 48rpx;
  padding: var(--uwo-space-1) var(--uwo-space-2);
  border-radius: var(--uwo-radius-pill);
  background: var(--uwo-color-surface-muted);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
  text-align: center;
}

.catalog-page__skill-row-kind--active {
  color: var(--uwo-color-success);
}

.catalog-page__skill-row-kind--passive {
  color: var(--uwo-color-warning);
}

.catalog-page__skill-row-count {
  margin-top: var(--uwo-space-2);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
}

.catalog-page__skill-expanded {
  margin: calc(-1 * var(--uwo-space-3)) 0 var(--uwo-space-3);
  padding: var(--uwo-space-4);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-top: 0;
  border-radius: 0 0 var(--uwo-radius-card) var(--uwo-radius-card);
  background: var(--uwo-color-surface-muted);
}

.catalog-page__skill-expanded-heading {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.catalog-page__skill-expanded-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--uwo-space-3);
}

.catalog-page__expanded-officer {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 112rpx;
  margin: 0 var(--uwo-space-3) var(--uwo-space-3) 0;
}

.catalog-page__expanded-officer-visuals {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  overflow: hidden;
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface);
}

.catalog-page__expanded-officer-frame,
.catalog-page__expanded-officer-portrait {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.catalog-page__expanded-officer-portrait {
  z-index: 1;
}

.catalog-page__expanded-officer-rarity,
.catalog-page__expanded-officer-type {
  position: absolute;
  z-index: 2;
  right: var(--uwo-space-1);
  width: 22rpx;
  height: 22rpx;
}

.catalog-page__expanded-officer-rarity {
  top: var(--uwo-space-1);
}

.catalog-page__expanded-officer-type {
  bottom: var(--uwo-space-1);
}

.catalog-page__expanded-officer-name {
  width: 100%;
  margin-top: var(--uwo-space-2);
  overflow: hidden;
  color: var(--uwo-color-text-secondary);
  font-size: 20rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.catalog-page__filter-mask {
  position: fixed;
  z-index: 10;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(38, 51, 47, 0.36);
}

.catalog-page__filter-sheet {
  width: 100%;
  max-height: 84vh;
  border-radius: var(--uwo-radius-sheet) var(--uwo-radius-sheet) 0 0;
  padding: var(--uwo-space-4) var(--uwo-space-6)
    calc(var(--uwo-space-8) + env(safe-area-inset-bottom));
  box-shadow: var(--uwo-shadow-sheet);
  background: var(--uwo-color-surface);
}

.catalog-page__filter-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto var(--uwo-space-4);
  border-radius: var(--uwo-radius-pill);
  background: var(--uwo-color-border-strong);
}

.catalog-page__filter-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--uwo-space-4);
}

.catalog-page__filter-title {
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-section-title);
  font-weight: 700;
}

.catalog-page__filter-count,
.catalog-page__filter-note {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.catalog-page__filter-section {
  padding: var(--uwo-space-4) 0;
  border-top: 2rpx solid var(--uwo-color-border-subtle);
}

.catalog-page__filter-section-title {
  display: block;
  margin-bottom: var(--uwo-space-3);
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 600;
}

.catalog-page__filter-options--icons {
  display: flex;
  flex-wrap: wrap;
}

.catalog-page__filter-icon-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 124rpx;
  min-height: 104rpx;
  margin: 0 var(--uwo-space-3) var(--uwo-space-3) 0;
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface);
}

.catalog-page__filter-icon-option--active {
  border-color: var(--uwo-color-accent-brass);
  background: var(--uwo-color-surface-muted);
  box-shadow: inset 0 0 0 2rpx var(--uwo-color-accent-brass);
}

.catalog-page__filter-icon {
  width: 44rpx;
  height: 44rpx;
}

.catalog-page__filter-icon-label {
  max-width: 112rpx;
  margin-top: var(--uwo-space-1);
  overflow: hidden;
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.catalog-page__filter-note {
  display: block;
  padding: var(--uwo-space-3) 0;
}

.catalog-page__filter-actions {
  display: flex;
  align-items: stretch;
  margin-top: var(--uwo-space-3);
}

.catalog-page__filter-action {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-left: var(--uwo-space-2);
  padding: 0 var(--uwo-space-3);
  border: 2rpx solid var(--uwo-color-border-strong);
  border-radius: var(--uwo-radius-control);
  font-size: var(--uwo-font-size-body);
  font-weight: 600;
}

.catalog-page__filter-action:first-child {
  margin-left: 0;
}

.catalog-page__filter-action--secondary {
  background: var(--uwo-color-surface);
  color: var(--uwo-color-text-primary);
}

.catalog-page__filter-action--apply {
  min-height: 88rpx;
  border-color: var(--uwo-color-ink);
  background: var(--uwo-color-ink);
  color: var(--uwo-color-surface);
}
