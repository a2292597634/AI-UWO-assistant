<view class="catalog-page">
  <!-- Search bar -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜尋航海士名稱..." value="{{searchText}}" bindinput="onSearchInput" />
    <text class="search-clear" wx:if="{{searchText.length > 0}}" bindtap="onSearchClear">✕</text>
  </view>

  <!-- Tabs -->
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="*this" class="tab {{activeTab === index ? 'tab--active' : ''}}" bindtap="onTabTap" data-index="{{index}}">{{item}}</view>
  </view>

  <!-- Tab 0: Officer filters -->
  <scroll-view class="officer-filter-toolbar" wx:if="{{activeTab === 0}}" scroll-x="true" enable-flex>
    <view class="officer-filter-toolbar__content">
      <view class="image-filter-group" aria-label="稀有度篩選">
        <view class="image-filter-options image-filter-options--rarity">
          <view wx:for="{{rarities}}" wx:key="id" class="image-filter-option {{selectedRarityMap[item.id] ? 'image-filter-option--on' : ''}}" role="button" aria-label="{{item.accessibilityLabel}}" bindtap="toggleFilter" data-field="selectedRarities" data-id="{{item.id}}">
            <image class="image-filter-icon image-filter-icon--rarity" src="{{item.iconPath}}" mode="aspectFit" />
          </view>
        </view>
      </view>
      <view class="filter-separator"></view>
      <view class="image-filter-group" aria-label="類型篩選">
        <view class="image-filter-options">
          <view wx:for="{{types}}" wx:key="id" class="image-filter-option {{selectedTypeMap[item.id] ? 'image-filter-option--on' : ''}}" role="button" aria-label="{{item.accessibilityLabel}}" bindtap="toggleFilter" data-field="selectedTypes" data-id="{{item.id}}">
            <image class="image-filter-icon image-filter-icon--type" src="{{item.iconPath}}" mode="aspectFit" />
          </view>
        </view>
      </view>
      <view class="filter-separator"></view>
      <view class="image-filter-group" aria-label="性別篩選">
        <view class="image-filter-options">
          <view wx:for="{{genders}}" wx:key="id" class="image-filter-option {{selectedGenderMap[item.id] ? 'image-filter-option--on' : ''}}" role="button" aria-label="{{item.accessibilityLabel}}" bindtap="toggleFilter" data-field="selectedGenders" data-id="{{item.id}}">
            <image class="image-filter-icon image-filter-icon--gender" src="{{item.iconPath}}" mode="aspectFit" />
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- Tab 1: Skill filters -->
  <view class="filter-panel" wx:if="{{activeTab === 1}}">
    <view class="skill-kind-tabs">
      <view class="kind-tab {{activeFilter === 'all' ? 'kind-tab--on' : ''}}" bindtap="onSkillKindTap" data-kind="all">全部</view>
      <view class="kind-tab {{activeFilter === 'active' ? 'kind-tab--on' : ''}}" bindtap="onSkillKindTap" data-kind="active">主動</view>
      <view class="kind-tab {{activeFilter === 'passive' ? 'kind-tab--on' : ''}}" bindtap="onSkillKindTap" data-kind="passive">被動</view>
    </view>
    <view class="filter-chips">
      <view wx:for="{{skillCategories}}" wx:key="id" class="chip {{selectedSkillCategoryMap[item.id] ? 'chip--on' : ''}}" bindtap="toggleSkillCategory" data-id="{{item.id}}">{{item.name}}</view>
    </view>
  </view>

  <!-- Tab 2: Language filters -->
  <view class="filter-panel" wx:if="{{activeTab === 2}}">
    <view class="filter-chips">
      <view wx:for="{{languages}}" wx:key="id" class="chip {{selectedLanguageMap[item.id] ? 'chip--on' : ''}}" bindtap="toggleFilter" data-field="selectedLanguages" data-id="{{item.id}}">{{item.name}}</view>
    </view>
  </view>

  <!-- Tab 3: Job filters -->
  <view class="filter-panel" wx:if="{{activeTab === 3}}">
    <view class="filter-chips">
      <view wx:for="{{jobs}}" wx:key="id" class="chip {{selectedJobMap[item.id] ? 'chip--on' : ''}}" bindtap="toggleFilter" data-field="selectedJobs" data-id="{{item.id}}">{{item.name}}</view>
    </view>
  </view>

  <!-- Count bar with clear -->
  <view class="count-bar">
    <text>{{filterCount}} 位航海士</text>
    <text class="count-clear" bindtap="clearFilters" wx:if="{{hasActiveFilters}}">清除篩選</text>
  </view>

  <!-- Officer list -->
  <scroll-view class="list" scroll-y bindscrolltolower="loadMore" lower-threshold="200">
    <view wx:for="{{visibleRows}}" wx:key="id" class="officer-row" bindtap="onOfficerTap" data-id="{{item.id}}">
      <view class="row-portrait">
        <image wx:if="{{item.visuals.framePath && !item.frameFail}}" src="{{item.visuals.framePath}}" mode="aspectFill" class="row-portrait-layer row-portrait-frame" binderror="onPortraitLayerError" data-index="{{index}}" data-layer="frameFail" />
        <image wx:if="{{!item.portraitFail}}" src="{{item.portraitPath}}" mode="aspectFill" class="row-portrait-layer row-avatar" binderror="onPortraitError" data-index="{{index}}" />
        <view class="row-portrait-layer row-portrait-fb" wx:else>
          <text class="row-portrait-initial">{{item.name[0]}}</text>
        </view>
        <image wx:if="{{item.visuals.rarityIconPath && !item.rarityIconFail}}" src="{{item.visuals.rarityIconPath}}" mode="aspectFit" class="row-rarity-icon" binderror="onPortraitLayerError" data-index="{{index}}" data-layer="rarityIconFail" />
        <image wx:if="{{item.visuals.typeIconPath && !item.typeIconFail}}" src="{{item.visuals.typeIconPath}}" mode="aspectFit" class="row-type-icon" binderror="onPortraitLayerError" data-index="{{index}}" data-layer="typeIconFail" />
      </view>
      <view class="row-info">
        <view class="row-top">
          <text class="row-name">{{item.name}}</text>
        </view>
        <view class="row-meta">
          <text class="row-job">{{item.jobName}}</text>
          <text class="row-gender">{{item.genderLabel}}</text>
        </view>
        <scroll-view class="row-skills" scroll-x="true" enable-flex>
          <view class="row-skills__content">
            <view class="skill-icon-group" wx:if="{{item.activeSkills.length > 0}}">
              <view wx:for="{{item.activeSkills}}" wx:key="*this" wx:for-item="sid" wx:for-index="si" class="row-skill-hit-target" wx:if="{{si < 3}}" catchtap="onSkillIconTap" data-skill-id="{{sid}}" data-kind="active">
                <image src="{{item.activeSkillIcons[sid]}}" mode="aspectFit" class="row-skill-icon" />
              </view>
              <text class="skill-more" wx:if="{{item.activeSkills.length > 3}}">+{{item.activeSkills.length - 3}}</text>
            </view>
            <view class="skill-icon-group" wx:if="{{item.passiveSkills.length > 0}}">
              <view class="skill-divider" wx:if="{{item.activeSkills.length > 0}}"></view>
              <view wx:for="{{item.passiveSkills}}" wx:key="*this" wx:for-item="sid" wx:for-index="si" class="row-skill-hit-target" wx:if="{{si < 3}}" catchtap="onSkillIconTap" data-skill-id="{{sid}}" data-kind="passive">
                <image src="{{item.passiveSkillIcons[sid]}}" mode="aspectFit" class="row-skill-icon" />
              </view>
              <text class="skill-more" wx:if="{{item.passiveSkills.length > 3}}">+{{item.passiveSkills.length - 3}}</text>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
    <view wx:if="{{visibleRows.length === 0}}" class="empty">
      <text class="empty-title">沒有符合條件的航海士</text>
      <view wx:if="{{hasActiveFilters}}" class="empty-clear" bindtap="clearFilters">清除篩選</view>
    </view>
    <view wx:elif="{{hasMore}}" class="load-more">載入更多...</view>
  </scroll-view>

  <skill-sheet skill="{{sheetSkill}}" bind:dismiss="onSheetDismiss" bind:reverselookup="onReverseLookup" />
</view>
