<view class="home-page">
  <view aria-hidden="true">
    <view class="harbor-hero {{bannerFailed ? 'harbor-hero--fallback' : ''}}">
      <image
        wx:if="{{!bannerFailed}}"
        class="harbor-hero__image"
        src="/assets/ui/home-harbor.jpg"
        mode="aspectFill"
        binderror="onBannerError"
      />
      <view class="harbor-hero__scrim"></view>
      <view class="harbor-hero__copy">
        <text class="harbor-hero__eyebrow">航海資料館</text>
        <text class="harbor-hero__title ui-display-title">{{title}}</text>
        <text class="harbor-hero__meta">收錄 {{count}} 位航海士</text>
      </view>
    </view>

    <view class="feature-hub">
      <view class="feature-hub__heading">
        <text class="feature-hub__title">啟航港口</text>
        <view class="feature-hub__rule"></view>
      </view>
      <view class="module-grid">
        <block wx:for="{{modules}}" wx:key="id">
          <view
            wx:if="{{index < 6}}"
            class="module-grid__item"
          >
            <view class="module-grid__badge">
              <image
                wx:if="{{!item.iconFailed}}"
                class="module-grid__icon {{item.id === 'battle-fleet' || item.id === 'adventure-fleet' ? 'module-grid__icon--large' : ''}}"
                src="{{item.iconPath}}"
                mode="aspectFit"
                binderror="onModuleIconError"
                data-index="{{index}}"
              />
              <view
                wx:else
                class="module-grid__icon-fallback"
                aria-label="功能圖標載入失敗"
              ></view>
            </view>
            <text class="module-grid__name">{{item.name}}</text>
          </view>
        </block>
      </view>

      <view class="feature-hub__secondary">
        <text class="feature-hub__secondary-label">交流與回報</text>
        <view class="module-grid module-grid--secondary">
          <block wx:for="{{supportEntries}}" wx:key="id">
            <view
              id="home-{{item.id}}"
              class="module-grid__item module-grid__item--secondary"
            >
              <view class="module-grid__secondary-copy">
                <text class="module-grid__name">{{item.name}}</text>
                <text class="module-grid__hint">{{item.hint}}</text>
              </view>
              <view class="module-grid__chevron" aria-hidden="true"></view>
            </view>
          </block>
        </view>
      </view>
    </view>
  </view>

  <view class="migration-gate">
    <view class="migration-gate__card">
      <text class="migration-gate__label">服務轉移通知</text>
      <text class="migration-gate__title">請前往「起源航海小助手」</text>
      <text class="migration-gate__description">
        新版已上線，請前往新版繼續使用。舊版的艦隊配置與提醒設定不會自動帶到新版。
      </text>
      <button
        class="ui-button ui-button--primary migration-gate__button"
        disabled="{{openingNewMiniProgram}}"
        bindtap="onOpenNewMiniProgram"
      >
        {{openingNewMiniProgram ? '開啟中…' : '前往新版'}}
      </button>
      <text wx:if="{{migrationError}}" class="migration-gate__error" aria-live="polite">
        暫時無法開啟新版。請重試，或在微信搜尋「起源航海小助手」。
      </text>
    </view>
  </view>
</view>
