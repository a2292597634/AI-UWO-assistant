.home-page {
  min-height: 100vh;
  background: var(--uwo-color-canvas);
  color: var(--uwo-color-text-primary);
  font-family: var(--uwo-font-family-body);
}

.harbor-hero {
  position: relative;
  height: 240rpx;
  overflow: hidden;
  background: linear-gradient(
    125deg,
    var(--uwo-color-ink) 0%,
    #405048 48%,
    var(--uwo-color-canvas) 100%
  );
}

.harbor-hero--fallback {
  background: linear-gradient(
    125deg,
    var(--uwo-color-ink) 0%,
    #405048 48%,
    var(--uwo-color-canvas) 100%
  );
}

.harbor-hero__image,
.harbor-hero__scrim {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.harbor-hero__image {
  z-index: 0;
}

.harbor-hero__scrim {
  z-index: 1;
  background: linear-gradient(
    90deg,
    rgba(38, 51, 47, 0.82) 0%,
    rgba(38, 51, 47, 0.46) 45%,
    rgba(38, 51, 47, 0.05) 78%
  );
}

.harbor-hero__copy {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  width: calc(100% - var(--uwo-space-12));
  max-width: 520rpx;
  padding: var(--uwo-space-8) var(--uwo-space-6) 0;
  color: var(--uwo-color-surface);
}

.harbor-hero__eyebrow {
  color: var(--uwo-color-accent-brass);
  font-size: var(--uwo-font-size-minimum-action);
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.harbor-hero__title {
  margin-top: var(--uwo-space-2);
  color: var(--uwo-color-surface);
  font-family: var(--uwo-font-family-display);
  font-size: var(--uwo-font-size-page-title);
  font-weight: 700;
  letter-spacing: 4rpx;
  line-height: 1.2;
}

.harbor-hero__meta {
  margin-top: var(--uwo-space-3);
  color: var(--uwo-color-surface);
  font-size: var(--uwo-font-size-supporting);
  letter-spacing: 1rpx;
}

.feature-hub {
  padding: var(--uwo-space-8) var(--uwo-space-6) var(--uwo-space-12);
}

.feature-hub__heading {
  display: flex;
  align-items: center;
  gap: var(--uwo-space-4);
  margin: 0 var(--uwo-space-2) var(--uwo-space-6);
}

.feature-hub__title {
  color: var(--uwo-color-ink);
  font-size: var(--uwo-font-size-section-title);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.feature-hub__rule {
  flex: 1;
  height: 1rpx;
  background: var(--uwo-color-accent-brass);
  opacity: 0.65;
}

.module-grid {
  display: flex;
  flex-wrap: wrap;
}

.module-grid__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  width: 33.3333%;
  min-height: 156rpx;
  padding: var(--uwo-space-2) 0;
  border-radius: var(--uwo-radius-control);
}

.module-grid__item:active {
  background: rgba(185, 149, 82, 0.14);
}

.module-grid__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
}

.module-grid__icon,
.module-grid__icon-fallback {
  width: 96rpx;
  height: 96rpx;
}

.module-grid__icon-fallback {
  position: relative;
  border: 3rpx solid var(--uwo-color-accent-brass);
  border-radius: 50%;
}

.module-grid__icon-fallback::before,
.module-grid__icon-fallback::after {
  position: absolute;
  top: 50%;
  left: 50%;
  display: block;
  width: 58rpx;
  height: 3rpx;
  background: var(--uwo-color-accent-brass);
  content: '';
  transform: translate(-50%, -50%);
}

.module-grid__icon-fallback::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

.module-grid__name {
  margin-top: var(--uwo-space-2);
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.4;
  text-align: center;
  overflow-wrap: anywhere;
}

.feature-hub__secondary {
  margin-top: var(--uwo-space-4);
  padding-top: var(--uwo-space-4);
  border-top: 2rpx solid var(--uwo-color-border-subtle);
}

.feature-hub__secondary-label {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.4;
}

.module-grid--secondary {
  margin-top: var(--uwo-space-2);
}

.module-grid__item--secondary {
  flex-direction: row;
  justify-content: flex-start;
  width: 100%;
  min-height: 112rpx;
  padding: var(--uwo-space-2) var(--uwo-space-4);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-surface);
}

.module-grid__item--secondary .module-grid__badge {
  flex: 0 0 80rpx;
  width: 80rpx;
  height: 80rpx;
}

.module-grid__item--secondary .module-grid__icon,
.module-grid__item--secondary .module-grid__icon-fallback {
  width: 72rpx;
  height: 72rpx;
}

.module-grid__secondary-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  margin-left: var(--uwo-space-3);
}

.module-grid__item--secondary .module-grid__name {
  margin-top: 0;
  font-size: var(--uwo-font-size-emphasis);
  text-align: left;
}

.module-grid__hint {
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.4;
  overflow-wrap: anywhere;
}
