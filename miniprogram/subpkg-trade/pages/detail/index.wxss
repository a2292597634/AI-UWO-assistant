.trade-detail {
  min-height: 100vh;
  padding-bottom: calc(var(--uwo-space-12) + env(safe-area-inset-bottom));
  background: var(--uwo-color-canvas);
  color: var(--uwo-color-text-primary);
  font-family: var(--uwo-font-family-body);
}

.trade-detail__header {
  display: flex;
  flex-direction: column;
  padding: var(--uwo-space-8) var(--uwo-space-6) var(--uwo-space-6);
  background: var(--uwo-color-ink);
  color: var(--uwo-color-surface);
}

.trade-detail__eyebrow {
  color: var(--uwo-color-accent-brass);
  font-size: var(--uwo-font-size-minimum-action);
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.trade-detail__title {
  margin-top: var(--uwo-space-2);
  color: var(--uwo-color-surface);
  font-family: var(--uwo-font-family-display);
  font-size: var(--uwo-font-size-page-title);
  font-weight: 700;
  letter-spacing: 3rpx;
  line-height: 1.25;
}

.trade-detail__meta,
.trade-detail__summary {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.trade-detail__meta {
  margin-top: var(--uwo-space-3);
  color: var(--uwo-color-surface);
  font-size: var(--uwo-font-size-supporting);
  opacity: 0.86;
}

.trade-detail__separator {
  margin: 0 var(--uwo-space-2);
  color: var(--uwo-color-accent-brass);
}

.trade-detail__summary {
  gap: var(--uwo-space-4);
  margin-top: var(--uwo-space-4);
}

.trade-detail__summary-item {
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.45;
}

.trade-detail__summary-item--peak {
  color: var(--uwo-color-accent-brass);
}

.trade-detail__summary-item--low {
  color: var(--uwo-color-surface);
  opacity: 0.86;
}

.trade-detail__current {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--uwo-space-3);
  padding: var(--uwo-space-4) var(--uwo-space-6);
  border-bottom: 2rpx solid var(--uwo-color-border-subtle);
  background: var(--uwo-color-surface);
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-body);
  font-weight: 700;
}

.trade-detail__current-note {
  max-width: 52%;
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
  font-weight: 400;
  line-height: 1.4;
  text-align: right;
}

.trade-legend {
  margin: var(--uwo-space-4) var(--uwo-space-6) 0;
  padding: var(--uwo-space-4);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-surface);
}

.trade-legend__heading,
.trade-legend__status,
.trade-legend__seasons,
.trade-legend__season {
  display: flex;
  align-items: center;
}

.trade-legend__heading {
  justify-content: space-between;
  gap: var(--uwo-space-3);
}

.trade-legend__title {
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 700;
}

.trade-legend__status {
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: var(--uwo-space-2);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
}

.trade-legend__seasons {
  flex-wrap: wrap;
  gap: var(--uwo-space-2) var(--uwo-space-4);
  margin-top: var(--uwo-space-3);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
}

.trade-legend__season {
  gap: var(--uwo-space-1);
}

.trade-legend__glyph {
  font-size: var(--uwo-font-size-body);
}

.trade-matrix {
  margin: var(--uwo-space-4) var(--uwo-space-6) 0;
}

.trade-matrix__heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--uwo-space-3);
  margin: 0 var(--uwo-space-2) var(--uwo-space-3);
}

.trade-matrix__title {
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 700;
}

.trade-matrix__hint {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
  text-align: right;
}

.trade-month-grid {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  width: 100%;
}

.trade-month-heading,
.trade-month-cell {
  min-width: 0;
  overflow: hidden;
  text-align: center;
}

.trade-month-heading {
  padding: var(--uwo-space-2) 0;
  border-top: 2rpx solid var(--uwo-color-border-subtle);
  border-bottom: 2rpx solid var(--uwo-color-border-subtle);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.3;
  white-space: nowrap;
}

.trade-month-heading--current {
  background: var(--uwo-color-accent-brass);
  color: var(--uwo-color-ink);
  font-weight: 700;
}

.trade-port-card {
  margin-top: var(--uwo-space-4);
  padding: var(--uwo-space-3);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-surface);
}

.trade-port-card__header {
  display: flex;
  align-items: baseline;
  min-width: 0;
  padding-bottom: var(--uwo-space-2);
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-supporting);
  font-weight: 700;
  line-height: 1.4;
}

.trade-port-card__region {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
  font-weight: 400;
}

.trade-month-cell {
  display: flex;
  min-height: 76rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--uwo-space-1) 0;
  border-right: 1rpx solid var(--uwo-color-border-subtle);
  background: var(--uwo-color-surface-muted);
}

.trade-month-cell:last-child {
  border-right: 0;
}

.trade-month-cell--peak {
  background: rgba(185, 149, 82, 0.18);
}

.trade-month-cell--low {
  background: rgba(139, 58, 58, 0.1);
}

.trade-month-cell--unknown {
  background: var(--uwo-color-surface-muted);
}

.trade-month-cell--current {
  box-shadow: inset 0 0 0 4rpx var(--uwo-color-accent-brass);
}

.trade-month-cell__season {
  display: block;
  font-size: 24rpx;
  line-height: 1.2;
}

.trade-month-cell__status {
  display: block;
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  font-size: 20rpx;
  line-height: 1.2;
}

.trade-detail__empty,
.trade-detail__state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 260rpx;
  margin: var(--uwo-space-6);
  padding: var(--uwo-space-8) var(--uwo-space-6);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-surface);
  text-align: center;
}

.trade-detail__empty-title,
.trade-detail__state-title {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-body);
  line-height: 1.5;
}

.trade-detail__empty-hint {
  margin-top: var(--uwo-space-2);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.trade-detail__state--error .trade-detail__state-title {
  color: var(--uwo-color-danger);
}

.trade-detail__retry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 144rpx;
  min-height: 88rpx;
  margin-top: var(--uwo-space-4);
  padding: 0 var(--uwo-space-4);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-ink);
  color: var(--uwo-color-surface);
  font-size: var(--uwo-font-size-body);
  font-weight: 600;
}

@media (max-width: 360px) {
  .trade-detail__current {
    align-items: flex-start;
    flex-direction: column;
  }

  .trade-detail__current-note {
    max-width: 100%;
    text-align: left;
  }

  .trade-matrix__heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .trade-matrix__hint {
    text-align: left;
  }

  .trade-month-heading {
    padding: var(--uwo-space-1) 0;
    font-size: 20rpx;
  }

  .trade-month-cell {
    min-height: 64rpx;
    padding: 2rpx 0;
  }

  .trade-month-cell__season {
    font-size: 20rpx;
  }

  .trade-month-cell__status {
    margin-top: 0;
    font-size: 18rpx;
  }
}
