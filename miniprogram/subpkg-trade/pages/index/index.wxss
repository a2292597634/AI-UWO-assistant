.trade-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--uwo-color-canvas);
  color: var(--uwo-color-text-primary);
  font-family: var(--uwo-font-family-body);
}

.trade-page__header {
  display: flex;
  flex-direction: column;
  padding: var(--uwo-space-8) var(--uwo-space-6) var(--uwo-space-4);
  background: var(--uwo-color-ink);
  color: var(--uwo-color-surface);
}

.trade-page__eyebrow {
  color: var(--uwo-color-accent-brass);
  font-size: var(--uwo-font-size-minimum-action);
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.trade-page__title {
  margin-top: var(--uwo-space-2);
  color: var(--uwo-color-surface);
  font-size: var(--uwo-font-size-page-title);
  font-weight: 700;
  letter-spacing: 3rpx;
  line-height: 1.25;
}

.trade-page__description {
  margin-top: var(--uwo-space-3);
  color: var(--uwo-color-surface);
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.5;
  opacity: 0.8;
}

.trade-page__search-wrap {
  display: flex;
  align-items: center;
  padding: var(--uwo-space-4) var(--uwo-space-6) var(--uwo-space-2);
  background: var(--uwo-color-surface);
}

.trade-search {
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  padding: 0 var(--uwo-space-4);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface-muted);
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-body);
}

.trade-search__clear {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  margin-left: var(--uwo-space-2);
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-minimum-action);
  text-align: center;
}

.trade-page__content {
  flex: 1;
  min-height: 0;
  background: var(--uwo-color-canvas);
}

.trade-page__section-heading,
.trade-results__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trade-page__section-heading {
  padding: var(--uwo-space-4) var(--uwo-space-6) var(--uwo-space-2);
}

.trade-page__section-title,
.trade-results__title {
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 700;
}

.trade-page__result-count,
.trade-results__hint {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
}

.trade-filters {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: var(--uwo-space-2);
  padding: 0 var(--uwo-space-6) var(--uwo-space-4);
}

.trade-filter {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: var(--uwo-space-2) var(--uwo-space-1);
  border: 1rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.3;
  text-align: center;
}

.trade-filter--active {
  border-color: var(--uwo-color-ink);
  background: var(--uwo-color-ink);
  color: var(--uwo-color-surface);
}

.trade-results {
  padding: 0 var(--uwo-space-6) var(--uwo-space-8);
}

.trade-results__heading {
  margin: 0 var(--uwo-space-2) var(--uwo-space-3);
}

.trade-result {
  display: flex;
  align-items: center;
  gap: var(--uwo-space-2);
  margin-bottom: var(--uwo-space-2);
  padding: var(--uwo-space-2);
  border: 1rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-surface);
}

.trade-result:active {
  background: var(--uwo-color-surface-muted);
}

.trade-result__icon-wrap {
  display: flex;
  flex: 0 0 112rpx;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface-muted);
  overflow: hidden;
}

.trade-result__icon {
  width: 100%;
  height: 100%;
}

.trade-result__icon-fallback {
  padding: var(--uwo-space-2);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.4;
  text-align: center;
}

.trade-result__body {
  flex: 1;
  min-width: 0;
}

.trade-result__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--uwo-space-2);
}

.trade-result__name {
  min-width: 0;
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 700;
  line-height: 1.4;
}

.trade-result__rank {
  flex: 0 0 auto;
  padding: var(--uwo-space-1) var(--uwo-space-2);
  border-radius: var(--uwo-radius-pill);
  background: var(--uwo-color-surface-muted);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
}

.trade-result__meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.3;
}

.trade-result__separator {
  margin: 0 var(--uwo-space-2);
  color: var(--uwo-color-accent-brass);
}

.trade-result__seasons {
  display: flex;
  flex-wrap: wrap;
  gap: var(--uwo-space-1) var(--uwo-space-2);
  margin-top: var(--uwo-space-1);
}

.trade-result__season {
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.3;
}

.trade-result__season--peak {
  color: var(--uwo-color-success);
}

.trade-result__season--low {
  color: var(--uwo-color-danger);
}

.trade-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  padding: var(--uwo-space-8) var(--uwo-space-6);
  text-align: center;
}

.trade-empty__title {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-body);
}

.trade-empty__hint {
  margin-top: var(--uwo-space-2);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.trade-empty--error .trade-empty__title {
  color: var(--uwo-color-danger);
}
