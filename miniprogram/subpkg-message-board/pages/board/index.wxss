.message-board-page {
  min-height: 100vh;
  padding: var(--uwo-space-8);
  padding-bottom: calc(var(--uwo-space-12) + env(safe-area-inset-bottom));
}

.message-board-page__heading,
.message-board-page__status,
.message-board-page__rules,
.message-board-page__rule,
.message-board-page__actions {
  display: flex;
  flex-direction: column;
}

.message-board-page__heading {
  gap: var(--uwo-space-3);
}

.message-board-page__eyebrow {
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-supporting);
}

.message-board-page__title {
  color: var(--uwo-color-ink);
  font-size: var(--uwo-font-size-page-title);
  font-weight: 700;
  line-height: 1.4;
}

.message-board-page__intro,
.message-board-page__status-copy,
.message-board-page__rule-copy {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-body);
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.message-board-page__status {
  gap: var(--uwo-space-4);
  margin-top: var(--uwo-space-8);
  padding: var(--uwo-space-6);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-surface);
}

.message-board-page__rules {
  gap: var(--uwo-space-6);
  margin-top: var(--uwo-space-8);
}

.message-board-page__section-title {
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-section-title);
  font-weight: 600;
}

.message-board-page__rule {
  gap: var(--uwo-space-2);
}

.message-board-page__rule-title {
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 600;
}

.message-board-page__actions {
  gap: var(--uwo-space-4);
  margin-top: var(--uwo-space-8);
}
