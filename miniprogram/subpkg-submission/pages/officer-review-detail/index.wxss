.detail-page {
  box-sizing: border-box;
  width: 100%;
  height: 100vh;
  padding: 0 var(--uwo-space-4) calc(var(--uwo-space-12) + env(safe-area-inset-bottom));
  background: var(--uwo-color-canvas);
  color: var(--uwo-color-text-primary);
  font-family: var(--uwo-font-family-body);
}

.detail-message,
.message-panel {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: var(--uwo-space-3);
  margin-top: var(--uwo-space-8);
  padding: var(--uwo-space-8) var(--uwo-space-6);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-surface);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-body);
  text-align: center;
}

.message-panel--error {
  align-items: flex-start;
  border-color: var(--uwo-color-danger);
  text-align: left;
}

.message-panel__text {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.message-panel__action {
  width: 100%;
  margin: var(--uwo-space-2) 0 0;
}

.detail-header {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--uwo-space-4);
  padding: var(--uwo-space-8) var(--uwo-space-2) var(--uwo-space-6);
}

.detail-header__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: var(--uwo-space-2);
}

.detail-header__eyebrow {
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-supporting);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.detail-header__title {
  color: var(--uwo-color-ink);
  font-size: var(--uwo-font-size-page-title);
  font-weight: 700;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.detail-header__meta {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
  overflow-wrap: anywhere;
}

.detail-notice {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: var(--uwo-space-1);
  margin-bottom: var(--uwo-space-4);
  padding: var(--uwo-space-4);
  border-left: 4rpx solid var(--uwo-color-warning);
  background: var(--uwo-color-surface);
}

.detail-notice--error {
  border-left-color: var(--uwo-color-danger);
}

.detail-notice__title {
  color: var(--uwo-color-warning);
  font-size: var(--uwo-font-size-body);
  font-weight: 600;
}

.detail-notice--error .detail-notice__title {
  color: var(--uwo-color-danger);
}

.detail-notice__text,
.detail-action-panel__hint {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.detail-panel,
.detail-action-panel {
  min-width: 0;
  margin-bottom: var(--uwo-space-4);
  padding: var(--uwo-space-6);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-surface);
}

.detail-panel--optional {
  background: var(--uwo-color-surface-muted);
}

.detail-panel--internal {
  background: var(--uwo-color-surface-muted);
}

.detail-panel__internal-meta {
  margin-bottom: var(--uwo-space-4);
}

.canonical-preview {
  min-width: 0;
  padding: var(--uwo-space-4);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-canvas);
}

.canonical-preview__title {
  display: block;
  margin-bottom: var(--uwo-space-2);
  color: var(--uwo-color-ink);
  font-size: var(--uwo-font-size-body);
  font-weight: 700;
}

.canonical-preview__text {
  display: block;
  color: var(--uwo-color-text-secondary);
  font-family: var(--uwo-font-family-body);
  font-size: var(--uwo-font-size-minimum-action);
  line-height: 1.5;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.detail-panel__heading {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: var(--uwo-space-1);
  margin-bottom: var(--uwo-space-6);
}

.detail-panel__heading--row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: var(--uwo-space-4);
}

.detail-panel__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: var(--uwo-space-1);
}

.detail-panel__title {
  color: var(--uwo-color-ink);
  font-size: var(--uwo-font-size-section-title);
  font-weight: 700;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.detail-panel__hint {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.form-grid {
  display: flex;
  min-width: 0;
  gap: var(--uwo-space-4);
}

.form-grid > .form-field,
.skill-entry__level-field {
  flex: 1;
  min-width: 0;
}

.form-field {
  min-width: 0;
  margin-bottom: var(--uwo-space-6);
}

.form-field__label {
  display: block;
  margin-bottom: var(--uwo-space-2);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-body);
  font-weight: 600;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.form-input,
.form-picker,
.form-textarea {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface-muted);
  color: var(--uwo-color-text-primary);
  font-family: var(--uwo-font-family-body);
  font-size: var(--uwo-font-size-body);
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.form-input {
  height: 88rpx;
  padding: 0 var(--uwo-space-4);
}

.form-input--search {
  margin-bottom: var(--uwo-space-2);
}

.form-input--number {
  width: 136rpx;
  max-width: 100%;
  text-align: center;
}

.form-picker {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  padding: var(--uwo-space-2) var(--uwo-space-4);
}

.form-textarea {
  min-height: 136rpx;
  padding: var(--uwo-space-4);
}

.portrait-upload {
  display: flex;
  box-sizing: border-box;
  width: 240rpx;
  max-width: 100%;
  height: 240rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx dashed var(--uwo-color-border-strong);
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-surface-muted);
}

.portrait-upload__image {
  width: 100%;
  height: 100%;
}

.portrait-upload__label,
.portrait-upload__meta {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.4;
  text-align: center;
  overflow-wrap: anywhere;
}

.portrait-upload__actions {
  display: flex;
  min-width: 0;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--uwo-space-2);
  margin-top: var(--uwo-space-2);
}

.portrait-upload__actions .text-action {
  min-height: 64rpx;
}

.text-action {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  padding: 0 var(--uwo-space-2);
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-minimum-action);
  font-weight: 600;
  text-align: center;
  overflow-wrap: anywhere;
}

.text-action--danger,
.chip__remove {
  color: var(--uwo-color-danger);
}

.compact-button {
  flex: 0 0 auto;
  min-width: 136rpx;
  margin: 0;
  padding-right: var(--uwo-space-3);
  padding-left: var(--uwo-space-3);
}

.entry-row,
.picker-action-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: var(--uwo-space-3);
  margin-bottom: var(--uwo-space-3);
}

.entry-row__picker,
.picker-action-row__picker {
  flex: 1;
  min-width: 0;
}

.level-control {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: var(--uwo-space-1);
}

.level-control__label {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.entry-row__remove {
  flex: 0 0 auto;
}

.skill-entry {
  min-width: 0;
  margin-bottom: var(--uwo-space-4);
  padding: var(--uwo-space-4);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-control);
  background: var(--uwo-color-surface-muted);
}

.skill-entry__topline,
.skill-entry__levels {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: var(--uwo-space-4);
}

.skill-entry__topline {
  justify-content: space-between;
  margin-bottom: var(--uwo-space-2);
}

.skill-entry__levels {
  align-items: flex-start;
  margin-top: var(--uwo-space-4);
}

.skill-entry__title {
  min-width: 0;
  color: var(--uwo-color-ink);
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 600;
  overflow-wrap: anywhere;
}

.skill-entry__kind {
  display: block;
  margin-top: var(--uwo-space-2);
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-supporting);
  font-weight: 600;
}

.chip-list {
  display: flex;
  min-width: 0;
  flex-wrap: wrap;
  gap: var(--uwo-space-2);
  margin-bottom: var(--uwo-space-3);
}

.chip {
  display: inline-flex;
  max-width: 100%;
  align-items: center;
  gap: var(--uwo-space-2);
  padding: var(--uwo-space-2) var(--uwo-space-3);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-pill);
  background: var(--uwo-color-surface);
}

.chip__label {
  max-width: 100%;
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-supporting);
  overflow-wrap: anywhere;
}

.chip__remove {
  font-size: var(--uwo-font-size-minimum-action);
}

.detail-action-panel {
  background: var(--uwo-color-ink);
}

.detail-action-panel__buttons {
  display: flex;
  min-width: 0;
  gap: var(--uwo-space-3);
  margin-top: var(--uwo-space-4);
}

.detail-action-panel__buttons .ui-button {
  flex: 1;
  min-width: 0;
}

.detail-action-panel__hint {
  display: block;
  margin-top: var(--uwo-space-3);
  color: var(--uwo-color-surface-muted);
}

.read-grid {
  display: flex;
  min-width: 0;
  flex-wrap: wrap;
  gap: var(--uwo-space-4);
  margin-bottom: var(--uwo-space-6);
}

.read-item {
  flex: 1 1 40%;
  min-width: 0;
}

.read-item--wide {
  flex-basis: 100%;
}

.read-item__label {
  display: block;
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.read-item__value,
.read-line__name,
.read-line__value,
.read-skill__name,
.read-skill__level,
.read-paragraph {
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-body);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.read-item__value {
  display: block;
  margin-top: var(--uwo-space-1);
  font-weight: 600;
}

.read-line,
.read-skill {
  min-width: 0;
  padding: var(--uwo-space-3) 0;
  border-bottom: 2rpx solid var(--uwo-color-border-subtle);
}

.read-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--uwo-space-3);
}

.read-skill__heading {
  display: flex;
  min-width: 0;
  justify-content: space-between;
  gap: var(--uwo-space-3);
}

.read-skill__name {
  min-width: 0;
  font-weight: 600;
}

.read-skill__meta {
  display: block;
  margin-top: var(--uwo-space-1);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  overflow-wrap: anywhere;
}

.read-paragraph {
  display: block;
  margin-bottom: var(--uwo-space-2);
}

.detail-resubmit,
.detail-back {
  width: 100%;
  margin-bottom: var(--uwo-space-4);
}

.page-bottom-spacer {
  height: var(--uwo-space-8);
}

@media screen and (max-width: 680rpx) {
  .detail-header,
  .detail-panel__heading--row,
  .form-grid,
  .skill-entry__levels,
  .detail-action-panel__buttons {
    align-items: stretch;
    flex-direction: column;
  }

  .detail-action-panel__buttons .ui-button {
    flex: 0 0 auto;
  }
}
