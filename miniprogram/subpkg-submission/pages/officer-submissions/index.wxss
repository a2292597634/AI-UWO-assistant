.submissions-page {
  box-sizing: border-box;
  width: 100%;
  height: 100vh;
  padding: 0 var(--uwo-space-4) calc(var(--uwo-space-12) + env(safe-area-inset-bottom));
  background: var(--uwo-color-canvas);
  color: var(--uwo-color-text-primary);
  font-family: var(--uwo-font-family-body);
}

.submissions-header {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--uwo-space-4);
  padding: var(--uwo-space-8) var(--uwo-space-2) var(--uwo-space-6);
}

.submissions-header__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: var(--uwo-space-2);
}

.submissions-header__eyebrow {
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-supporting);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.submissions-header__title {
  color: var(--uwo-color-ink);
  font-size: var(--uwo-font-size-page-title);
  font-weight: 700;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.submissions-header__hint,
.message-panel__text {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.header-action {
  flex: 0 0 200rpx;
  width: auto;
  margin: 0;
}

.submissions-message,
.message-panel {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: var(--uwo-space-3);
  margin-bottom: var(--uwo-space-4);
  padding: var(--uwo-space-8) var(--uwo-space-6);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-surface);
  text-align: center;
}

.submissions-message {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-body);
}

.message-panel--error {
  align-items: flex-start;
  border-color: var(--uwo-color-danger);
  text-align: left;
}

.message-panel__title {
  color: var(--uwo-color-ink);
  font-size: var(--uwo-font-size-section-title);
  font-weight: 700;
}

.message-panel__action {
  width: 100%;
  margin: var(--uwo-space-2) 0 0;
}

.submission-card {
  min-width: 0;
  margin-bottom: var(--uwo-space-3);
  padding: var(--uwo-space-4);
  border: 2rpx solid var(--uwo-color-border-subtle);
  border-radius: var(--uwo-radius-card);
  background: var(--uwo-color-surface);
}

.submission-card:active {
  opacity: 0.88;
  transform: translateY(2rpx);
}

.submission-card__heading,
.submission-card__title-wrap,
.submission-card__meta {
  display: flex;
  min-width: 0;
  align-items: center;
}

.submission-card__heading {
  justify-content: space-between;
  gap: var(--uwo-space-3);
}

.submission-card__title-wrap {
  flex: 1;
  flex-wrap: wrap;
  gap: var(--uwo-space-2);
}

.submission-card__title {
  max-width: 100%;
  color: var(--uwo-color-ink);
  font-size: var(--uwo-font-size-emphasis);
  font-weight: 700;
  overflow-wrap: anywhere;
}

.submission-card__revision {
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-minimum-action);
}

.submission-card__meta {
  flex-wrap: wrap;
  gap: var(--uwo-space-2) var(--uwo-space-4);
  margin-top: var(--uwo-space-2);
  color: var(--uwo-color-text-secondary);
  font-size: var(--uwo-font-size-supporting);
}

.submission-card__reason {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: var(--uwo-space-1);
  margin-top: var(--uwo-space-3);
  padding: var(--uwo-space-3);
  border-left: 4rpx solid var(--uwo-color-danger);
  background: var(--uwo-color-surface-muted);
}

.submission-card__reason-label {
  color: var(--uwo-color-danger);
  font-size: var(--uwo-font-size-minimum-action);
  font-weight: 600;
}

.submission-card__reason-text {
  color: var(--uwo-color-text-primary);
  font-size: var(--uwo-font-size-body);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.submission-card__next {
  display: block;
  margin-top: var(--uwo-space-3);
  color: var(--uwo-color-accent-text);
  font-size: var(--uwo-font-size-supporting);
  font-weight: 600;
  text-align: right;
  overflow-wrap: anywhere;
}

.page-bottom-spacer {
  height: var(--uwo-space-8);
}

@media screen and (max-width: 680rpx) {
  .submissions-header {
    flex-direction: column;
  }

  .header-action {
    flex-basis: auto;
    width: 100%;
  }

  .submission-card__heading {
    align-items: flex-start;
    flex-direction: column;
  }
}
