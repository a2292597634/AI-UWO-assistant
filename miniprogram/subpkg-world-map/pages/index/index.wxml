<template name="map-trade">
  <button
    class="map-trade map-trade--{{kind}}"
    data-trade-id="{{trade.id}}"
    bindtap="onTradeTap"
    aria-label="{{trade.name}}{{trade.quantity ? '，數量 ' + trade.quantity : ''}}，查看交易品詳情"
  >
    <view class="map-trade__thumb" aria-hidden="true">
      <image wx:if="{{trade.icon}}" class="map-trade__sprite" style="{{trade.icon.style}}" src="{{trade.icon.path}}" mode="scaleToFill" />
      <view wx:else class="map-trade__fallback"></view>
    </view>
    <view class="map-trade__copy">
      <text class="map-trade__name">{{trade.name}}</text>
      <text wx:if="{{trade.conditions}}" class="map-trade__conditions">{{trade.conditions}}</text>
    </view>
    <text wx:if="{{trade.quantity}}" class="map-trade__quantity">×{{trade.quantity}}</text>
    <view wx:if="{{kind !== 'material'}}" class="map-trade__arrow" aria-hidden="true"></view>
  </button>
</template>

<template name="map-findings">
  <view wx:if="{{items.length}}" class="map-sheet__section">
    <text class="map-sheet__section-title">{{title}}（{{items.length}}）</text>
    <view class="map-sheet__findings">
      <text wx:for="{{items}}" wx:key="id" class="map-sheet__finding">{{item.name}}</text>
    </view>
  </view>
</template>

<view class="map">
  <view class="map__header">
    <view class="map-search">
      <view class="map-search__icon" aria-hidden="true"></view>
      <input
        class="map-search__input"
        placeholder="搜尋港口或探索點"
        aria-label="搜尋港口或探索點"
        value="{{query}}"
        bindinput="onSearch"
        confirm-type="search"
        maxlength="40"
      />
      <button
        wx:if="{{query}}"
        class="map-search__clear"
        aria-label="清除搜尋"
        bindtap="closePanels"
      >×</button>
    </view>
    <view class="map-layers" aria-label="地圖圖層">
      <button
        wx:for="{{layers}}"
        wx:key="id"
        id="map-layer-{{item.id}}"
        class="map-layers__button {{layer === item.id ? 'map-layers__button--selected' : ''}}"
        aria-label="{{item.label}}{{layer === item.id ? '，已選取' : ''}}"
        bindtap="onLayerTap"
        data-layer="{{item.id}}"
      >{{item.label}}</button>
    </view>
  </view>

  <view wx:if="{{query}}" class="map-results">
      <text class="map-results__heading" role="status">
        {{matchCount ? ('找到 ' + matchCount + ' 個點位' + (matchCount > 40 ? '，顯示前 40 個' : '')) : '找不到符合的點位'}}
      </text>
      <scroll-view
        wx:if="{{matches.length}}"
        scroll-y
        class="map-results__list"
        style="height: {{matches.length < 4 ? matches.length * 104 + 'rpx' : '33vh'}}"
      >
        <button
          wx:for="{{matches}}"
          wx:key="id"
          class="map-results__row"
          bindtap="onResultTap"
          data-id="{{item.id}}"
        >
          <text>{{item.name}}</text>
          <text class="map-results__caption">{{item.caption}}</text>
        </button>
      </scroll-view>
  </view>

  <view class="map__viewport">
    <canvas
      id="world-chart"
      type="2d"
      class="map__canvas"
      aria-label="互動海圖，可拖動、雙指縮放，點按標記查看資料"
      bindtouchstart="onTouchStart"
      catchtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      bindtouchcancel="onTouchCancel"
    ></canvas>
  </view>

  <view wx:if="{{detail || nearby.length}}" class="map-sheet">
      <view class="map-sheet__header">
        <view>
          <text class="map-sheet__title">{{detail ? detail.title : '附近點位'}}</text>
          <text wx:if="{{detail}}" class="map-results__caption">{{detail.caption}}</text>
        </view>
        <button class="map-sheet__close" aria-label="關閉點位資料" bindtap="closePanels">×</button>
      </view>
      <scroll-view
        wx:if="{{detail}}"
        scroll-y
        class="map-sheet__scroll map-sheet__scroll--detail {{detail.layer === 'port' || detail.layer === 'village' || detail.resources.length ? 'map-sheet__scroll--expanded' : ''}}"
        scroll-into-view="map-detail-start-{{detail.id}}"
      >
        <view id="map-detail-start-{{detail.id}}" class="map-sheet__coordinates">
          <view class="map-sheet__row"><text>海圖經緯</text><text>{{detail.coordinates}}</text></view>
          <view class="map-sheet__row map-sheet__source"><text>{{detail.accuracy}}</text><text>來源 {{detail.sourceCoordinates}}</text></view>
        </view>
        <view wx:if="{{detail.languages || detail.belief}}" class="map-sheet__facts">
          <text wx:if="{{detail.languages}}">語言 · {{detail.languages}}</text>
          <text wx:if="{{detail.belief}}">信仰 · {{detail.belief}}</text>
        </view>

        <view wx:if="{{detail.layer === 'port'}}" class="map-sheet__section">
          <text class="map-sheet__section-title">交易品（{{detail.goods.length}}）</text>
          <template wx:for="{{detail.goods}}" wx:key="id" is="map-trade" data="{{ trade: item, kind: 'port' }}" />
          <text wx:if="{{!detail.goods.length}}" class="map-sheet__empty">目前未收錄此港的交易品</text>
        </view>

        <template is="map-findings" data="{{ title: '採集物', items: detail.resources }}" />
        <template is="map-findings" data="{{ title: '村莊發現物', items: detail.discoveries }}" />

        <view wx:if="{{detail.layer === 'village'}}" class="map-sheet__section map-sheet__barters">
          <text class="map-sheet__section-title">村莊換貨（{{detail.barters.length}}）</text>
          <text wx:if="{{!detail.barters.length}}" class="map-sheet__empty">目前未收錄此點位的換貨資料</text>
          <view wx:for="{{detail.barters}}" wx:for-item="exchange" wx:key="id" class="map-barter">
            <template is="map-trade" data="{{ trade: exchange.product, kind: 'barter' }}" />
            <view wx:if="{{exchange.conditions || exchange.maxQuantity}}" class="map-barter__conditions">
              <text wx:if="{{exchange.conditions}}">條件 · {{exchange.conditions}}</text>
              <text wx:if="{{exchange.maxQuantity}}">單次交換上限 · {{exchange.maxQuantity}}</text>
            </view>
            <text class="map-barter__label">所需交易品</text>
            <view class="map-barter__materials">
              <template wx:for="{{exchange.requirements}}" wx:key="id" is="map-trade" data="{{ trade: item, kind: 'material' }}" />
            </view>
          </view>
        </view>
      </scroll-view>
      <scroll-view wx:else scroll-y class="map-sheet__scroll">
        <button
          wx:for="{{nearby}}"
          wx:key="id"
          class="map-results__row"
          bindtap="onResultTap"
          data-id="{{item.id}}"
        >
          <text>{{item.name}}</text>
          <text class="map-results__caption">{{item.caption}}</text>
        </button>
      </scroll-view>
  </view>
  <view class="map__footer">
    <block wx:if="{{status === 'ready'}}">
      <view class="map__guide">
        <text class="map__zoom">{{zoom}}×</text>
        <text wx:if="{{!query && !detail && !nearby.length}}">拖動 · 雙指縮放 · 點按標記</text>
      </view>
      <view wx:if="{{!query && !detail && !nearby.length}}" class="map-controls">
        <button id="map-zoom-out" class="map-controls__button" aria-label="縮小地圖" bindtap="onZoomOut" disabled="{{zoom <= 1}}">−</button>
        <button id="map-zoom-in" class="map-controls__button" aria-label="放大地圖" bindtap="onZoomIn" disabled="{{zoom >= maxZoom}}">＋</button>
        <button id="map-reset" class="map-controls__button map-controls__button--reset" aria-label="返回全圖" bindtap="onReset">全圖</button>
      </view>
    </block>
    <text wx:elif="{{status === 'loading'}}" role="status">海圖載入中</text>
    <block wx:else>
      <text role="status">海圖載入失敗</text>
      <button class="ui-button ui-button--secondary" bindtap="initializeChart">重新載入</button>
    </block>
  </view>
</view>
