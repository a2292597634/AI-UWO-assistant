{
  "name": "uwo-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Uncharted Waters Origin 航海士資料查詢微信小程序",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:audit:capture": "tsx tools/data-audit/capture-source-samples.ts",
    "data:audit:check": "tsx tools/data-audit/run-data-audit.ts --check",
    "data:audit:write": "tsx tools/data-audit/run-data-audit.ts --write",
    "data:schema:check": "vitest run tests/data-contract",
    "data:check": "npm run data:audit:check && npm run data:schema:check",
    "check:runtime-network": "tsx tools/quality/check-runtime-network.ts",
    "check:architecture": "vitest run tests/architecture",
    "check:runtime-contract": "vitest run tests/runtime-contract",
    "import:download": "tsx tools/import/download-source.ts",
    "import:run": "tsx tools/import/run-import.ts",
    "data:generate": "tsx tools/data-pipeline/generate.ts",
    "assets:download": "tsx tools/asset-pipeline/download-assets.ts",
    "assets:setup": "tsx tools/asset-pipeline/setup-assets.ts",
    "assets:full": "npm run assets:download -- 0 && npm run assets:setup",
    "assets:ui": "tsx tools/ui-assets/build-ui-assets.ts --write",
    "assets:ui:check": "tsx tools/ui-assets/build-ui-assets.ts --check",
    "pipeline:full": "npm run import:run && npm run data:generate && npm run assets:full",
    "generate:check": "npm run data:generate && git diff --exit-code -- miniprogram/generated miniprogram/subpkg-detail",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run check:runtime-network && npm run assets:ui:check && npm run data:check && npm run generate:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "miniprogram-api-typings": "^5.2.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  }
}
