{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": false,
    "resolveJsonModule": true,
    "allowJs": false,
    "checkJs": false,
    "types": ["miniprogram-api-typings", "node", "vitest/globals"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "miniprogram/**/*.ts",
    "miniprogram/**/*.js",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "archive",
    "miniprogram/generated",
    "miniprogram/subpkg-detail/details-*",
    "miniprogram/subpkg-detail/detail-index.js",
    "miniprogram/subpkg-detail/detail-loaders.js",
    "miniprogram/subpkg-a*/imgs",
    "miniprogram/data"
  ]
}
